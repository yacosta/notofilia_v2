---
import NewWindowHint from './NewWindowHint.astro';
import {
  articles,
  collections,
  copy,
  localizePath,
  milestones,
  news,
  statsLine,
  type Locale,
} from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const heroAlt =
  locale === 'en'
    ? 'Macro engraving detail of a Guatemala 5-quetzal banknote, with the quetzal bird'
    : 'Detalle de grabado de un billete de 5 quetzales de Guatemala, con el ave quetzal';
---

<main id="main-content" tabindex="-1" class="relative w-full bg-paper-50 outline-none">
  <section class="relative overflow-hidden bg-brand-950" aria-labelledby="hero-heading">
    <img
      class="absolute inset-0 h-full w-full object-cover object-[50%_40%] opacity-40 [filter:contrast(1.15)_saturate(0.85)]"
      src="/images/hero-slide.jpg"
      alt={heroAlt}
      width="768"
      height="284"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/70 via-brand-950/55 to-brand-950"></div>

    <div class="relative z-[1] mx-auto flex min-h-[72vh] max-w-content flex-col items-center justify-center px-[var(--page-gutter)] py-20 text-center">
      <p class="m-0 font-sans text-[13px] font-medium uppercase tracking-[0.08em] text-gold-200">{t.heroKicker}</p>
      <p class="mb-0 mt-4 font-display text-[clamp(40px,7vw,72px)] font-normal leading-none tracking-tight text-paper-50">
        NOTOFILIA
      </p>
      <div class="guilloche my-5" aria-hidden="true"></div>
      <h1 id="hero-heading" class="m-0 max-w-[22ch] font-display text-[clamp(28px,3.4vw,44px)] font-normal leading-[1.18] text-paper-50">
        {t.heroTitle}
      </h1>
      <p class="mb-0 mt-4 max-w-[40rem] font-serif text-[17px] leading-7 text-brand-100">
        {t.heroLead}
      </p>
      <p class="mb-0 mt-5 font-mono text-[14px] leading-5 text-gold-200">
        {statsLine(locale)}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={localizePath('/coleccion/colombia/', locale)}
          class="inline-flex min-h-12 items-center justify-center rounded-[6px] bg-brand-800 px-6 py-3 font-sans text-[15px] font-semibold text-paper-50 no-underline hover:bg-brand-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
        >
          {t.heroPrimary}
        </a>
        <a
          href={localizePath('/coleccion/colombia/', locale)}
          class="inline-flex min-h-12 items-center justify-center rounded-[6px] border border-paper-50 px-6 py-3 font-sans text-[15px] font-semibold text-paper-50 no-underline hover:bg-paper-50/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
        >
          {t.heroSecondary}
        </a>
      </div>
    </div>
  </section>

  <section class="border-b border-paper-300 bg-paper-100" aria-label={t.statsLabel}>
    <div class="mx-auto max-w-content px-[var(--page-gutter)] py-8 text-center">
      <p class="m-0 font-mono text-[14px] leading-5 text-ink-600">{statsLine(locale)}</p>
    </div>
  </section>

  <section class="px-[var(--page-gutter)] py-16" aria-labelledby="browse-heading">
    <div class="mx-auto max-w-content">
      <h2 id="browse-heading" class="mb-3 mt-0 text-center font-display text-[32px] leading-10 text-brand-900">
        {t.browseTitle}
      </h2>
      <p class="mx-auto mb-10 mt-0 max-w-[40rem] text-center font-serif text-[17px] leading-7 text-ink-600">{t.browseIntro}</p>
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {
          collections.map((item) => (
            <li>
              <a
                href={localizePath(item.href, locale)}
                class="group block min-h-11 rounded-[6px] border border-paper-300 bg-paper-100 p-5 text-inherit no-underline hover:border-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
              >
                <span class="mb-2 block font-display text-[24px] leading-8 text-brand-900 group-hover:text-brand-800">
                  {item[locale].title}
                </span>
                <span class="block font-serif text-[16px] leading-7 text-ink-600">{item[locale].description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bg-paper-100 px-[var(--page-gutter)] py-16" aria-labelledby="milestones-heading">
    <div class="mx-auto max-w-content">
      <p class="mb-2 mt-0 text-center font-sans text-[12px] font-semibold uppercase tracking-[0.08em] text-gold-700">
        {locale === 'en' ? 'This month' : 'Este mes'}
      </p>
      <h2 id="milestones-heading" class="mb-3 mt-0 text-center font-display text-[32px] leading-10 text-brand-900">
        {t.milestonesTitle}
      </h2>
      <p class="mx-auto mb-10 mt-0 max-w-[40rem] text-center font-serif text-[17px] leading-7 text-ink-600">{t.milestonesIntro}</p>
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-4">
        {
          milestones.map((item) => (
            <li>
              <a
                href={localizePath(item.href, locale)}
                class="group flex h-full min-h-11 flex-col rounded-[6px] border border-paper-300 bg-paper-50 p-5 text-inherit no-underline hover:border-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
              >
                <h3 class="mb-2 mt-0 font-display text-[20px] leading-7 text-brand-900 group-hover:text-brand-800">
                  {item[locale].title}
                </h3>
                <p class="mb-4 mt-0 flex-1 font-serif text-[16px] leading-7 text-ink-600">{item[locale].description}</p>
                <span class="font-sans text-[15px] font-medium text-brand-800">{t.viewCatalog}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-center">
        <a
          href={localizePath('/coleccion/colombia/', locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] font-semibold text-brand-800 hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
        >
          {t.heroSecondary}
        </a>
      </p>
    </div>
  </section>

  <section class="px-[var(--page-gutter)] py-16" aria-labelledby="articles-heading">
    <div class="mx-auto max-w-content">
      <h2 id="articles-heading" class="mb-10 mt-0 text-center font-display text-[32px] leading-10 text-brand-900">
        {t.articlesTitle}
      </h2>
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2">
        {
          articles.map((item) => (
            <li>
              <article class="rounded-[6px] border border-paper-300 bg-paper-100 p-5">
                <p class="m-0 font-mono text-[14px] leading-5 text-ink-600">
                  {locale === 'en' ? item.dateEn : item.dateEs} · Notofilia
                </p>
                <h3 class="mb-3 mt-2 font-display text-[24px] leading-8 text-brand-900">{item[locale]}</h3>
                <a
                  href={localizePath(item.href, locale)}
                  class="inline-flex min-h-11 items-center font-sans text-[15px] font-medium text-brand-800 hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
                >
                  {t.readMore}
                </a>
              </article>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-center">
        <a
          href={localizePath('/blog/', locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] font-semibold text-brand-800 hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
        >
          {t.allBlog}
        </a>
      </p>
    </div>
  </section>

  <section class="bg-paper-100 px-[var(--page-gutter)] py-16" aria-labelledby="news-heading">
    <div class="mx-auto max-w-content">
      <h2 id="news-heading" class="mb-10 mt-0 text-center font-display text-[32px] leading-10 text-brand-900">
        {t.newsTitle}
      </h2>
      <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2">
        {
          news.map((item) => (
            <li>
              <article class="rounded-[6px] border border-paper-300 bg-paper-50 p-5">
                <p class="m-0 font-mono text-[14px] leading-5 text-ink-600">
                  {locale === 'en' ? item.dateEn : item.dateEs}
                </p>
                <p class="mb-0 mt-2 font-sans text-[14px] text-ink-600">
                  {t.source}:{' '}
                  <a
                    href={item.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-brand-800 underline decoration-brand-100 hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
                  >
                    {item.source}
                    <NewWindowHint locale={locale} />
                  </a>
                </p>
                <h3 class="mb-3 mt-2 font-display text-[24px] leading-8 text-brand-900">{item[locale]}</h3>
                <a
                  href={localizePath(item.href, locale)}
                  class="inline-flex min-h-11 items-center font-sans text-[15px] font-medium text-brand-800 hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
                >
                  {t.readMore}
                </a>
              </article>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-center">
        <a
          href={localizePath('/noticias/', locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] font-semibold text-brand-800 hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
        >
          {t.allNews}
        </a>
      </p>
    </div>
  </section>

  <section class="px-[var(--page-gutter)] py-16" aria-labelledby="definitions-heading">
    <div class="mx-auto grid max-w-content gap-8 lg:grid-cols-2">
      <h2 id="definitions-heading" class="sr-only">{locale === 'en' ? 'Definitions' : 'Definiciones'}</h2>
      <div class="rounded-[6px] border border-paper-300 bg-paper-100 p-6">
        <h3 class="mb-3 mt-0 font-display text-[24px] leading-8 text-brand-900">{t.numismaticsTitle}</h3>
        <p class="m-0 font-serif text-[17px] leading-7 text-ink-900">{t.numismaticsBody}</p>
      </div>
      <div class="rounded-[6px] border border-paper-300 bg-paper-100 p-6">
        <h3 class="mb-3 mt-0 font-display text-[24px] leading-8 text-brand-900">{t.notaphilyTitle}</h3>
        <p class="m-0 font-serif text-[17px] leading-7 text-ink-900">{t.notaphilyBody}</p>
      </div>
      <div class="rounded-[6px] border border-paper-300 bg-brand-100 p-8 lg:col-span-2">
        <h3 class="mb-3 mt-0 font-display text-[24px] leading-8 text-brand-900">{t.newsletterTitle}</h3>
        <p class="mb-6 mt-0 font-serif text-[17px] leading-7 text-ink-900">{t.newsletterBody}</p>
        <form class="flex flex-col gap-3 sm:flex-row sm:items-end" action={localizePath('/contacto/', locale)} method="get">
          <div class="min-w-0 flex-1">
            <label class="mb-2 block font-sans text-[13px] font-semibold tracking-[0.08em] text-ink-600" for="newsletter-email">
              {t.emailLabel}
            </label>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder={t.emailPlaceholder}
              class="box-border w-full min-h-12 rounded-[6px] border border-paper-300 bg-paper-50 px-4 font-sans text-[16px] text-ink-900 outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-600"
            />
          </div>
          <button
            type="submit"
            class="min-h-12 cursor-pointer rounded-[6px] border-0 bg-brand-800 px-7 font-sans text-[15px] font-semibold text-paper-50 hover:bg-brand-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
          >
            {t.subscribe}
          </button>
        </form>
      </div>
    </div>
  </section>
</main>
