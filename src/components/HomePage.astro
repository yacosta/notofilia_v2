---
import NewWindowHint from './NewWindowHint.astro';
import {
  articles,
  collections,
  copy,
  localizePath,
  milestones,
  news,
  statsLine,
  type Locale,
} from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const heroAlt =
  locale === 'en'
    ? 'Close-up of a Guatemala 5-quetzal banknote with the quetzal bird, in a notaphily style'
    : 'Primer plano de un billete de 5 quetzales de Guatemala, con el ave quetzal, estilo numismática y notafilia';
---

<main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
  <section class="relative min-h-[85vh] w-full" aria-labelledby="hero-heading">
    <img
      class="absolute inset-0 h-full w-full object-cover object-[50%_40%] [filter:contrast(1.2)_brightness(0.85)_saturate(1.1)]"
      src="/images/hero-slide.jpg"
      alt={heroAlt}
      width="768"
      height="284"
      fetchpriority="high"
      decoding="async"
    />
    <div
      class="absolute inset-0"
      style="background:radial-gradient(ellipse 90% 75% at 50% 42%, rgba(10,10,9,0.35) 0%, rgba(10,10,9,0.72) 60%, rgba(6,6,5,0.94) 100%);"
    >
    </div>
    <div
      class="absolute inset-0"
      style="background:linear-gradient(180deg, rgba(6,6,5,0.55) 0%, rgba(6,6,5,0.15) 22%, rgba(6,6,5,0.15) 78%, rgba(6,6,5,0.6) 100%);"
    >
    </div>

    <div class="relative z-[1] flex min-h-[85vh] flex-col items-center justify-center px-[var(--page-gutter)] py-16 text-center">
      <div class="mb-7 flex items-center gap-4">
        <span class="h-px w-14 bg-cream-faint"></span>
        <span class="font-serif text-[17px] font-medium uppercase italic tracking-[0.28em] text-cream-dim">{t.heroKicker}</span>
        <span class="h-px w-14 bg-cream-faint"></span>
      </div>
      <p class="m-0 font-display text-[clamp(48px,9vw,120px)] font-normal leading-[0.95] tracking-[0.04em] text-cream-dim [text-shadow:0_2px_24px_rgba(0,0,0,0.55)]">
        NOTOFILIA
      </p>
      <div class="my-6 flex items-center gap-[14px]">
        <span class="h-px w-[34px] bg-cream-faint/80"></span>
        <span class="h-[7px] w-[7px] rotate-45 bg-cream-dim"></span>
        <span class="h-px w-[34px] bg-cream-faint/80"></span>
      </div>
      <h1 id="hero-heading" class="m-0 max-w-none font-serif text-[clamp(22px,2.8vw,34px)] font-medium leading-[1.25] text-cream">
        {t.heroTitle}
      </h1>
      <p class="mb-0 mt-4 max-w-[46rem] font-serif text-[clamp(16px,1.5vw,19px)] leading-[1.6] text-cream-dim">
        {t.heroLead}
      </p>
      <p class="mb-0 mt-3 font-serif text-[clamp(15px,1.4vw,17px)] tracking-[0.06em] text-cream-dim">
        {statsLine(locale)}
      </p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a
          href={localizePath('/coleccion/colombia/', locale)}
          class="inline-flex min-h-12 items-center justify-center bg-cream px-7 py-3 font-serif text-[15px] font-semibold uppercase tracking-[0.1em] text-bg no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
        >
          {t.heroPrimary}
        </a>
        <a
          href={localizePath('/coleccion/colombia/', locale)}
          class="inline-flex min-h-12 items-center justify-center border border-cream px-7 py-3 font-serif text-[15px] font-semibold uppercase tracking-[0.1em] text-cream no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
        >
          {t.heroSecondary}
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-label={t.statsLabel}>
    <div class="mx-auto max-w-content px-[var(--page-gutter)] py-10 text-center">
      <p class="m-0 font-serif text-[clamp(15px,1.4vw,18px)] tracking-[0.08em] text-cream-dim">{statsLine(locale)}</p>
    </div>
  </section>

  <section class="border-t border-line px-[var(--page-gutter)] py-[72px]" aria-labelledby="browse-heading">
    <div class="mx-auto max-w-content">
      <h2 id="browse-heading" class="mb-3 mt-0 text-center font-display text-[clamp(24px,3vw,32px)] font-normal text-cream-dim">
        {t.browseTitle}
      </h2>
      <p class="mx-auto mb-8 mt-0 max-w-none text-center text-[18px] leading-[1.6] text-muted">{t.browseIntro}</p>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(220px,1fr))] gap-x-7 gap-y-5 p-0">
        {
          collections.map((item) => (
            <li>
              <a
                href={localizePath(item.href, locale)}
                class="group block min-h-11 border-t-2 border-line pt-3 text-inherit no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
              >
                <span class="mb-1.5 block font-display text-[clamp(17px,1.1vw,21px)] text-cream-dim group-hover:text-cream">
                  {item[locale].title}
                </span>
                <span class="block text-[15px] leading-[1.5] text-muted">{item[locale].description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-line px-[var(--page-gutter)] py-[72px]" aria-labelledby="milestones-heading">
    <div class="mx-auto max-w-content">
      <h2 id="milestones-heading" class="mb-3 mt-0 text-center font-display text-[clamp(24px,3vw,32px)] font-normal text-cream-dim">
        {t.milestonesTitle}
      </h2>
      <p class="mx-auto mb-8 mt-0 max-w-none text-center text-[18px] leading-[1.6] text-muted">{t.milestonesIntro}</p>
      <ul class="m-0 grid list-none grid-cols-[repeat(auto-fill,minmax(260px,1fr))] gap-6 p-0">
        {
          milestones.map((item) => (
            <li>
              <a
                href={localizePath(item.href, locale)}
                class="group block h-full min-h-11 border-t-2 border-line pt-4 text-inherit no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
              >
                <h3 class="mb-2 mt-0 font-display text-[clamp(18px,2vw,22px)] font-normal text-cream-dim group-hover:text-cream">
                  {item[locale].title}
                </h3>
                <p class="mb-3 mt-0 text-[15px] leading-[1.55] text-muted">{item[locale].description}</p>
                <span class="text-[15px] text-gold-light underline [text-decoration-color:rgba(203,191,157,0.45)]">{t.viewCatalog}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-center">
        <a
          href={localizePath('/coleccion/colombia/', locale)}
          class="inline-flex min-h-11 items-center font-serif text-[15px] font-semibold uppercase tracking-[0.1em] text-cream underline [text-decoration-color:rgba(231,222,201,0.35)] hover:text-gold-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
        >
          {t.heroSecondary}
        </a>
      </p>
    </div>
  </section>

  <section class="border-t border-line px-[var(--page-gutter)] py-[72px]" aria-labelledby="articles-heading">
    <div class="mx-auto max-w-content">
      <h2 id="articles-heading" class="mb-8 mt-0 text-center font-display text-[clamp(24px,3vw,32px)] font-normal text-cream-dim">
        {t.articlesTitle}
      </h2>
      <ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2">
        {
          articles.map((item) => (
            <li>
              <article class="border-t-2 border-line pt-4">
                <p class="m-0 text-[13px] uppercase tracking-[0.14em] text-muted">
                  {locale === 'en' ? item.dateEn : item.dateEs} · Notofilia
                </p>
                <h3 class="mb-3 mt-2 font-display text-[clamp(18px,2vw,22px)] font-normal text-cream-dim">
                  {item[locale]}
                </h3>
                <a
                  href={localizePath(item.href, locale)}
                  class="inline-flex min-h-11 items-center text-[15px] text-gold-light underline [text-decoration-color:rgba(203,191,157,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
                >
                  {t.readMore}
                </a>
              </article>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-center">
        <a
          href={localizePath('/blog/', locale)}
          class="inline-flex min-h-11 items-center font-serif text-[15px] font-semibold uppercase tracking-[0.1em] text-cream underline [text-decoration-color:rgba(231,222,201,0.35)] hover:text-gold-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
        >
          {t.allBlog}
        </a>
      </p>
    </div>
  </section>

  <section class="border-t border-line px-[var(--page-gutter)] py-[72px]" aria-labelledby="news-heading">
    <div class="mx-auto max-w-content">
      <h2 id="news-heading" class="mb-8 mt-0 text-center font-display text-[clamp(24px,3vw,32px)] font-normal text-cream-dim">
        {t.newsTitle}
      </h2>
      <ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2">
        {
          news.map((item) => (
            <li>
              <article class="border-t-2 border-line pt-4">
                <p class="m-0 text-[13px] uppercase tracking-[0.14em] text-muted">
                  {locale === 'en' ? item.dateEn : item.dateEs}
                </p>
                <p class="mb-0 mt-2 text-[15px] text-muted">
                  {t.source}:{' '}
                  <a
                    href={item.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-cream underline [text-decoration-color:rgba(231,222,201,0.35)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
                  >
                    {item.source}
                    <NewWindowHint locale={locale} />
                  </a>
                </p>
                <h3 class="mb-3 mt-2 font-display text-[clamp(18px,2vw,22px)] font-normal text-cream-dim">
                  {item[locale]}
                </h3>
                <a
                  href={localizePath(item.href, locale)}
                  class="inline-flex min-h-11 items-center text-[15px] text-gold-light underline [text-decoration-color:rgba(203,191,157,0.45)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
                >
                  {t.readMore}
                </a>
              </article>
            </li>
          ))
        }
      </ul>
      <p class="mt-10 text-center">
        <a
          href={localizePath('/noticias/', locale)}
          class="inline-flex min-h-11 items-center font-serif text-[15px] font-semibold uppercase tracking-[0.1em] text-cream underline [text-decoration-color:rgba(231,222,201,0.35)] hover:text-gold-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
        >
          {t.allNews}
        </a>
      </p>
    </div>
  </section>

  <section class="border-t border-line px-[var(--page-gutter)] py-[72px]" aria-labelledby="definitions-heading">
    <div class="mx-auto grid max-w-content gap-10 lg:grid-cols-2">
      <h2 id="definitions-heading" class="sr-only">{locale === 'en' ? 'Definitions' : 'Definiciones'}</h2>
      <div>
        <h3 class="mb-3 mt-0 font-display text-[clamp(22px,3vw,28px)] font-normal text-cream-dim">{t.numismaticsTitle}</h3>
        <p class="m-0 text-[17px] leading-[1.7] text-cream-soft">{t.numismaticsBody}</p>
      </div>
      <div>
        <h3 class="mb-3 mt-0 font-display text-[clamp(22px,3vw,28px)] font-normal text-cream-dim">{t.notaphilyTitle}</h3>
        <p class="m-0 text-[17px] leading-[1.7] text-cream-soft">{t.notaphilyBody}</p>
      </div>
      <div class="border border-line bg-panel p-8 lg:col-span-2">
        <h3 class="mb-3 mt-0 font-display text-[clamp(22px,3vw,28px)] font-normal text-cream-dim">{t.newsletterTitle}</h3>
        <p class="mb-6 mt-0 text-[17px] leading-[1.7] text-cream-soft">{t.newsletterBody}</p>
        <form class="flex flex-col gap-3 sm:flex-row sm:items-end" action={localizePath('/contacto/', locale)} method="get">
          <div class="min-w-0 flex-1">
            <label class="mb-2 block font-serif text-[13px] font-semibold uppercase tracking-[0.12em] text-muted" for="newsletter-email">
              {t.emailLabel}
            </label>
            <input
              id="newsletter-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder={t.emailPlaceholder}
              class="box-border w-full min-h-12 border border-line-input bg-bg px-4 font-serif text-[16px] text-cream outline-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream"
            />
          </div>
          <button
            type="submit"
            class="min-h-12 cursor-pointer border-0 bg-cream px-7 font-serif text-[15px] font-semibold uppercase tracking-[0.1em] text-bg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-cream"
          >
            {t.subscribe}
          </button>
        </form>
      </div>
    </div>
  </section>
</main>
