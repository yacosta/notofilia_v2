---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './Breadcrumb.astro';
import { localizePath, SITE_URL, type Locale } from '../lib/site';
import { glossaryTermHref, glossaryTerms } from '../data/glossary';
import {
  fancySerialClassLabels,
  fancySerialCopy,
  fancySerialExamples,
  fancySerialPath,
  toolsPath,
} from '../data/reference-tools';
import { searchDocuments } from '../lib/search-index';
import type { PublishedSerialHit } from '../lib/fancy-serial';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = fancySerialCopy[locale];
const pathname = fancySerialPath(locale);
const glossaryEspecial = glossaryTermHref('numeracion-especial', locale);
const classLabels = fancySerialClassLabels[locale];

const holdings: PublishedSerialHit[] = searchDocuments(locale)
  .filter((doc) => doc.kind === 'piece' && doc.flags.includes('single') && doc.serialNormalized)
  .map((doc) => ({
    serialNormalized: doc.serialNormalized,
    serial: doc.serial,
    href: doc.href,
    title: doc.title,
  }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: t.home,
          item: new URL(localizePath('/', locale), SITE_URL).href,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: t.hubNav,
          item: new URL(toolsPath(locale), SITE_URL).href,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: t.nav,
          item: new URL(pathname, SITE_URL).href,
        },
      ],
    },
    {
      '@type': 'WebPage',
      name: t.title,
      description: t.metaDescription,
      url: new URL(pathname, SITE_URL).href,
      inLanguage: locale,
    },
  ],
};

const ui = {
  locale,
  labels: classLabels,
  emptyIdle: t.emptyIdle,
  emptyInput: t.emptyInput,
  noDigits: t.noDigits,
  normalizedLabel: t.normalizedLabel,
  prefixLabel: t.prefixLabel,
  suffixLabel: t.suffixLabel,
  digitsLabel: t.digitsLabel,
  classesLabel: t.classesLabel,
  ordinary: t.ordinary,
  replacement: t.replacement,
  glossaryLead: t.glossaryLead,
  holdingTitle: t.holdingTitle,
  holdingLead: t.holdingLead,
  holdingLink: t.holdingLink,
  noHolding: t.noHolding,
  glossaryPaths: Object.fromEntries(
    [
      'numeracion',
      'numeracion-baja',
      'numeracion-binaria',
      'numeracion-radar',
      'numeracion-repetidor',
      'numeracion-escalera',
      'numeracion-especial',
      'numeracion-solida',
    ].map((slug) => [slug, glossaryTermHref(slug, locale)]),
  ) as Record<string, string>,
  glossaryTitles: Object.fromEntries(
    [
      'numeracion',
      'numeracion-baja',
      'numeracion-binaria',
      'numeracion-radar',
      'numeracion-repetidor',
      'numeracion-escalera',
      'numeracion-especial',
      'numeracion-solida',
    ].map((slug) => {
      const term = glossaryTerms.find((item) => item.slug === slug);
      return [slug, term?.title[locale] ?? slug];
    }),
  ) as Record<string, string>,
  holdings,
};
---

<Layout title={t.metaTitle} description={t.metaDescription} locale={locale} pathname={pathname}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main id="main-content" tabindex="-1" class="min-h-[60vh] outline-none">
    <article class="mx-auto max-w-content px-[var(--page-gutter)] pb-16 pt-14 md:pb-24 md:pt-16" data-fancy-serial>
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: t.home },
          { href: toolsPath(locale), label: t.hubNav },
          { label: t.nav },
        ]}
      />

      <header class="mb-10 max-w-[46rem]">
        <h1 class="mb-4 mt-0 font-display text-[clamp(1.75rem,4vw,2.65rem)] font-normal leading-[1.12] text-cream">
          {t.title}
        </h1>
        <p class="m-0 text-[17px]/7 text-muted">{t.dek}</p>
      </header>

      <section class="mb-10 max-w-[46rem]" aria-labelledby="fancy-explainer">
        <h2 id="fancy-explainer" class="mb-3 mt-0 font-display text-[1.35rem] font-normal text-cream">
          {t.explainerTitle}
        </h2>
        {t.explainer.map((paragraph) => (
          <p class="mb-4 mt-0 text-[17px]/7 text-cream last:mb-0">{paragraph}</p>
        ))}
      </section>

      <form class="mb-8 max-w-[46rem]" data-fancy-form>
        <label class="mb-2 block font-sans text-[15px] font-semibold text-cream" for="fancy-serial-input">
          {t.inputLabel}
        </label>
        <p id="fancy-serial-hint" class="mb-3 mt-0 font-sans text-[14px] text-muted">{t.inputHint}</p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-stretch">
          <input
            id="fancy-serial-input"
            name="serial"
            type="text"
            inputmode="text"
            autocomplete="off"
            spellcheck="false"
            aria-describedby="fancy-serial-hint"
            class="box-border min-h-12 w-full rounded-[8px] border border-line-input bg-[#f4efe4] px-4 font-sans text-[16px] text-ink placeholder:text-[#7a705c]"
            data-fancy-input
          />
          <button
            type="submit"
            class="inline-flex min-h-12 items-center justify-center rounded-[8px] bg-cream px-5 font-sans text-[15px] font-semibold text-bg hover:bg-cream-dim"
          >
            {t.submit}
          </button>
        </div>
      </form>

      <div class="mb-10" role="group" aria-label={t.examplesLabel}>
        <p class="mb-3 mt-0 font-sans text-[13px] uppercase tracking-[0.08em] text-muted">{t.examplesLabel}</p>
        <div class="flex flex-wrap gap-2">
          {
            fancySerialExamples.map((example) => (
              <button
                type="button"
                class="min-h-11 rounded-full border border-line-strong bg-panel px-3.5 py-[7px] font-mono text-[13px] text-cream-dim hover:border-cream hover:text-cream"
                data-fancy-example={example.value}
              >
                {example.label}
              </button>
            ))
          }
        </div>
        <p class="mb-0 mt-3 max-w-[46rem] font-sans text-[14px] text-muted">{t.examplesNote}</p>
      </div>

      <section aria-labelledby="fancy-results-title">
        <h2 id="fancy-results-title" class="mb-4 mt-0 font-display text-[1.35rem] font-normal text-cream">
          {t.resultsTitle}
        </h2>
        <p class="mb-4 mt-0 font-sans text-[14px] text-muted" aria-live="polite" data-fancy-status>
          {t.emptyIdle}
        </p>
        <p class="sr-only">{t.statusLabel}</p>
        <noscript>
          <p class="mb-6 font-sans text-[14px] text-muted">
            {t.needsJs}{' '}
            <a href={glossaryEspecial} class="text-gold-light underline-offset-2 hover:underline">{t.needsJsLink}</a>
          </p>
        </noscript>
        <div class="rounded-[6px] border border-line-strong bg-panel p-6" data-fancy-results></div>
      </section>

      <p class="mt-10 max-w-[46rem] text-[15px] text-muted">{t.disclaimer}</p>
    </article>
  </main>
</Layout>

<script define:vars={{ ui }}>
  window.__NOTOFILIA_FANCY_SERIAL__ = { ui };
</script>
<script>
  import {
    CLASS_GLOSSARY,
    classifySerial,
    glossarySlugsForClasses,
    matchPublishedHoldings,
    type FancySerialClass,
    type PublishedSerialHit,
  } from '../lib/fancy-serial';

  type FancyUi = {
    labels: Record<FancySerialClass, string>;
    emptyIdle: string;
    emptyInput: string;
    noDigits: string;
    normalizedLabel: string;
    prefixLabel: string;
    suffixLabel: string;
    digitsLabel: string;
    classesLabel: string;
    ordinary: string;
    replacement: string;
    glossaryLead: string;
    holdingTitle: string;
    holdingLead: string;
    holdingLink: string;
    noHolding: string;
    glossaryPaths: Record<string, string>;
    glossaryTitles: Record<string, string>;
    holdings: PublishedSerialHit[];
  };

  const payload = (
    window as unknown as {
      __NOTOFILIA_FANCY_SERIAL__?: { ui: FancyUi };
    }
  ).__NOTOFILIA_FANCY_SERIAL__;

  const root = document.querySelector('[data-fancy-serial]');
  if (payload && root instanceof HTMLElement) {
    const { ui } = payload;
    const form = root.querySelector<HTMLFormElement>('[data-fancy-form]');
    const input = root.querySelector<HTMLInputElement>('[data-fancy-input]');
    const status = root.querySelector<HTMLElement>('[data-fancy-status]');
    const results = root.querySelector<HTMLElement>('[data-fancy-results]');

    function setStatus(text: string) {
      if (status) status.textContent = text;
    }

    function dtDd(term: string, value: string) {
      const wrap = document.createElement('div');
      const dt = document.createElement('dt');
      dt.className = 'm-0 font-sans text-[13px] uppercase tracking-[0.08em] text-muted';
      dt.textContent = term;
      const dd = document.createElement('dd');
      dd.className = 'mb-4 mt-1 font-mono text-[16px] text-cream';
      dd.textContent = value;
      wrap.append(dt, dd);
      return wrap;
    }

    function render() {
      if (!input || !results) return;
      const raw = input.value.trim();
      results.replaceChildren();
      if (!raw) {
        setStatus(ui.emptyInput);
        return;
      }
      const parsed = classifySerial(raw);
      if (!parsed.valid) {
        setStatus(ui.noDigits);
        const p = document.createElement('p');
        p.className = 'm-0 text-[15px]/6 text-cream-dim';
        p.textContent = ui.noDigits;
        results.append(p);
        return;
      }

      const dl = document.createElement('dl');
      dl.className = 'm-0';
      dl.append(dtDd(ui.normalizedLabel, parsed.normalized));
      dl.append(dtDd(ui.digitsLabel, parsed.digits));
      if (parsed.prefix) dl.append(dtDd(ui.prefixLabel, parsed.prefix));
      if (parsed.suffix) dl.append(dtDd(ui.suffixLabel, parsed.suffix));
      results.append(dl);

      if (parsed.replacement) {
        const note = document.createElement('p');
        note.className = 'mb-4 mt-0 text-[15px]/6 text-cream-dim';
        note.textContent = ui.replacement;
        results.append(note);
      }

      const classesTitle = document.createElement('h3');
      classesTitle.className = 'mb-3 mt-2 font-display text-[1.15rem] font-normal text-cream';
      classesTitle.textContent = ui.classesLabel;
      results.append(classesTitle);

      if (parsed.ordinary) {
        const p = document.createElement('p');
        p.className = 'mb-4 mt-0 text-[15px]/6 text-cream-dim';
        p.textContent = ui.ordinary;
        results.append(p);
      } else {
        const list = document.createElement('ul');
        list.className = 'mb-4 mt-0 list-none p-0';
        for (const name of parsed.classes) {
          const li = document.createElement('li');
          li.className = 'mb-2';
          const slug = CLASS_GLOSSARY[name];
          const href = ui.glossaryPaths[slug];
          const a = document.createElement('a');
          a.href = href;
          a.className = 'text-gold-light underline-offset-2 hover:underline';
          a.textContent = ui.labels[name];
          li.append(a);
          list.append(li);
        }
        results.append(list);
      }

      const glossaryTitle = document.createElement('h3');
      glossaryTitle.className = 'mb-3 mt-6 font-display text-[1.15rem] font-normal text-cream';
      glossaryTitle.textContent = ui.glossaryLead;
      const glossaryList = document.createElement('ul');
      glossaryList.className = 'mb-4 mt-0 flex list-none flex-wrap gap-2 p-0';
      for (const slug of glossarySlugsForClasses(parsed.classes)) {
        const href = ui.glossaryPaths[slug];
        if (!href) continue;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = href;
        a.className =
          'inline-flex min-h-11 items-center rounded-full border border-line-strong px-3.5 py-[7px] font-sans text-[13px] text-cream-dim hover:border-cream hover:text-cream';
        a.textContent = ui.glossaryTitles[slug] ?? slug;
        li.append(a);
        glossaryList.append(li);
      }
      results.append(glossaryTitle, glossaryList);

      const hits = matchPublishedHoldings(parsed.normalized, ui.holdings);
      const holdingTitle = document.createElement('h3');
      holdingTitle.className = 'mb-3 mt-6 font-display text-[1.15rem] font-normal text-cream';
      holdingTitle.textContent = ui.holdingTitle;
      results.append(holdingTitle);
      if (hits.length) {
        const lead = document.createElement('p');
        lead.className = 'mb-3 mt-0 text-[15px]/6 text-cream-dim';
        lead.textContent = ui.holdingLead;
        results.append(lead);
        const ul = document.createElement('ul');
        ul.className = 'm-0 list-none p-0';
        for (const hit of hits) {
          const li = document.createElement('li');
          li.className = 'mb-2';
          const a = document.createElement('a');
          a.href = hit.href;
          a.className = 'text-gold-light underline-offset-2 hover:underline';
          a.textContent = hit.title;
          li.append(a);
          ul.append(li);
        }
        results.append(ul);
        setStatus(ui.holdingLead);
      } else {
        const p = document.createElement('p');
        p.className = 'm-0 text-[15px]/6 text-cream-dim';
        p.textContent = ui.noHolding;
        results.append(p);
        setStatus(parsed.ordinary ? ui.ordinary : parsed.classes.map((name) => ui.labels[name]).join(', '));
      }
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      render();
    });

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-fancy-example]')) {
      button.addEventListener('click', () => {
        if (!input) return;
        input.value = button.dataset.fancyExample ?? '';
        input.focus();
        render();
      });
    }
  }
</script>
