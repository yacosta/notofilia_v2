---
import { copy, type Locale } from '../lib/site';

export type Crumb = {
  href?: string;
  label: string;
};

interface Props {
  locale: Locale;
  items: Crumb[];
  label?: string;
}

const { locale, items, label } = Astro.props;
const aria = label ?? copy[locale].breadcrumb;
---

<nav aria-label={aria} class="mb-8">
  <ol class="breadcrumb m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 font-sans text-[14px] text-muted">
    {
      items.map((item, index) => {
        const current = index === items.length - 1;
        return (
          <li class:list={[current && 'inline-flex min-h-11 items-center text-cream-dim']}>
            {item.href && !current ? (
              <a class="inline-flex min-h-11 items-center text-gold-light hover:text-cream" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span aria-current={current ? 'page' : undefined}>{item.label}</span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
