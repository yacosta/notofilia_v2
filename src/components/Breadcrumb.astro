---
import type { Locale } from '../lib/locale-paths';

export type Crumb = {
  href?: string;
  label: string;
};

interface Props {
  locale: Locale;
  items: Crumb[];
  label?: string;
}

const { locale, items, label } = Astro.props;
const aria = label ?? (locale === 'en' ? 'Breadcrumb' : 'Migas de pan');
---

<nav aria-label={aria} class="mb-6">
  <ol class="crumbs m-0 flex list-none flex-wrap items-center p-0 font-sans text-[14px] tracking-[0.06em] text-muted">
    {
      items.map((item, index) => {
        const current = index === items.length - 1;
        return (
          <li class="inline-flex min-h-11 items-center">
            {index > 0 ? <span aria-hidden="true" class="px-2">/</span> : null}
            {item.href && !current ? (
              <a class="inline-flex min-h-11 items-center text-gold-light underline decoration-line-strong hover:text-cream" href={item.href}>
                {item.label}
              </a>
            ) : (
              <span class="text-cream-dim" aria-current={current ? 'page' : undefined}>
                {item.label}
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>
