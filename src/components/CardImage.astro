---
import { cardImageSrc, editorialUploadSrcset, imageSrcset } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  alt,
  width = 1200,
  height = 675,
  class: className = 'aspect-video w-full object-cover',
  loading = 'lazy',
  fetchpriority,
} = Astro.props;

const card = cardImageSrc(src);
---

<img
  src={card}
  srcset={src.includes('/uploads/') ? editorialUploadSrcset(src) : imageSrcset(src, [400, 800, 1200])}
  sizes="(max-width: 768px) 100vw, 600px"
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
/>
