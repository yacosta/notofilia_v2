---
const FLAG_CODES = ['cn', 'co', 'ec', 'gt', 'nl', 'ph', 'pr', 'us', 'vn'] as const;

type FlagCode = (typeof FLAG_CODES)[number];

interface Props {
  /** ISO 3166-1 alpha-2 code used by flag-icons. */
  code?: string;
}

const { code } = Astro.props;
const normalized = code?.toLowerCase();
const src = normalized && (FLAG_CODES as readonly string[]).includes(normalized)
  ? `/flags/${normalized as FlagCode}.svg`
  : undefined;
---

{
  src && (
    <span class="mega-flag" aria-hidden="true">
      <img class="mega-flag-img" src={src} alt="" width="20" height="15" decoding="async" />
    </span>
  )
}
