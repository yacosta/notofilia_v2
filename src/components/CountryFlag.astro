---
// Keep in sync with public/flags/{code}.svg (4x3). Add both when a row gets a new `flag`.
const FLAG_CODES = ['ca', 'cn', 'co', 'ec', 'es', 'gb', 'gt', 'kr', 'my', 'nl', 'ph', 'pr', 'us', 'us-hi', 'vn'] as const;

type FlagCode = (typeof FLAG_CODES)[number];

interface Props {
  /** ISO 3166-1 alpha-2 or a region code used by the flag SVGs (Hawaii `us-hi`). */
  code?: string;
}

const { code } = Astro.props;
const normalized = code?.toLowerCase();
const src = normalized && (FLAG_CODES as readonly string[]).includes(normalized)
  ? `/flags/${normalized as FlagCode}.svg`
  : undefined;
---

{
  src && (
    <span class="mega-flag" aria-hidden="true">
      <img class="mega-flag-img" src={src} alt="" width="20" height="15" decoding="async" />
    </span>
  )
}
