---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './Breadcrumb.astro';
import { copy, localizePath, SITE_URL, type Locale } from '../lib/site';
import { aboutCopy, aboutPath } from '../data/about';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = aboutCopy[locale];
const pathname = aboutPath(locale);
const brandHref = SITE_URL + '/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      name: t.title,
      description: t.metaDescription,
      url: new URL(pathname, SITE_URL).href,
      inLanguage: locale,
      isPartOf: { '@type': 'WebSite', name: 'Notofilia', url: SITE_URL },
      about: { '@id': `${SITE_URL}/#yezid-acosta` },
    },
    {
      '@type': 'Person',
      '@id': `${SITE_URL}/#yezid-acosta`,
      name: 'Yezid Acosta',
      url: new URL(pathname, SITE_URL).href,
      jobTitle: copy[locale].collectorJobTitle,
    },
  ],
};
---

<Layout title={t.metaTitle} description={t.metaDescription} locale={locale} pathname={pathname}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main id="main-content" tabindex="-1" class="min-h-[60vh] outline-none">
    <article class="mx-auto max-w-[46rem] px-[var(--page-gutter)] pb-16 pt-14 md:pb-24 md:pt-16">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: t.home },
          { label: t.nav },
        ]}
      />

      <header class="mb-2">
        <h1 class="mb-6 mt-0 font-display text-[clamp(1.75rem,4.5vw,2.65rem)] font-normal leading-[1.12] text-cream">
          {t.title}
        </h1>
      </header>

      <div class="prose-notofilia">
        {t.intro.map((paragraph) => <p>{paragraph}</p>)}

        <h2 id="sobre-mi">{t.aboutMe}</h2>

        {t.bio.map((paragraph) => <p set:html={paragraph} />)}
        {
          t.bioBrandAfter ? (
            <p>
              {t.bioBrandBefore}
              <a href={brandHref}>{t.brandLabel}</a>
              {t.bioBrandAfter}
            </p>
          ) : (
            <p>{t.bioBrandBefore}</p>
          )
        }

        <p>{t.closing}</p>
      </div>
    </article>
  </main>
</Layout>
