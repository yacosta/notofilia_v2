---
import Layout from '../../layouts/Layout.astro';
import { localizePath, type Locale } from '../../lib/site';
import { definedTermJsonLd } from '../../lib/json-ld';
import { cardImageSrc, imageSrcset } from '../../lib/images';
import {
  glossaryArticleBySlug,
  glossaryArticleLocaleText,
  type GlossaryExample,
} from '../../data/glossary-articles';
import {
  glossaryCategories,
  glossaryCopy,
  glossaryPath,
  glossaryTermBySlug,
  glossaryTermHref,
  type GlossaryTerm,
} from '../../data/glossary';

interface Props {
  locale: Locale;
  term: GlossaryTerm;
}

const { locale, term } = Astro.props;
const t = glossaryCopy[locale];
const pathname = glossaryTermHref(term.slug, locale);
const otherLang: Locale = locale === 'en' ? 'es' : 'en';
const categoryLabel = glossaryCategories.find((category) => category.id === term.category)?.[locale] ?? term.category;
const related = term.seeAlso
  .map((slug) => glossaryTermBySlug(slug))
  .filter((item): item is GlossaryTerm => Boolean(item));
const article = glossaryArticleBySlug(term.slug);
const paragraphs = article?.paragraphs[locale] ?? [term.definition[locale]];
const lead = paragraphs[0];
const rest = paragraphs.slice(1);
const jsonDescription = article ? glossaryArticleLocaleText(article, locale) : term.definition[locale];

function exampleHref(example: GlossaryExample): string {
  return localizePath(example.path, locale);
}
---

<Layout title={t.termTitle(term.title[locale])} description={lead} locale={locale} pathname={pathname}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        ...definedTermJsonLd({
          name: term.title[locale],
          alternateName: term.title[otherLang],
          description: jsonDescription,
          url: pathname,
          locale,
        }),
      })}
    />
  </Fragment>
  <main id="main-content" tabindex="-1" class="min-h-[60vh] outline-none">
    <article class="mx-auto max-w-content px-[var(--page-gutter)] pb-16 pt-14 md:pb-24 md:pt-16">
      <nav class="mb-5 font-sans text-[14px] tracking-[0.06em] text-muted" aria-label={t.breadcrumb}>
        <ol class="breadcrumb m-0 flex list-none flex-wrap items-center gap-x-2 p-0">
          <li>
            <a class="inline-flex min-h-11 items-center text-gold-light underline decoration-line-strong hover:text-cream" href={localizePath('/', locale)}>
              {t.home}
            </a>
          </li>
          <li>
            <a class="inline-flex min-h-11 items-center text-gold-light underline decoration-line-strong hover:text-cream" href={glossaryPath(locale)}>
              {t.glossary}
            </a>
          </li>
          <li class="inline-flex min-h-11 items-center text-cream-dim" aria-current="page">{term.title[locale]}</li>
        </ol>
      </nav>

      <p class="m-0 mb-3 font-sans text-[13px] uppercase tracking-[0.14em] text-muted">{categoryLabel}</p>
      <h1 id="term" class="mb-2 mt-0 font-display text-[clamp(28px,4.5vw,42px)] font-normal leading-[1.12] text-cream">
        {term.title[locale]}
      </h1>
      <p lang={otherLang} class="mb-8 mt-0 text-[clamp(18px,2.2vw,22px)] leading-[1.5] text-cream-dim italic">
        {term.title[otherLang]}
      </p>

      <p class="mb-10 mt-0 max-w-[46rem] text-[19px] leading-[1.7] text-cream-dim">{lead}</p>

      {
        article?.illustration?.image ? (
          <figure class="mb-10 m-0">
            <img
              src={cardImageSrc(article.illustration.image)}
              srcset={imageSrcset(article.illustration.image, [400, 800, 1200])}
              sizes="(min-width: 1024px) 720px, 100vw"
              width="800"
              height="400"
              alt={article.illustration.alt?.[locale] ?? article.illustration.title[locale]}
              fetchpriority="high"
              decoding="async"
              class="block h-auto w-full rounded-[3px] border border-[rgba(10,10,9,0.08)] bg-cream-dim object-contain"
            />
            <figcaption class="mt-3 font-sans text-[14px] text-muted">
              <a
                href={exampleHref(article.illustration)}
                class="text-gold-light underline decoration-line-strong hover:text-cream"
              >
                {article.illustration.title[locale]}
              </a>
            </figcaption>
          </figure>
        ) : null
      }

      {
        rest.map((paragraph) => (
          <p class="mb-5 mt-0 text-[19px] leading-[1.7] text-cream-dim">{paragraph}</p>
        ))
      }

      {
        article && article.examples.length > 0 ? (
          <section class="mt-12" aria-labelledby="glossary-examples-heading">
            <h2 id="glossary-examples-heading" class="mb-5 mt-0 font-display text-[22px] font-normal text-cream">
              {t.examplesHeading}
            </h2>
            <ul class="m-0 grid list-none grid-cols-1 gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
              {article.examples.map((example) => (
                <li>
                  <a
                    href={exampleHref(example)}
                    class="block rounded-[3px] border border-[rgba(10,10,9,0.08)] bg-cream-dim no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold-deep"
                  >
                    {example.image ? (
                      <img
                        src={cardImageSrc(example.image)}
                        srcset={imageSrcset(example.image, [400, 800])}
                        sizes="(min-width: 1024px) 240px, 50vw"
                        width="400"
                        height="200"
                        alt={example.alt?.[locale] ?? ''}
                        loading="lazy"
                        decoding="async"
                        class="block h-auto w-full object-contain"
                      />
                    ) : null}
                    <span class="block px-4 py-3 font-sans text-[15px] text-ink underline [text-decoration-color:rgba(51,46,34,0.45)]">
                      {example.title[locale]}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }

      {
        related.length > 0 ? (
          <p class="mb-0 mt-10 font-sans text-[15px] text-muted">
            <span>{t.seeAlso}</span>{' '}
            {related.map((item, index) => (
              <>
                {index > 0 ? <span>, </span> : null}
                <a
                  href={glossaryTermHref(item.slug, locale)}
                  class="text-gold-light underline decoration-line-strong hover:text-cream"
                >
                  {item.title[locale]}
                </a>
              </>
            ))}
          </p>
        ) : null
      }

      <p class="mb-0 mt-8">
        <a
          href={glossaryPath(locale)}
          class="inline-flex min-h-11 items-center text-cream underline [text-decoration-color:rgba(231,222,201,0.35)] hover:text-gold-light"
        >
          {t.back}
        </a>
      </p>
    </article>
  </main>
</Layout>
