---
import { copy, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<div
  class="site-notice flex w-full flex-wrap items-start justify-center gap-2 bg-alert px-3 pt-[max(0.4rem,env(safe-area-inset-top))] pb-1.5 text-center"
  role="region"
  aria-label={t.siteNoticeLabel}
>
  <span
    class="site-notice-icon mt-0.5 inline-flex h-[1.125rem] w-[1.125rem] shrink-0 items-center justify-center rounded-full bg-white font-sans text-[12px] font-bold leading-none text-alert"
    aria-hidden="true"
  >
    !
  </span>
  <p class="site-notice-text m-0 max-w-[40rem] text-pretty font-sans text-[13px] leading-snug text-alert-ink sm:text-[14px]">
    <span class="sm:hidden">{t.siteNoticeShort}</span>
    <span class="hidden sm:inline">{t.siteNotice}</span>
  </p>
</div>
