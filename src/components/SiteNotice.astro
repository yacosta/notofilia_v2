---
import { copy, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
---

<div
  class="site-notice flex w-full flex-nowrap items-center justify-center gap-1.5 bg-alert px-2 py-1.5 text-center"
  role="region"
  aria-label={t.siteNoticeLabel}
>
  <span
    class="site-notice-icon inline-flex h-[1.125rem] w-[1.125rem] shrink-0 items-center justify-center rounded-full bg-white font-sans text-[12px] font-bold leading-none text-alert"
    aria-hidden="true"
  >
    !
  </span>
  <p class="site-notice-text font-sans text-alert-ink">
    {t.siteNotice}
  </p>
</div>
