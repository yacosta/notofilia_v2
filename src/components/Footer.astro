---
import NewWindowHint from './NewWindowHint.astro';
import GooglePreferredSourceButton from './GooglePreferredSourceButton.astro';
import {
  copy,
  footerNotafilia,
  footerNumismatica,
  footerResources,
  footerSite,
  localizePath,
  megaNav,
  statsLine,
  type FooterLink,
  type Locale,
} from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const [navNotafilia, navNumismatica, navRecursos] = megaNav;

const catalogColumns = [
  { id: 'notafilia', title: navNotafilia[locale], items: footerNotafilia },
  { id: 'numismatica', title: navNumismatica[locale], items: footerNumismatica },
  { id: 'recursos', title: navRecursos[locale], items: footerResources },
  { id: 'sitio', title: t.site, items: footerSite },
];

function itemLabel(item: FooterLink) {
  return item[locale];
}
---

<footer class="bg-bg text-cream">
  <div class="mx-auto w-full max-w-none px-[var(--chrome-gutter)] pb-10 pt-[72px]">
    <nav aria-label={t.footerNav}>
      <div class="mb-10 grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-x-8 gap-y-7">
        {
          catalogColumns.map((column) => (
            <div>
              <p class="mb-2.5 mt-0 font-sans text-[12px] font-semibold uppercase tracking-[0.16em] text-muted">
                {column.title}
              </p>
              <ul class="m-0 list-none p-0">
                {column.items.map((item) => (
                  <li>
                    <a
                      class="inline-flex min-h-11 items-center text-cream-soft no-underline hover:text-cream"
                      href={localizePath(item.href, locale)}
                    >
                      {itemLabel(item)}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </nav>

    <div class="flex flex-col items-center gap-2 border-t border-line pt-8 text-center">
      <div class="flex items-center justify-center gap-2">
        <a
          href="https://www.facebook.com/NOTOFILIA"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex size-11 items-center justify-center"
        >
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="12" fill="#ffffff"></circle>
            <path
              fill="#1877F2"
              d="M24 12.073c0-6.627-5.373-12-12-12S0 5.446 0 12.073C0 18.062 4.388 23.027 10.125 23.927v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
            ></path>
          </svg>
          <span class="footer-icon-name">{t.facebook}</span>
          <NewWindowHint locale={locale} visuallyHidden />
        </a>
        <a
          href="https://x.com/Notofilia"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex size-11 items-center justify-center"
        >
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="12" fill="#ffffff"></circle>
            <path
              fill="#000000"
              transform="translate(4.8 4.8) scale(0.6)"
              d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
            ></path>
          </svg>
          <span class="footer-icon-name">{t.x}</span>
          <NewWindowHint locale={locale} visuallyHidden />
        </a>
      </div>
      <GooglePreferredSourceButton locale={locale} />
      <span class="font-sans text-[13px] tracking-[0.04em] text-cream-soft">{t.copyright}</span>
      <span class="max-w-full font-sans italic text-[15px] text-cream-dim">{t.ownership}</span>
      <p class="m-0 mt-2 max-w-full text-center font-sans text-[14px]/5 text-cream-soft">
        <strong class="font-sans font-semibold text-gold-light">{t.virtual}</strong>
        <span> {statsLine(locale)}</span>
      </p>
      <p class="m-0 mt-2 text-center font-sans text-[13px] text-cream-soft">
        <span>{t.designedBy} </span>
        <a
          href="https://cybercon-solutions.com"
          target="_blank"
          rel="noopener noreferrer"
          class="text-cream underline decoration-gold-light/50 hover:text-gold-light"
        >
          Cybercon Solutions<NewWindowHint locale={locale} visuallyHidden />
        </a>
        <span> {t.withLove} </span>
        <span class="footer-heart inline-flex align-[-0.35em]" role="img" aria-label={t.love}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
            <path fill="#cbbf9d" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
          </svg>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer-icon-name {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
