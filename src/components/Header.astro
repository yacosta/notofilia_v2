---
import { copy, localizePath, otherLocalePath, primaryNav, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = copy[locale];
const home = localizePath('/', locale);
const enHref = locale === 'en' ? pathname : otherLocalePath(pathname, 'es');
const esHref = locale === 'es' ? pathname : otherLocalePath(pathname, 'en');
const searchAction = localizePath('/buscar/', locale);
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/72 backdrop-blur-[10px]">
  <nav
    class="mx-auto grid w-full max-w-none grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 gap-y-1 px-[var(--chrome-gutter)] min-h-[68px] lg:grid-cols-[minmax(min-content,1.25fr)_minmax(0,1fr)_auto]"
    aria-label={t.navLabel}
  >
    <a
      href={home}
      class="flex min-h-11 min-w-min flex-col justify-center pr-4 text-cream-dim no-underline"
    >
      <span class="whitespace-nowrap font-display text-[22px] tracking-[0.1em] md:text-[28px]">NOTOFILIA</span>
      <span class="hidden whitespace-nowrap font-sans text-[12px] italic tracking-[0.08em] text-cream-dim md:block">{t.brandTag}</span>
    </a>

    <ul class="hidden min-w-0 w-full list-none m-0 p-0 flex-wrap items-center justify-end gap-x-0 gap-y-0 lg:flex">
      {
        primaryNav.map((item) => (
          <li class="shrink">
            <a
              href={localizePath(item.href, locale)}
              class="inline-flex items-center min-h-11 px-1.5 font-sans text-[12px] font-semibold uppercase tracking-[0.06em] text-cream no-underline hover:text-cream-dim xl:px-2 xl:text-[13px] xl:tracking-[0.08em]"
            >
              {item[locale]}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 justify-self-end">
      <form action={searchAction} method="get" class="hidden md:block" role="search">
        <label class="sr-only" for="site-search">{t.searchLabel}</label>
        <input
          id="site-search"
          name="q"
          type="search"
          placeholder={t.searchPlaceholder}
          class="box-border min-h-11 w-[10rem] rounded-[6px] border border-line-input bg-bg/40 px-3 font-sans text-[14px] text-cream placeholder:text-muted xl:w-[13rem]"
        />
      </form>

      <div class="flex items-center rounded-full border border-line-input bg-bg/35 p-[3px]" role="group" aria-label={t.langLabel}>
        {
          locale === 'es' ? (
            <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full bg-cream px-3 font-sans text-[13px] font-semibold tracking-[0.14em] text-bg" aria-current="page" lang="es">
              ES<span class="sr-only"> — Español</span>
            </span>
          ) : (
            <a class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-3 font-sans text-[13px] font-semibold tracking-[0.14em] text-cream no-underline" href={esHref} hreflang="es" lang="es">
              ES<span class="sr-only"> — Spanish</span>
            </a>
          )
        }
        {
          locale === 'en' ? (
            <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full bg-cream px-3 font-sans text-[13px] font-semibold tracking-[0.14em] text-bg" aria-current="page" lang="en">
              EN<span class="sr-only"> — English</span>
            </span>
          ) : (
            <a class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-3 font-sans text-[13px] font-semibold tracking-[0.14em] text-cream no-underline" href={enHref} hreflang="en" lang="en">
              EN<span class="sr-only"> — English</span>
            </a>
          )
        }
      </div>

      <details class="relative lg:hidden">
        <summary class="flex min-h-11 min-w-11 cursor-pointer list-none flex-col items-center justify-center gap-[5px] text-cream">
          <span class="sr-only">{t.menu}</span>
          <span class="block h-[1.5px] w-[22px] bg-cream" aria-hidden="true"></span>
          <span class="block h-[1.5px] w-[22px] bg-cream" aria-hidden="true"></span>
          <span class="mr-[7px] block h-[1.5px] w-[15px] self-end bg-cream" aria-hidden="true"></span>
        </summary>
        <div class="absolute right-0 top-full z-50 mt-2 w-[min(92vw,22rem)] rounded-[6px] border border-line-strong bg-panel text-cream shadow-[0_16px_32px_rgba(0,0,0,0.45)]">
          <form action={searchAction} method="get" class="border-b border-line p-4" role="search">
            <label class="sr-only" for="site-search-mobile">{t.searchLabel}</label>
            <input
              id="site-search-mobile"
              name="q"
              type="search"
              placeholder={t.searchPlaceholder}
              class="box-border min-h-11 w-full rounded-[6px] border border-line-input bg-bg px-3 font-sans text-[14px] text-cream"
            />
          </form>
          <ul class="m-0 list-none p-0">
            {
              primaryNav.map((item) => (
                <li>
                  <a
                    href={localizePath(item.href, locale)}
                    class="flex min-h-11 items-center border-b border-line px-6 font-sans text-[15px] text-cream no-underline hover:text-cream-dim"
                  >
                    {item[locale]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>
