---
import { copy, localizePath, otherLocalePath, primaryNav, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = copy[locale];
const home = localizePath('/', locale);
const enHref = locale === 'en' ? pathname : otherLocalePath(pathname, 'es');
const esHref = locale === 'es' ? pathname : otherLocalePath(pathname, 'en');
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/90 backdrop-blur-[10px]">
  <nav class="grid grid-cols-[1fr_auto] items-center gap-3 px-[var(--page-gutter)] min-h-[68px] lg:grid-cols-[auto_1fr_auto]" aria-label={t.navLabel}>
    <a href={home} class="flex min-h-11 flex-col justify-center no-underline text-cream-dim focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]">
      <span class="font-display text-[22px] tracking-[0.1em] md:text-[28px]">NOTOFILIA</span>
      <span class="hidden font-serif italic text-[13px] tracking-[0.08em] md:block">{t.brandTag}</span>
    </a>

    <ul class="hidden list-none m-0 p-0 items-center justify-end gap-x-1 lg:flex">
      {
        primaryNav.map((item) => (
          <li>
            <a
              href={localizePath(item.href, locale)}
              class="inline-flex items-center min-h-11 px-2.5 font-serif text-[13px] font-semibold uppercase tracking-[0.12em] text-cream no-underline hover:text-gold-light focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]"
            >
              {item[locale]}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 justify-self-end">
      <div class="flex items-center rounded-full border border-line-input bg-bg/45 p-[3px]" role="group" aria-label={t.langLabel}>
        {
          locale === 'es' ? (
            <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full bg-cream/92 px-4 font-serif text-[13px] font-semibold tracking-[0.14em] text-bg" aria-current="page" lang="es">
              ES<span class="sr-only"> — Español</span>
            </span>
          ) : (
            <a class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-4 font-serif text-[13px] font-semibold tracking-[0.14em] text-cream no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2" href={esHref} hreflang="es" lang="es">
              ES<span class="sr-only"> — Spanish</span>
            </a>
          )
        }
        {
          locale === 'en' ? (
            <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full bg-cream/92 px-4 font-serif text-[13px] font-semibold tracking-[0.14em] text-bg" aria-current="page" lang="en">
              EN<span class="sr-only"> — English</span>
            </span>
          ) : (
            <a class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-4 font-serif text-[13px] font-semibold tracking-[0.14em] text-cream no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-2" href={enHref} hreflang="en" lang="en">
              EN<span class="sr-only"> — English</span>
            </a>
          )
        }
      </div>

      <details class="relative lg:hidden">
        <summary class="flex min-h-11 min-w-11 cursor-pointer list-none flex-col items-center justify-center gap-[5px] text-cream focus-visible:outline focus-visible:outline-2 focus-visible:outline-cream focus-visible:outline-offset-[3px]">
          <span class="sr-only">{t.menu}</span>
          <span class="block h-[1.5px] w-[22px] bg-cream" aria-hidden="true"></span>
          <span class="block h-[1.5px] w-[22px] bg-cream" aria-hidden="true"></span>
          <span class="mr-[7px] block h-[1.5px] w-[15px] self-end bg-cream" aria-hidden="true"></span>
        </summary>
        <div class="absolute right-0 top-full z-50 mt-2 w-[min(92vw,22rem)] border border-line bg-cream-dim text-ink shadow-[0_24px_48px_rgba(0,0,0,0.45)]">
          <ul class="m-0 list-none p-0">
            {
              primaryNav.map((item) => (
                <li>
                  <a
                    href={localizePath(item.href, locale)}
                    class="flex min-h-11 items-center border-b border-[rgba(10,10,9,0.08)] px-6 font-serif text-[15px] font-semibold uppercase tracking-[0.1em] text-panel no-underline hover:text-gold-dark"
                  >
                    {item[locale]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>
