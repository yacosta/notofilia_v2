---
import { copy, localizePath, otherLocalePath, primaryNav, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = copy[locale];
const home = localizePath('/', locale);
const enHref = locale === 'en' ? pathname : otherLocalePath(pathname, 'es');
const esHref = locale === 'es' ? pathname : otherLocalePath(pathname, 'en');
const searchAction = localizePath('/buscar/', locale);
---

<header class="sticky top-0 z-50 border-b border-paper-300 bg-paper-50/95 backdrop-blur-[10px]">
  <nav
    class="mx-auto grid max-w-content grid-cols-[1fr_auto] items-center gap-3 px-[var(--page-gutter)] min-h-[68px] lg:grid-cols-[auto_1fr_auto]"
    aria-label={t.navLabel}
  >
    <a
      href={home}
      class="flex min-h-11 min-w-[1em] flex-col justify-center text-ink-900 no-underline"
    >
      <span class="font-display text-[22px] tracking-[0.04em] md:text-[28px]">NOTOFILIA</span>
      <span class="hidden font-sans text-[12px] tracking-[0.08em] text-ink-600 md:block">{t.brandTag}</span>
    </a>

    <ul class="hidden list-none m-0 p-0 items-center justify-end gap-x-1 lg:flex">
      {
        primaryNav.map((item) => (
          <li>
            <a
              href={localizePath(item.href, locale)}
              class="inline-flex items-center min-h-11 px-2.5 font-sans text-[13px] font-medium tracking-[0.08em] text-ink-900 no-underline hover:text-brand-800"
            >
              {item[locale]}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2 justify-self-end">
      <form action={searchAction} method="get" class="hidden md:block" role="search">
        <label class="sr-only" for="site-search">{t.searchLabel}</label>
        <input
          id="site-search"
          name="q"
          type="search"
          placeholder={t.searchPlaceholder}
          class="box-border min-h-11 w-[13rem] rounded-[6px] border border-paper-300 bg-paper-50 px-3 font-sans text-[14px] text-ink-900 placeholder:text-ink-600"
        />
      </form>

      <div class="flex items-center rounded-[6px] border border-paper-300 bg-paper-100 p-[3px]" role="group" aria-label={t.langLabel}>
        {
          locale === 'es' ? (
            <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[6px] bg-brand-800 px-3 font-sans text-[13px] font-semibold tracking-[0.08em] text-paper-50" aria-current="page" lang="es">
              ES<span class="sr-only"> — Español</span>
            </span>
          ) : (
            <a class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[6px] px-3 font-sans text-[13px] font-semibold tracking-[0.08em] text-ink-900 no-underline" href={esHref} hreflang="es" lang="es">
              ES<span class="sr-only"> — Spanish</span>
            </a>
          )
        }
        {
          locale === 'en' ? (
            <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[6px] bg-brand-800 px-3 font-sans text-[13px] font-semibold tracking-[0.08em] text-paper-50" aria-current="page" lang="en">
              EN<span class="sr-only"> — English</span>
            </span>
          ) : (
            <a class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-[6px] px-3 font-sans text-[13px] font-semibold tracking-[0.08em] text-ink-900 no-underline" href={enHref} hreflang="en" lang="en">
              EN<span class="sr-only"> — English</span>
            </a>
          )
        }
      </div>

      <details class="relative lg:hidden">
        <summary class="flex min-h-11 min-w-11 cursor-pointer list-none flex-col items-center justify-center gap-[5px] text-ink-900">
          <span class="sr-only">{t.menu}</span>
          <span class="block h-[1.5px] w-[22px] bg-ink-900" aria-hidden="true"></span>
          <span class="block h-[1.5px] w-[22px] bg-ink-900" aria-hidden="true"></span>
          <span class="mr-[7px] block h-[1.5px] w-[15px] self-end bg-ink-900" aria-hidden="true"></span>
        </summary>
        <div class="absolute right-0 top-full z-50 mt-2 w-[min(92vw,22rem)] rounded-[6px] border border-paper-300 bg-paper-50 text-ink-900 shadow-[0_16px_32px_rgba(28,26,21,0.12)]">
          <form action={searchAction} method="get" class="border-b border-paper-300 p-4" role="search">
            <label class="sr-only" for="site-search-mobile">{t.searchLabel}</label>
            <input
              id="site-search-mobile"
              name="q"
              type="search"
              placeholder={t.searchPlaceholder}
              class="box-border min-h-11 w-full rounded-[6px] border border-paper-300 bg-paper-50 px-3 font-sans text-[14px] text-ink-900"
            />
          </form>
          <ul class="m-0 list-none p-0">
            {
              primaryNav.map((item) => (
                <li>
                  <a
                    href={localizePath(item.href, locale)}
                    class="flex min-h-11 items-center border-b border-paper-300 px-6 font-sans text-[15px] text-brand-800 no-underline hover:text-brand-600"
                  >
                    {item[locale]}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>
