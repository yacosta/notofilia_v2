---
import NavIcon from './NavIcon.astro';
import { copy, localizePath, otherLocalePath, type Locale } from '../lib/site';
import { megaNav } from '../lib/mega-nav';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = copy[locale];
const home = localizePath('/', locale);
const enHref = locale === 'en' ? pathname : otherLocalePath(pathname, 'es');
const esHref = locale === 'es' ? pathname : otherLocalePath(pathname, 'en');
const searchAction = localizePath('/buscar/', locale);

function currentPath(href: string) {
  if (href.startsWith('/#')) return localizePath('/', locale) + href.slice(1);
  return localizePath(href, locale);
}

function isCurrent(href: string) {
  if (href.startsWith('/#')) return false;
  const localized = localizePath(href, locale);
  if (localized === home) return pathname === home;
  return pathname === localized || pathname.startsWith(localized);
}
---

<header
  class="mega-header sticky top-0 z-50 border-b border-line"
  data-mega-header
  data-open-submenu={t.openSubmenu}
  data-close-named-submenu={t.closeNamedSubmenu}
>
  <div class="mega-utility mx-auto flex min-h-[68px] w-full items-center justify-between gap-4 px-[var(--chrome-gutter)]">
    <a href={home} class="flex min-h-11 min-w-min flex-col justify-center text-cream-dim no-underline">
      <span class="whitespace-nowrap font-display text-[22px] tracking-[0.1em] md:text-[28px]">NOTOFILIA</span>
      <span class="hidden whitespace-nowrap font-sans text-[12px] italic tracking-[0.08em] text-cream-dim md:block">
        {t.brandTag}
      </span>
    </a>

    <div class="flex items-center gap-2">
      <form action={searchAction} method="get" class="hidden md:block" role="search">
        <label class="sr-only" for="site-search">{t.searchLabel}</label>
        <input
          id="site-search"
          name="q"
          type="search"
          placeholder={t.searchPlaceholder}
          class="box-border min-h-11 w-[10rem] rounded-[6px] border border-line-input bg-bg/40 px-3 font-sans text-[14px] text-cream placeholder:text-muted xl:w-[13rem]"
        />
      </form>

      <div class="flex items-center rounded-full border border-line-input bg-bg/35 p-[3px]" role="group" aria-label={t.langLabel}>
        {
          locale === 'es' ? (
            <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full bg-cream px-3 font-sans text-[13px] font-semibold tracking-[0.14em] text-bg" aria-current="page" lang="es">
              ES<span class="sr-only"> — Español</span>
            </span>
          ) : (
            <a class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-3 font-sans text-[13px] font-semibold tracking-[0.14em] text-cream no-underline" href={esHref} hreflang="es" lang="es">
              ES<span class="sr-only"> — Spanish</span>
            </a>
          )
        }
        {
          locale === 'en' ? (
            <span class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full bg-cream px-3 font-sans text-[13px] font-semibold tracking-[0.14em] text-bg" aria-current="page" lang="en">
              EN<span class="sr-only"> — English</span>
            </span>
          ) : (
            <a class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-3 font-sans text-[13px] font-semibold tracking-[0.14em] text-cream no-underline" href={enHref} hreflang="en" lang="en">
              EN<span class="sr-only"> — English</span>
            </a>
          )
        }
      </div>

      <button
        type="button"
        class="mega-drawer-toggle inline-flex min-h-11 min-w-11 flex-col items-center justify-center gap-[5px] border-0 bg-transparent p-0 text-cream lg:hidden"
        data-mega-drawer-toggle
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="sr-only">{t.menu}</span>
        <span class="block h-[1.5px] w-[22px] bg-cream" aria-hidden="true"></span>
        <span class="block h-[1.5px] w-[22px] bg-cream" aria-hidden="true"></span>
        <span class="mr-[7px] block h-[1.5px] w-[15px] self-end bg-cream" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav class="mega-bar" aria-label={t.navLabel} data-mega-nav id="site-menu">
    <div class="mega-drawer-toolbar lg:hidden">
      <p class="m-0 font-display text-[18px] tracking-[0.12em] text-cream">NOTOFILIA</p>
      <button
        type="button"
        class="inline-flex min-h-11 min-w-11 items-center justify-center border-0 bg-transparent p-0 font-sans text-[13px] font-semibold uppercase tracking-[0.08em] text-cream"
        data-mega-drawer-close
      >
        {t.closeMenu}
      </button>
    </div>

    <p class="sr-only" id="mega-nav-help">{t.navHelp}</p>
    <p class="sr-only">{t.navOnMenu}</p>

    <ul class="mega-list" aria-describedby="mega-nav-help">
      {
        megaNav.map((item) => {
          const href = currentPath(item.href);
          const panelId = `mega-panel-${item.id}`;
          const label = item[locale];
          const current = isCurrent(item.href);
          return (
            <li class:list={['mega-item', current && 'is-current']} data-mega-item>
              <div class="mega-item-chrome">
                <a
                  href={href}
                  class="mega-item-link"
                  aria-current={current ? 'page' : undefined}
                >
                  <NavIcon name={item.icon} />
                  <span class="mega-item-title">{label}</span>
                </a>
                {item.panel && (
                  <button
                    type="button"
                    class="mega-item-toggle"
                    data-mega-submenu-toggle
                    data-menu-title={label}
                    aria-expanded="false"
                    aria-controls={panelId}
                    aria-label={t.openSubmenu.replace('{menuTitle}', label)}
                  >
                    <span class="mega-item-chevron" aria-hidden="true"></span>
                  </button>
                )}
              </div>

              {item.panel && (
                <div class="mega-panel" id={panelId} data-mega-panel hidden>
                  <div class="mega-panel-inner">
                    <div class="mega-subhead lg:hidden">
                      <button type="button" class="mega-sub-back" data-mega-sub-back>
                        {t.backToMenu}
                      </button>
                      <p class="mega-subhead-title">{label}</p>
                    </div>

                    <ul class="mega-card-list">
                      {item.panel.cards.map((card) => (
                        <li class:list={['mega-card', `mega-card--${card.size}`]}>
                          <a class="mega-card-link" href={currentPath(card.href)}>
                            {card.image && (
                              <span class="mega-card-media">
                                <img
                                  src={card.image.src}
                                  alt={card.image.alt[locale]}
                                  width={card.image.width}
                                  height={card.image.height}
                                  loading="lazy"
                                  decoding="async"
                                />
                              </span>
                            )}
                            <span class="mega-card-title">{card.title[locale]}</span>
                          </a>
                          {card.links && card.links.length > 0 && (
                            <ul class="mega-card-links">
                              {card.links.map((link) => (
                                <li>
                                  <a href={currentPath(link.href)}>{link[locale]}</a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>

                    {item.panel.banner && (
                      <a class="mega-banner" href={currentPath(item.panel.banner.href)}>
                        <img
                          src={item.panel.banner.image.src}
                          alt={item.panel.banner.image.alt[locale]}
                          width={item.panel.banner.image.width}
                          height={item.panel.banner.image.height}
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="mega-banner-copy">
                          <span class="mega-banner-title">{item.panel.banner.title[locale]}</span>
                          <span class="mega-banner-cta">{item.panel.banner.cta[locale]}</span>
                        </span>
                      </a>
                    )}
                  </div>
                </div>
              )}
            </li>
          );
        })
      }
    </ul>

    <form action={searchAction} method="get" class="mega-drawer-search lg:hidden" role="search">
      <label class="sr-only" for="site-search-mobile">{t.searchLabel}</label>
      <input
        id="site-search-mobile"
        name="q"
        type="search"
        placeholder={t.searchPlaceholder}
        class="box-border min-h-11 w-full rounded-[6px] border border-line-input bg-bg px-3 font-sans text-[14px] text-cream"
      />
    </form>
  </nav>

  <div class="mega-backdrop" data-mega-backdrop hidden></div>
</header>

<script>
  import { initMegaMenu } from '../scripts/mega-menu';

  function bind() {
    const header = document.querySelector<HTMLElement>('[data-mega-header]');
    if (header && !header.dataset.megaBound) {
      header.dataset.megaBound = 'true';
      initMegaMenu(header);
    }
  }

  bind();
  document.addEventListener('astro:page-load', bind);
</script>
