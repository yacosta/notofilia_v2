---
export const NAV_ICON_IDS = ['guides', 'glossary', 'news', 'asia', 'europe', 'north-america'] as const;

export type NavIconId = (typeof NAV_ICON_IDS)[number];

const FILL_ICON_IDS = new Set<NavIconId>(['asia', 'europe', 'north-america']);

interface Props {
  /** Decorative mark for Recursos links and polymer continent headings. */
  name?: string;
}

const { name } = Astro.props;
const icon = name && (NAV_ICON_IDS as readonly string[]).includes(name)
  ? (name as NavIconId)
  : undefined;
const filled = icon ? FILL_ICON_IDS.has(icon) : false;
---

{
  icon && (
    <span class="mega-nav-icon" aria-hidden="true">
      <svg
        class="mega-icon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill={filled ? 'currentColor' : 'none'}
        stroke={filled ? 'none' : 'currentColor'}
        stroke-width={filled ? undefined : '1.6'}
        stroke-linecap={filled ? undefined : 'round'}
        stroke-linejoin={filled ? undefined : 'round'}
        focusable="false"
      >
        {icon === 'guides' && <polygon points="7 3.75 17 3.75 17 20.25 12 16.4 7 20.25" />}
        {icon === 'glossary' && (
          <>
            <path d="M4.25 6.4C6.7 5.2 9.2 4.6 12 4.6s5.3.6 7.75 1.8v12.1c-2.45-1.2-4.95-1.8-7.75-1.8s-5.3.6-7.75 1.8V6.4Z" />
            <path d="M12 4.6v12.1" />
          </>
        )}
        {icon === 'news' && (
          <>
            <rect x="4.25" y="5" width="15.5" height="14" rx="1" />
            <path d="M7 9h10M7 12.25h7M7 15.5h10" />
          </>
        )}
        {icon === 'asia' && (
          <path d="M4.4 10.2 6.6 7.4 9.8 5.1 14.1 4.3 18 5 20.4 6.8 19.7 8.7 21.4 10.1 20 11.3 18.5 13.2 16.7 14.8 16.1 17.4 14.4 20 13 18.5 13.5 15.6 11.8 14.1 10.2 16 9.4 20.1 7.8 20.8 7.6 17.3 8.5 14.5 6.6 13.5 4.6 15.7 3.3 14.4 4.6 11.9 3.1 11Z" />
        )}
        {icon === 'europe' && (
          <>
            <path d="M10.7 4.1 13.4 4.6 15 6.7 13.9 8.5 16.2 9.5 18.2 11 17.3 13.2 15.4 14.8 16.1 17 14.4 17.8 13.6 15.5 12.1 18 10.7 17.1 11.8 14.2 10.1 13.4 8.3 15.5 6.7 17.1 5.5 16 6.2 13.6 7.8 12 6.7 10.3 8.4 8.9 10.1 7.9 9.4 5.9Z" />
            <path d="M5.3 7.5 7.6 6.7 8.5 8.2 7.6 9.9 5.7 9.4Z" />
          </>
        )}
        {icon === 'north-america' && (
          <path d="M2.7 7.5 4.8 5.1 8.3 4.3 12.4 4.8 15.4 6.5 17 8.8 15.9 10.6 17.2 11.8 15.5 12.8 14.4 15.2 15.5 16.6 14 17.4 12.7 19.5 10.9 20.7 9.9 18.8 10.9 16.6 9 15.2 7.4 16.1 6.4 14 7.9 12 5.8 10.5 3.8 9.5 2.7 8.2Z" />
        )}
      </svg>
    </span>
  )
}
