            <path d="M6.31 11.21 5.37 12.02 6.19 12.79 5.53 14 7.27 13.61 7.34 13.17 6.38 12.13 6.62 11.7 6.14 11.61Z" />
            <path d="M10.71 5.63 9.43 5.93 10.54 6.49 11.11 6.02 12.02 6.23 11.13 5.88 12.36 5.69Z" />
          </>
        )}
        {icon === 'north-america' && (
          <path d="M10.29 7.04 9.68 7.39 10.52 7.32 10.31 7.57 10.84 7.59 10.24 7.74 11.18 7.82 5.44 7.62 4.52 7.89 4.58 8.22 3.77 8.3 4.3 8.45 3.16 8.9 3.06 9.37 3.49 9.45 1.93 10.05 4.58 9.11 4.4 9.28 5.95 9.21 6.01 9.97 6.31 10.05 6.01 10.74 6.3 11.04 5.37 12.63 5.82 14.52 6.46 15.33 6.22 13.91 7 15.97 9.45 17.02 10.4 18.06 10.63 17.65 10.05 17.52 10.13 16.69 9.32 16.55 9.72 15.59 8.88 16.07 8.3 15.97 8.4 14.61 9.06 14.19 10.45 14.16 10.78 15.02 10.95 13.85 11.92 13.24 11.96 12.73 13.14 11.84 14.68 11.41 14.07 11.37 14.23 10.92 13.56 11.03 15.4 10.54 14.82 11.13 15.71 11.18 15.36 10.73 15.63 10.22 15.21 9.9 15.12 9.04 14.57 9.41 14.54 9 13.71 8.75 12.39 10.55 12.43 9.92 11.32 9.32 13.15 8.25 12.76 8.6 13.56 8.59 13.31 8.21 14.04 7.7 14.35 7.75 14.2 7.94 14.47 7.61 14.67 7.78 14.31 8.05 14.84 8.04 13.9 8.48 15.16 8.95 14.92 8.59 15.3 8.78 15.27 8.2 15.61 8.4 16.04 8.14 14.95 7.16 13.75 7.2 13.38 7.55 13.69 7.67 13.17 8.04 13.02 7.4 13.69 7.11 11.6 7.97 11.18 7.81 11.95 7.74 12.17 7.15 11.58 7.4Z" />
        )}
      </svg>
    </span>
  )
}
