---
export const NAV_ICON_IDS = [
  'guides',
  'glossary',
  'news',
  'asia',
  'europe',
  'north-america',
  'rency',
  'miscellaneous',
  'circus',
] as const;

export type NavIconId = (typeof NAV_ICON_IDS)[number];

const FILL_ICON_IDS = new Set<NavIconId>(['asia', 'europe', 'north-america']);

interface Props {
  /** Decorative mark for Recursos links, polymer continent headings, and US series cases. */
  name?: string;
}

const { name } = Astro.props;
const icon = name && (NAV_ICON_IDS as readonly string[]).includes(name)
  ? (name as NavIconId)
  : undefined;
const filled = icon ? FILL_ICON_IDS.has(icon) : false;
---

{
  icon && (
    <span class="mega-nav-icon" aria-hidden="true">
      <svg
        class="mega-icon"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill={filled ? 'currentColor' : 'none'}
        stroke={filled ? 'none' : 'currentColor'}
        stroke-width={filled ? undefined : '1.6'}
        stroke-linecap={filled ? undefined : 'round'}
        stroke-linejoin={filled ? undefined : 'round'}
        focusable="false"
      >
        {icon === 'guides' && <polygon points="7 3.75 17 3.75 17 20.25 12 16.4 7 20.25" />}
        {icon === 'glossary' && (
          <>
            <path d="M4.25 6.4C6.7 5.2 9.2 4.6 12 4.6s5.3.6 7.75 1.8v12.1c-2.45-1.2-4.95-1.8-7.75-1.8s-5.3.6-7.75 1.8V6.4Z" />
            <path d="M12 4.6v12.1" />
          </>
        )}
        {icon === 'news' && (
          <>
            <rect x="4.25" y="5" width="15.5" height="14" rx="1" />
            <path d="M7 9h10M7 12.25h7M7 15.5h10" />
          </>
        )}
        {icon === 'rency' && (
          <>
            <path d="M11.2 8.35V6.1h1.6V8.35" />
            <path d="M11.1 4.85h1.8v1.25h-1.8z" />
            <rect x="9.15" y="8.35" width="5.7" height="11.4" rx="1.15" />
            <path d="M10.55 12.4h2.9M10.55 14.7h2.1" />
            <path d="M12.9 5.15l3.55-2.25M12.9 5.15l4.05-1.05M12.9 5.15l3.85.4" />
          </>
        )}
        {icon === 'miscellaneous' && (
          <>
            <rect x="3.7" y="5.35" width="13.6" height="8.6" rx="1.1" />
            <rect x="6.7" y="10.05" width="13.6" height="8.6" rx="1.1" />
          </>
        )}
        {icon === 'circus' && (
          <>
            <circle cx="12" cy="3.45" r="1.15" fill="currentColor" stroke="none" />
            <path d="M12 4.6v2" />
            <path d="M3.9 11.25 12 6.35l8.1 4.9" />
            <path d="M3.9 11.25q2.05 1.75 4.05 0 2.05 1.75 4.05 0 2.05 1.75 4.05 0 2.05 1.75 4.05 0" />
            <path d="M4.45 11.55 5.3 20.4h13.4l.85-8.85" />
            <path d="M9.15 20.4Q12 13.9 14.85 20.4" />
          </>
        )}
        {
          /* Continent silhouettes simplified from CIA World Factbook Continents.svg (public domain). */
        }
        {icon === 'asia' && (
          <path d="M9.48 4.37 7.51 4.94 7.97 5.21 6.91 5.01 7.49 5.64 7.28 6.07 6.79 5.07 6.24 5.31 6.68 5.72 6.29 5.63 5.84 6.2 6.29 7.65 6.02 7.91 6.95 8.68 5.32 8.76 6.34 11.29 4.05 9.98 4.24 10.51 2.51 10.51 1.97 10.69 2.1 11.06 2.63 11.45 3.63 11.35 3.18 12.68 4.12 13.73 5.08 15.83 6.92 15.03 7.65 14.02 7.01 13.28 6.26 13.66 5.79 12.58 6.62 13.27 8.67 13.49 9.44 14.35 9.68 14.05 10.65 16.69 11.02 16.51 11.08 15.28 12.72 13.98 13.33 15.23 13.81 15.07 14.11 16.72 15.15 18.11 14.28 16.45 14.36 15.74 15.21 16.62 15.83 16.1 15.17 14.51 16.77 13.92 17.36 12.94 16.61 11.68 16.96 11.23 16.08 10.91 16.46 10.59 16.62 10.98 17.14 10.82 17.72 11.78 18.08 11.7 17.52 10.8 18.3 10.01 18.17 8.56 19.21 9.6 18.06 8.15 18.13 8.49 16.92 8.04 17.19 7.31 18.83 7.29 18.71 6.87 19.29 7.04 19.48 6.7 19.46 7.77 20.48 8.74 20.51 7.78 19.88 7.16 21.39 6.74 20.74 6.12 21.95 6.17 19.45 5.53 10.62 4.99 11.04 4.66Z" />
        )}
        {icon === 'europe' && (
          <>
