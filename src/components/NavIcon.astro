---
export const NAV_ICON_IDS = ['guides', 'glossary', 'news'] as const;

export type NavIconId = (typeof NAV_ICON_IDS)[number];

interface Props {
  /** Decorative line mark for Recursos panel links. */
  name?: string;
}

const { name } = Astro.props;

const paths: Record<NavIconId, string> = {
  guides:
    'M6 4.5h9.5A2.5 2.5 0 0 1 18 7v12.2c0 .9-1.1 1.3-1.8.7l-2.4-2.1-2.4 2.1c-.7.6-1.8.2-1.8-.7V7A2.5 2.5 0 0 0 7.1 4.5H6a2 2 0 0 0-2 2v13h2V6.5a.5.5 0 0 1 .5-.5H6Z',
  glossary:
    'M4 6.2C5.9 5.2 8 4.6 10.2 4.6H12v13.2h-1.6c-2.1 0-4.1.5-6 1.4V6.2Zm8.2-1.6c2.2 0 4.3.6 6.2 1.6v12.6c-1.9-.9-3.9-1.4-6-1.4H12V4.6h.2ZM11 8.2h-4v1.6h4V8.2Zm0 3.2H7.4v1.6H11v-1.6Zm6.6-3.2H13.6v1.6h4V8.2Zm0 3.2h-4v1.6h4v-1.6Z',
  news: 'M5 5h14v2H5V5Zm0 4h10v2H5V9Zm0 4h14v2H5v-2Zm0 4h10v2H5v-2Z',
};

const src = name && (NAV_ICON_IDS as readonly string[]).includes(name)
  ? paths[name as NavIconId]
  : undefined;
---

{
  src && (
    <span class="mega-nav-icon" aria-hidden="true">
      <svg class="mega-icon" viewBox="0 0 24 24" width="20" height="20" focusable="false">
        <path fill="currentColor" d={src}></path>
      </svg>
    </span>
  )
}
