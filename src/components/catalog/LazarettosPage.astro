---
import Layout from '../../layouts/Layout.astro';
import { localizePath, type Locale } from '../../lib/site';
import { lazarettosCopy, lazarettosPath } from '../../data/lazarettos';
import { NUMISMATICA_PATH } from '../../data/numismatica';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = lazarettosCopy[locale];
const pathname = lazarettosPath(locale);
---

<Layout title={t.metaTitle} description={t.metaDescription} locale={locale} pathname={pathname}>
  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <nav aria-label={locale === 'en' ? 'Breadcrumb' : 'Migas de pan'} class="mb-8">
        <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 font-sans text-[14px] text-muted">
          <li>
            <a class="inline-flex min-h-11 items-center text-gold-light hover:text-cream" href={localizePath('/', locale)}>
              {locale === 'en' ? 'Home' : 'Inicio'}
            </a>
          </li>
          <li aria-hidden="true">·</li>
          <li>
            <a
              class="inline-flex min-h-11 items-center text-gold-light hover:text-cream"
              href={localizePath(NUMISMATICA_PATH, locale)}
            >
              {locale === 'en' ? 'Numismatics' : 'Numismática'}
            </a>
          </li>
          <li aria-hidden="true">·</li>
          <li class="inline-flex min-h-11 items-center text-cream-dim" aria-current="page">{t.title}</li>
        </ol>
      </nav>

      <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">{t.kicker}</p>
      <h1 id="series-heading" class="mb-0 mt-3 font-display font-normal leading-[1.12] text-cream">
        <span class="block text-[clamp(1.75rem,4.2vw,2.85rem)] text-cream-dim">{t.title}</span>
      </h1>

      <div class="mt-10 w-full text-[17px]/7 text-cream">
        {t.intro.map((paragraph) => <p class="mb-5 mt-0 last:mb-0">{paragraph}</p>)}
      </div>

      <section class="mt-16" aria-labelledby="holdings-heading">
        <h2 id="holdings-heading" class="mb-0 mt-0 font-display text-[2rem]/10 font-normal text-cream-dim">
          {t.holdingsTitle}
        </h2>
      </section>

      <p class="mt-12">
        <a
          href={localizePath(NUMISMATICA_PATH, locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          {locale === 'en' ? 'Back to the numismatics catalog' : 'Volver al catálogo de numismática'}
        </a>
      </p>
    </article>
  </main>
</Layout>
