---
import CatalogThumb from './CatalogThumb.astro';
import { seriesCardHref, type ColombiaSeriesCardGroup } from '../../data/colombia-notes';
import { CATALOG_PIECE_GRID } from '../../lib/catalog-grid';
import type { Locale } from '../../lib/site';

interface Props {
  locale: Locale;
  groups: ColombiaSeriesCardGroup[];
  listLabel: string;
  pickLabel: string;
  serialLabel: string;
  viewNote: string;
  class?: string;
}

const { locale, groups, listLabel, pickLabel, serialLabel, viewNote, class: className } = Astro.props;
const titleClass =
  'mb-2 mt-0 font-display text-[clamp(0.85rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream';
---

<div class:list={['space-y-10', className]}>
  {
    groups.map((group) => {
      const Wrap = group.heading ? 'section' : 'div';
      const label = group.heading?.[locale] ?? listLabel;
      return (
        <Wrap
          class:list={[group.heading && 'scroll-mt-28']}
          aria-labelledby={group.heading ? `${group.id}-heading` : undefined}
        >
          {group.heading ? (
            <h3
              id={`${group.id}-heading`}
              class="mb-4 mt-0 font-display text-[1.45rem]/8 font-normal text-cream-dim"
            >
              {group.heading[locale]}
            </h3>
          ) : null}
          <ol class:list={['mb-0 mt-0', CATALOG_PIECE_GRID]} aria-label={label}>
            {group.cards.map(({ note, piece }) => (
              <li class="min-w-0">
                <a
                  href={seriesCardHref(note, piece, locale)}
                  class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
                >
                  <CatalogThumb
                    src={piece.images.front}
                    alt={piece.frontCaption[locale]}
                    width={1440}
                    height={960}
                    class="mb-3 aspect-[3/2] w-full rounded-[2px] bg-bg object-contain sm:mb-4"
                  />
                  {group.heading ? (
                    <h4 class={titleClass}>{piece.title[locale]}</h4>
                  ) : (
                    <h3 class={titleClass}>{piece.title[locale]}</h3>
                  )}
                  <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
                    {note.pickLabel?.[locale] ?? pickLabel} {piece.pick} · {serialLabel} {piece.serial}
                  </p>
                  <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{viewNote} →</span>
                </a>
              </li>
            ))}
          </ol>
        </Wrap>
      );
    })
  }
</div>
