---
import Layout from '../../layouts/Layout.astro';
import { localizePath, type Locale } from '../../lib/site';
import {
  seriesCopy,
  seriesSources,
  victoryNotes,
  notePath,
} from '../../data/philippines-victory-66';
import SourceList from './SourceList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = seriesCopy[locale];
const pathname = locale === 'en' ? '/en/coleccion/filipinas/' : '/coleccion/filipinas/';
---

<Layout title={t.metaTitle} description={t.metaDescription} locale={locale} pathname={pathname}>
  <main id="main-content" tabindex="-1" class="bg-bg outline-none">
    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
        {locale === 'en' ? 'Virtual collection' : 'Colección virtual'}
      </p>
      <h1 class="mb-8 mt-3 font-display font-normal leading-[1.12] text-cream-dim">
        <span class="block text-[clamp(1.75rem,4.2vw,2.85rem)]">{t.kicker}</span>
        <span class="mt-2 block text-[clamp(1.45rem,3.4vw,2.25rem)] text-cream">{t.title}</span>
      </h1>

      <div class="max-w-[46rem] space-y-5 text-[17px]/7 text-cream">
        {t.intro.map((paragraph) => <p class="m-0">{paragraph}</p>)}
      </div>

      <section class="mt-16" aria-labelledby="holdings-heading">
        <h2 id="holdings-heading" class="mb-3 mt-0 font-display text-[2rem]/10 font-normal text-cream-dim">
          {t.holdingsTitle}
        </h2>
        <p class="mb-8 mt-0 max-w-[42rem] text-[17px]/7 text-muted">{t.holdingsIntro}</p>

        <ol
          class="m-0 grid list-none grid-cols-3 gap-2 p-0 sm:gap-4"
          aria-label={locale === 'en' ? 'Notes lined up left to right by denomination' : 'Billetes alineados de izquierda a derecha por denominación'}
        >
          {
            [...victoryNotes]
              .sort((a, b) => Number.parseInt(a.id, 10) - Number.parseInt(b.id, 10))
              .map((note) => (
              <li class="min-w-0">
                <a
                  href={notePath(note, locale)}
                  class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
                >
                  <img
                    src={note.images.front}
                    alt={note.frontCaption[locale]}
                    width="2400"
                    height="800"
                    class="mb-3 aspect-[3/1] w-full rounded-[2px] bg-bg object-contain sm:mb-4"
                    decoding="async"
                  />
                  <h3 class="mb-2 mt-0 font-display text-[clamp(0.85rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
                    {note.title[locale]}
                  </h3>
                  <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
                    {t.pickLabel} {note.pick} · {t.serialLabel} {note.serial}
                  </p>
                  <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{t.viewNote} →</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="mt-16">
        <SourceList locale={locale} sources={seriesSources} heading={t.sourcesTitle} />
      </div>

      <p class="mt-12">
        <a
          href={localizePath('/', locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          {locale === 'en' ? 'Back to the homepage' : 'Volver al inicio'}
        </a>
      </p>
    </article>
  </main>
</Layout>
