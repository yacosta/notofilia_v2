---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import SeriesHero from './SeriesHero.astro';
import CatalogThumb from './CatalogThumb.astro';
import FaqBlock from '../FaqBlock.astro';
import { collectionPageJsonLd } from '../../lib/json-ld';
import { copy, localizePath, type Locale } from '../../lib/site';
import { localizeFaq, seriesFaqs } from '../../data/page-faq';
import {
  seriesCopy,
  seriesSources,
  seriesPath,
  victoryNotes,
  notePath,
} from '../../data/philippines-victory-66';
import SourceList from './SourceList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = seriesCopy[locale];
const pathname = seriesPath(locale);
const hero =
  locale === 'en'
    ? {
        src: '/images/catalog/philippines/hero-philippines.jpg',
        width: 1168,
        height: 784,
      }
    : {
        src: '/images/catalog/philippines/hero-filipinas.jpg',
        width: 1712,
        height: 1152,
      };

const faqItems = localizeFaq(seriesFaqs.philippines, locale);
const jsonLd = collectionPageJsonLd({
  locale,
  pathname,
  name: t.title,
  description: t.metaDescription,
  crumbs: [
    { name: copy[locale].home, path: '/' },
    { name: t.title, path: pathname },
  ],
  faq: faqItems,
});

---

<Layout title={t.metaTitle} description={t.metaDescription} locale={locale} pathname={pathname} ogImage={hero.src}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    <SeriesHero
      src={hero.src}
      alt={t.heroAlt}
      width={hero.width}
      height={hero.height}
      headingId="series-heading"
      eyebrow={copy[locale].virtualCollection}
      title={t.kicker}
      subtitle={t.title}
    />

    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { label: t.kicker },
        ]}
      />

      <div class="w-full text-[17px]/7 text-cream">
        {t.intro.map((paragraph) => <p class="mb-5 mt-0 last:mb-0">{paragraph}</p>)}
      </div>

      <section class="mt-16" aria-labelledby="holdings-heading">
        <h2 id="holdings-heading" class="mb-3 mt-0 font-display text-[2rem]/10 font-normal text-cream-dim">
          {t.holdingsTitle}
        </h2>
        <p class="mb-8 mt-0 w-full text-[17px]/7 text-muted">{t.holdingsIntro}</p>

        <ol
          class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2"
          aria-label={copy[locale].notesByDenomination}
        >
          {
            [...victoryNotes]
              .sort((a, b) => Number.parseInt(a.id, 10) - Number.parseInt(b.id, 10))
              .map((note) => (
              <li class="min-w-0">
                <a
                  href={notePath(note, locale)}
                  class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
                >
                  <CatalogThumb
                    src={note.images.front}
                    alt={note.frontCaption[locale]}
                    width={2400}
                    height={800}
                    class="mb-3 aspect-[3/1] w-full rounded-[2px] bg-bg object-contain sm:mb-4"
                  />
                  <h3 class="mb-2 mt-0 font-display text-[clamp(0.85rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
                    {note.title[locale]}
                  </h3>
                  <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
                    {t.pickLabel} {note.pick} · {t.serialLabel} {note.serial}
                  </p>
                  <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{t.viewNote} →</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <FaqBlock heading={copy[locale].faqHeading} items={faqItems} />

      <div class="mt-16">
        <SourceList locale={locale} sources={seriesSources} heading={t.sourcesTitle} />
      </div>

      <p class="mt-12">
        <a
          href={localizePath('/', locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          {copy[locale].backHome}
        </a>
      </p>
    </article>
  </main>
</Layout>
