---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import CatalogThumb from './CatalogThumb.astro';
import SeriesHero from './SeriesHero.astro';
import { coinagePieceById, coinagePiecePath } from '../../data/colombia-coinage-pieces';
import { enhanceProseHtml } from '../../data/editorial';
import { LAZARETTOS_PATH } from '../../data/lazarettos';
import {
  LAZARETTO_1921_COMPOSITE,
  LAZARETTO_1921_HOLDING_ID,
  LAZARETTOS_NUMISMATICS_HERO,
  lazarettosNumismaticsCopy,
  lazarettosNumismaticsPath,
} from '../../data/lazarettos-numismatics';
import bodyEs from '../../data/lazarettos-numismatics/es.html?raw';
import bodyEn from '../../data/lazarettos-numismatics/en.html?raw';
import { NUMISMATICA_PATH } from '../../data/numismatica';
import { CATALOG_PIECE_GRID } from '../../lib/catalog-grid';
import { imageObjectJsonLd } from '../../lib/json-ld';
import { PERSON_ID, SITE_AUTHOR, SITE_NAME, breadcrumbJsonLd } from '../../lib/seo';
import { copy, localizePath, SITE_URL, type Locale } from '../../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = lazarettosNumismaticsCopy[locale];
const pathname = lazarettosNumismaticsPath(locale);
const numismaticaHref = localizePath(NUMISMATICA_PATH, locale);
const caseHref = localizePath(LAZARETTOS_PATH, locale);
const body = enhanceProseHtml(locale === 'en' ? bodyEn : bodyEs, locale);
const holding = coinagePieceById(LAZARETTO_1921_HOLDING_ID);
if (!holding) {
  throw new Error(`Missing lazaretto holding ${LAZARETTO_1921_HOLDING_ID}`);
}
const holdingHref = coinagePiecePath(holding, locale);
const hero = LAZARETTOS_NUMISMATICS_HERO[locale];
const ogImage = hero.src;
const pageUrl = new URL(pathname, SITE_URL).href;
const imageUrl = new URL(ogImage, SITE_URL).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: t.title,
      description: t.metaDescription,
      datePublished: t.published,
      dateModified: t.published,
      inLanguage: locale,
      image: imageObjectJsonLd({ image: imageUrl, locale, caption: t.heroAlt }),
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      author: { '@type': 'Person', name: SITE_AUTHOR, '@id': PERSON_ID },
      reviewedBy: { '@type': 'Person', name: SITE_AUTHOR, '@id': PERSON_ID },
      publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
    },
    breadcrumbJsonLd([
      { name: t.home, item: localizePath('/', locale) },
      { name: t.numismatica, item: numismaticaHref },
      { name: t.nav, item: pathname },
    ]),
  ],
};
---

<Layout
  title={`${t.metaTitle} · Notofilia`}
  description={t.metaDescription}
  locale={locale}
  pathname={pathname}
  ogImage={ogImage}
  ogImageAlt={t.heroAlt}
  ogType="article"
  publishedTime={t.published}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    <SeriesHero
      src={hero.src}
      alt={t.heroAlt}
      width={hero.width}
      height={hero.height}
      headingId="lazarettos-numismatics-heading"
      eyebrow={copy[locale].virtualCollection}
      title={t.title}
      imageClass="object-[50%_40%]"
      size="compact"
    />

    <article class="mx-auto max-w-content px-[var(--page-gutter)] pb-16 pt-14 md:pb-24 md:pt-16">
      <Breadcrumb
        locale={locale}
        label={t.breadcrumb}
        items={[
          { href: localizePath('/', locale), label: t.home },
          { href: numismaticaHref, label: t.numismatica },
          { label: t.nav },
        ]}
      />

      <p class="mb-5 mt-0 max-w-[46rem] text-[clamp(19px,2.4vw,23px)] italic leading-[1.5] text-cream-dim">{t.lead}</p>
      <p class="mb-10 mt-0 font-sans text-[14px] text-muted">
        <time datetime={t.published}>{t.dateLabel}</time>
      </p>

      <section class="mb-10 mt-0" aria-labelledby="lazareto-holding-heading">
        <h2 id="lazareto-holding-heading" class="mb-3 mt-0 font-display text-[22px] font-normal text-cream">
          {t.holdingHeading}
        </h2>
        <p class="mb-6 mt-0 max-w-[46rem] text-[17px] leading-[1.6] text-cream-dim">{t.holdingIntro}</p>
        <ol class:list={['m-0', CATALOG_PIECE_GRID]} aria-label={t.holdingAria}>
          <li class="min-w-0">
            <a
              href={holdingHref}
              class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
            >
              <CatalogThumb
                src={holding.images.composite}
                alt={t.holdingImageAlt}
                width={LAZARETTO_1921_COMPOSITE.width}
                height={LAZARETTO_1921_COMPOSITE.height}
                class="mb-3 aspect-[3/2] w-full rounded-[2px] bg-bg object-contain sm:mb-4"
              />
              <h3 class="mb-2 mt-0 font-display text-[clamp(0.85rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
                {holding.title[locale]}
              </h3>
              <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
                {holding.year} · {holding.metal[locale]} · {holding.mint[locale]}
              </p>
              <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{t.viewCoin} →</span>
            </a>
          </li>
        </ol>
      </section>

      <div class="prose-notofilia" lang={locale} set:html={body} />

      <p class="mt-12 flex flex-col gap-3 font-sans text-[15px]">
        <a href={holdingHref} class="inline-flex min-h-11 items-center text-gold-light hover:text-cream">
          {t.holdingCta}
        </a>
        <a href={caseHref} class="inline-flex min-h-11 items-center text-gold-light hover:text-cream">
          {t.caseCta}
        </a>
        <a href={numismaticaHref} class="inline-flex min-h-11 items-center text-gold-light hover:text-cream">
          {t.numismaticaCta}
        </a>
      </p>
    </article>
  </main>
</Layout>
