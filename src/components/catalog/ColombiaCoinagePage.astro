---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import SeriesHero from './SeriesHero.astro';
import CatalogThumb from './CatalogThumb.astro';
import { collectionPageJsonLd } from '../../lib/json-ld';
import { copy, localizePath, type Locale } from '../../lib/site';
import { COLOMBIA_PATH } from '../../data/colombia';
import { COLOMBIA_COIN_CATALOG_PATH } from '../../data/colombia-coin-type-catalog';
import {
  coinageCopy,
  coinagePath,
  coinageSources,
  colombiaCoinageChapters,
} from '../../data/colombia-coinage';
import { colombiaCoinagePieces, coinagePiecePath } from '../../data/colombia-coinage-pieces';
import { NUMISMATICA_PATH } from '../../data/numismatica';
import SourceList from './SourceList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = coinageCopy[locale];
const pathname = coinagePath(locale);
const piecesByChapter = Object.fromEntries(
  colombiaCoinageChapters.map((chapter) => [
    chapter.id,
    colombiaCoinagePieces.filter((piece) => piece.chapterId === chapter.id),
  ]),
) as Record<(typeof colombiaCoinageChapters)[number]['id'], (typeof colombiaCoinagePieces)[number][]>;
const hero = {
  src: '/images/catalog/numismatica/hero-bogota.jpg',
  width: 2128,
  height: 912,
};

const jsonLd = collectionPageJsonLd({
  locale,
  pathname,
  name: t.title,
  description: t.metaDescription,
  crumbs: [
    { name: copy[locale].home, path: '/' },
    { name: copy[locale].numismaticsNav, path: NUMISMATICA_PATH },
    { name: t.kicker, path: pathname },
  ],
});

---

<Layout title={t.metaTitle} description={t.metaDescription} locale={locale} pathname={pathname}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    <SeriesHero
      src={hero.src}
      alt={t.heroAlt}
      width={hero.width}
      height={hero.height}
      headingId="series-heading"
      eyebrow={copy[locale].virtualCollection}
      title={t.kicker}
      subtitle={t.title}
  imageClass="object-[50%_18%] md:object-[50%_28%]"
    />

    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { href: localizePath(NUMISMATICA_PATH, locale), label: copy[locale].numismaticsNav },
          { label: t.kicker },
        ]}
      />

      <div class="w-full text-[17px]/7 text-cream">
        {t.intro.map((paragraph) => <p class="mb-5 mt-0 last:mb-0">{paragraph}</p>)}
      </div>

      <p class="mt-6 mb-0 text-[17px]/7 text-muted">
        {t.notaphilyLead}
        {' '}
        <a
          class="text-gold-light underline decoration-line-strong hover:text-cream"
          href={localizePath(COLOMBIA_PATH, locale)}
        >
          {t.notaphilyLink}
        </a>
      </p>
      <p class="mt-4 mb-0 text-[17px]/7 text-muted">
        {t.visualCatalogLead}
        {' '}
        <a
          class="text-gold-light underline decoration-line-strong hover:text-cream"
          href={localizePath(COLOMBIA_COIN_CATALOG_PATH, locale)}
        >
          {t.visualCatalogLink}
        </a>
      </p>

      <div class="mt-16 space-y-12">
        {
          colombiaCoinageChapters.map((chapter) => {
            const pieces = piecesByChapter[chapter.id] ?? [];
            return (
            <section id={chapter.id} class="scroll-mt-28" aria-labelledby={`${chapter.id}-heading`}>
              <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
                {chapter.years[locale]}
              </p>
              <h2
                id={`${chapter.id}-heading`}
                class="mb-3 mt-2 font-display text-[1.75rem]/9 font-normal text-cream-dim"
              >
                {chapter.title[locale]}
              </h2>
              <p class="mb-4 mt-0 text-[17px]/7 text-muted">{chapter.lead[locale]}</p>
              <p class="m-0 text-[17px]/7 text-cream">{chapter.body[locale]}</p>
              {
                pieces.length > 0 ? (
                  <ul class="mt-8 m-0 grid list-none gap-4 p-0">
                    {pieces.map((piece) => (
                      <li>
                        <a
                          href={coinagePiecePath(piece, locale)}
                          class="group flex flex-col rounded-[6px] border border-line-strong bg-panel p-3 text-inherit no-underline hover:border-gold-light sm:flex-row sm:items-center sm:gap-6 sm:p-4"
                        >
                          <CatalogThumb
                            src={piece.images.composite}
                            alt={piece.title[locale]}
                            width={1536}
                            height={1024}
                            class="mb-4 aspect-[3/2] w-full rounded-[2px] bg-bg object-contain sm:mb-0 sm:max-w-[16rem]"
                          />
                          <div class="min-w-0">
                            <h3 class="mb-2 mt-0 font-display text-[1.35rem]/7 font-normal text-cream-dim group-hover:text-cream">
                              {piece.title[locale]}
                            </h3>
                            <p class="mb-3 mt-0 font-sans text-[14px]/5 text-muted">{piece.lead[locale]}</p>
                            <span class="font-sans text-[15px] text-gold-light">{t.viewPiece} →</span>
                          </div>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null
              }
            </section>
            );
          })
        }
      </div>

      <div class="mt-16">
        <SourceList locale={locale} sources={coinageSources} heading={t.sourcesTitle} />
      </div>

      <p class="mt-12">
        <a
          href={localizePath(NUMISMATICA_PATH, locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          {copy[locale].backNumismatics}
        </a>
      </p>
    </article>
  </main>
</Layout>
