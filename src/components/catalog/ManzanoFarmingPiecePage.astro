---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import NoteImageLightbox from './NoteImageLightbox.astro';
import SourceList from './SourceList.astro';
import { COLOMBIA_COINAGE_PATH } from '../../data/colombia-coinage';
import { HACIENDA_TOKENS_PATH, haciendaTokensPath } from '../../data/hacienda-tokens';
import { MANZANO_FARMING_PATH, manzanoFarmingCopy, manzanoFarmingPath } from '../../data/manzano-farming';
import {
  MANZANO_FARMING_PIECE_IMAGES,
  manzanoFarmingPieceCopy,
  manzanoFarmingPiecePath,
  manzanoFarmingPieceSources,
} from '../../data/manzano-farming-piece';
import { NUMISMATICA_PATH } from '../../data/numismatica';
import { linkFirstGlossaryTerms } from '../../lib/catalog-media';
import { breadcrumbList, visualArtworkJsonLd } from '../../lib/json-ld';
import { localizePath, type Locale } from '../../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = manzanoFarmingPieceCopy[locale];
const crumbs = manzanoFarmingCopy[locale];
const pathname = manzanoFarmingPiecePath(locale);
const numismaticaHref = localizePath(NUMISMATICA_PATH, locale);
const seriesHref = localizePath(COLOMBIA_COINAGE_PATH, locale);
const fichasHref = haciendaTokensPath(locale);
const essayHref = manzanoFarmingPath(locale);
const documentTitle = `${t.metaTitle} · Notofilia`;
const about = `${t.description} ${t.descriptionRest}`;
const jsonCrumbs = [
  { name: crumbs.home, path: '/' },
  { name: crumbs.numismatica, path: NUMISMATICA_PATH },
  { name: crumbs.series, path: COLOMBIA_COINAGE_PATH },
  { name: crumbs.fichas, path: HACIENDA_TOKENS_PATH },
  { name: crumbs.nav, path: MANZANO_FARMING_PATH },
  { name: t.h1, path: pathname },
];
---

<Layout title={documentTitle} description={t.metaDescription} locale={locale} pathname={pathname} ogImage={MANZANO_FARMING_PIECE_IMAGES.composite}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          breadcrumbList(jsonCrumbs, locale),
          visualArtworkJsonLd({
            name: t.h1,
            description: t.metaDescription,
            url: pathname,
            image: MANZANO_FARMING_PIECE_IMAGES.composite,
            locale,
            artform: 'Coin',
            issuer: 'Manzano Farming Co.',
            collectionUrl: essayHref,
            collectionName: crumbs.nav,
          }),
        ],
      })}
    />
  </Fragment>
  <main id="main-content" tabindex="-1" class="bg-bg outline-none">
    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        label={crumbs.breadcrumb}
        items={[
          { href: localizePath('/', locale), label: crumbs.home },
          { href: numismaticaHref, label: crumbs.numismatica },
          { href: seriesHref, label: crumbs.series },
          { href: fichasHref, label: crumbs.fichas },
          { href: essayHref, label: crumbs.nav },
          { label: t.h1 },
        ]}
      />

      <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
        {t.kicker}
      </p>
      <h1 class="mb-2 mt-3 font-display text-[clamp(1.85rem,4vw,2.85rem)] font-normal leading-[1.15] text-cream-dim">
        {t.h1}
      </h1>
      <p class="mb-4 mt-0 font-display text-[1.15rem]/7 text-cream">{t.title}</p>
      <p class="mb-10 mt-0 max-w-[46rem] text-[17px]/7 text-muted">{t.lead}</p>

      <section class="mb-14 rounded-[6px] border border-line-strong bg-panel p-6" aria-labelledby="facts-heading">
        <h2 id="facts-heading" class="mb-4 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">
          {t.factsHeading}
        </h2>
        <dl class="m-0 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.referenceLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.reference}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.yearLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.year}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.valueLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.value}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.metalLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.metal}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.placeLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.place}</dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.countermarkLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.countermark}</dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.gradeLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.grade}</dd>
          </div>
        </dl>
      </section>

      <div class="grid gap-10 lg:grid-cols-2">
        <figure class="m-0">
          <h2 class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">{t.frontHeading}</h2>
          <NoteImageLightbox
            src={MANZANO_FARMING_PIECE_IMAGES.front}
            sideLabel={t.frontHeading}
            title={t.title}
            expandLabel={t.expandImage}
            closeLabel={t.closeLightbox}
            locale={locale}
            width={MANZANO_FARMING_PIECE_IMAGES.width}
            height={MANZANO_FARMING_PIECE_IMAGES.height}
            eager
          />
          <figcaption class="mt-3 font-sans text-[14px]/6 text-muted">{t.frontCaption}</figcaption>
        </figure>
        <figure class="m-0">
          <h2 class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">{t.pairHeading}</h2>
          <NoteImageLightbox
            src={MANZANO_FARMING_PIECE_IMAGES.composite}
            sideLabel={t.pairHeading}
            title={t.title}
            expandLabel={t.expandImage}
            closeLabel={t.closeLightbox}
            locale={locale}
            width={MANZANO_FARMING_PIECE_IMAGES.width}
            height={MANZANO_FARMING_PIECE_IMAGES.height}
          />
          <figcaption class="mt-3 font-sans text-[14px]/6 text-muted">{t.pairCaption}</figcaption>
        </figure>
      </div>

      <section class="mt-14" aria-labelledby="about-heading">
        <h2 id="about-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.aboutHeading}
        </h2>
        <p class="m-0 text-[17px]/7 text-cream" set:html={linkFirstGlossaryTerms(about, locale)} />
      </section>

      <section class="mt-12" aria-labelledby="scarcity-heading">
        <h2 id="scarcity-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.scarcityHeading}
        </h2>
        <p class="m-0 text-[17px]/7 text-cream">{t.scarcity}</p>
      </section>

      <div class="mt-16">
        <SourceList locale={locale} sources={manzanoFarmingPieceSources} heading={t.sourcesHeading} />
      </div>

      <p class="mt-12">
        <a
          href={essayHref}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          ← {t.essayCta}
        </a>
      </p>
    </article>
  </main>
</Layout>
