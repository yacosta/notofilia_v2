---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import FaqBlock from '../FaqBlock.astro';
import SeriesHero from './SeriesHero.astro';
import CatalogThumb from './CatalogThumb.astro';
import { CATALOG_PIECE_GRID } from '../../lib/catalog-grid';
import { enhanceProseHtml } from '../../data/editorial';
import { collectionPageJsonLd } from '../../lib/json-ld';
import { copy, localizePath, type Locale } from '../../lib/site';
import { localizeFaq, seriesFaqs } from '../../data/page-faq';
import bodyEs from '../../data/wwii-emergency-banknotes/es.html?raw';
import bodyEn from '../../data/wwii-emergency-banknotes/en.html?raw';
import SourceList from './SourceList.astro';
import { NOTAFILIA_PATH } from '../../data/notafilia';
import { noteById, notePath, USA_MPC_PATH, USA_MPC_PROGRAM_PATH, USA_PATH } from '../../data/estados-unidos';
import { SERIES_PATH } from '../../data/philippines-victory-66';
import {
  WWII_EMERGENCY_HERO,
  WWII_HAWAII_NOTE_ID,
  wwiiEmergencyCopy,
  wwiiEmergencyPath,
  wwiiEmergencySources,
} from '../../data/wwii-emergency-banknotes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = wwiiEmergencyCopy[locale];
const pathname = wwiiEmergencyPath(locale);
const hero = WWII_EMERGENCY_HERO[locale];
const hawaiiNote = noteById(WWII_HAWAII_NOTE_ID);
if (!hawaiiNote) throw new Error('Missing HAWAII $1 holding for the WWII emergency case');
const body = enhanceProseHtml(locale === 'en' ? bodyEn : bodyEs, locale);
const faqItems = localizeFaq(seriesFaqs['wwii-emergency'], locale);
const jsonLd = collectionPageJsonLd({
  locale,
  pathname,
  name: t.title,
  description: t.metaDescription,
  crumbs: [
    { name: copy[locale].home, path: '/' },
    { name: t.parentLink, path: NOTAFILIA_PATH },
    { name: t.breadcrumbCurrent, path: pathname },
  ],
  faq: faqItems,
});
---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  locale={locale}
  pathname={pathname}
  ogType="article"
  ogImage={hero.src}
  ogImageAlt={t.heroAlt}
  publishedTime="2026-09-20"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    <SeriesHero
      src={hero.src}
      alt={t.heroAlt}
      width={hero.width}
      height={hero.height}
      headingId="series-heading"
      eyebrow={copy[locale].virtualCollection}
      title={t.kicker}
      subtitle={t.title}
      imageClass="object-[50%_40%]"
      size="compact"
    />

    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { href: localizePath(NOTAFILIA_PATH, locale), label: t.parentLink },
          { label: t.breadcrumbCurrent },
        ]}
      />

      <p class="mb-5 mt-4 max-w-[46rem] text-[clamp(19px,2.4vw,23px)] italic leading-[1.5] text-cream-dim">
        {t.intro[0]}
      </p>
      <p class="mb-0 mt-2 max-w-[46rem] font-sans text-[13px] tracking-[0.04em] text-muted">
        <span>{t.byline}</span>
        {' · '}
        <span>{t.updatedLabel} {t.updatedDate}</span>
      </p>

      <section class="mt-12 rounded-[6px] border border-line-strong bg-panel p-6" aria-labelledby="series-facts-heading">
        <h2 id="series-facts-heading" class="mb-4 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">
          {t.factsHeading}
        </h2>
        <dl class="m-0 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">
              {t.periodLabel}
            </dt>
            <dd class="m-0 mt-1 text-cream">{t.periodValue}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">
              {t.holdingsLabel}
            </dt>
            <dd class="m-0 mt-1 text-cream">{t.holdingsValue}</dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">
              {t.typesLabel}
            </dt>
            <dd class="m-0 mt-1 text-cream">{t.typesValue}</dd>
          </div>
        </dl>
        <p class="mb-0 mt-6 text-[15px]/6 text-muted">{t.holdingsNote}</p>
      </section>

      <ol class:list={['mb-0 mt-8', CATALOG_PIECE_GRID]} aria-label={t.holdingsListLabel}>
        <li class="min-w-0">
          <a
            href={notePath(hawaiiNote, locale)}
            class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
          >
            <CatalogThumb
              src={hawaiiNote.images.front}
              alt={hawaiiNote.frontCaption[locale]}
              width={hawaiiNote.images.width}
              height={hawaiiNote.images.height}
              class="mb-3 aspect-[3/2] w-full rounded-[2px] bg-bg object-contain sm:mb-4"
            />
            <h2 class="mb-2 mt-0 font-display text-[clamp(0.85rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
              {hawaiiNote.title[locale]}
            </h2>
            <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
              {t.pickLabel} {hawaiiNote.pick} · {t.serialLabel} {hawaiiNote.serial}
            </p>
            <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{t.viewNote} →</span>
          </a>
        </li>
      </ol>

      <div class="prose-notofilia mt-12" lang={locale} set:html={body} />

      <p class="mt-12 mb-0 text-[17px]/7 text-muted">
        {t.usLead}
        {' '}
        <a
          class="text-gold-light underline decoration-line-strong hover:text-cream"
          href={localizePath(USA_PATH, locale)}
        >
          {t.usLink}
        </a>
      </p>
      <p class="mt-4 mb-0 text-[17px]/7 text-muted">
        {t.mpcLead}
        {' '}
        <a
          class="text-gold-light underline decoration-line-strong hover:text-cream"
          href={localizePath(USA_MPC_PROGRAM_PATH, locale)}
        >
          {t.mpcLink}
        </a>
      </p>
      <p class="mt-4 mb-0 text-[17px]/7 text-muted">
        {t.mpcVietnamLead}
        {' '}
        <a
          class="text-gold-light underline decoration-line-strong hover:text-cream"
          href={localizePath(USA_MPC_PATH, locale)}
        >
          {t.mpcVietnamLink}
        </a>
      </p>
      <p class="mt-4 mb-0 text-[17px]/7 text-muted">
        {t.philippinesLead}
        {' '}
        <a
          class="text-gold-light underline decoration-line-strong hover:text-cream"
          href={localizePath(SERIES_PATH, locale)}
        >
          {t.philippinesLink}
        </a>
      </p>

      <p class="mb-0 mt-12 text-[17px]/7 text-muted">{t.sourcesLead}</p>
      <div class="mt-8">
        <SourceList locale={locale} sources={wwiiEmergencySources} heading={t.sourcesTitle} />
      </div>

      {faqItems.length ? <FaqBlock heading={copy[locale].faqHeading} items={faqItems} /> : null}

      <p class="mt-12">
        <a
          href={localizePath(NOTAFILIA_PATH, locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          {t.notafiliaCta}
        </a>
      </p>
    </article>
  </main>
</Layout>
