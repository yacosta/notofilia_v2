---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import { copy, localizePath, type Locale } from '../../lib/site';
import { visualArtworkJsonLd } from '../../lib/json-ld';
import { catalogScanAlt } from '../../lib/catalog-alt';
import { COLOMBIA_COINAGE_PATH, coinageCopy, coinagePath } from '../../data/colombia-coinage';
import {
  coinagePieceCopy,
  coinagePiecePath,
  type ColombiaCoinagePiece,
} from '../../data/colombia-coinage-pieces';
import SourceList from './SourceList.astro';
import NoteImageLightbox from './NoteImageLightbox.astro';

interface Props {
  locale: Locale;
  piece: ColombiaCoinagePiece;
}

const { locale, piece } = Astro.props;
const t = coinagePieceCopy[locale];
const series = coinageCopy[locale];
const pathname = coinagePiecePath(piece, locale);
---

<Layout title={`${piece.title[locale]} | Notofilia`} description={piece.lead[locale]} locale={locale} pathname={pathname} ogImage={piece.images.composite}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        ...visualArtworkJsonLd({
          name: piece.title[locale],
          description: piece.lead[locale],
          url: pathname,
          image: piece.images.front,
          imageBack: piece.images.back,
          locale,
          artform: 'Coin',
        }),
      })}
    />
  </Fragment>
  <main id="main-content" tabindex="-1" class="bg-bg outline-none">
    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { href: localizePath(COLOMBIA_COINAGE_PATH, locale), label: t.collectionLink },
          { href: `${coinagePath(locale)}#independencia`, label: t.chapterLink },
          { label: piece.title[locale] },
        ]}
      />

      <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
        {piece.kicker[locale]}
      </p>
      <h1 class="mb-4 mt-3 font-display text-[clamp(1.85rem,4vw,2.85rem)] font-normal leading-[1.15] text-cream-dim">
        {piece.title[locale]}
      </h1>
      <p class="mb-10 mt-0 max-w-[46rem] text-[17px]/7 text-muted">{piece.lead[locale]}</p>

      <section class="mb-14 rounded-[6px] border border-line-strong bg-panel p-6" aria-labelledby="facts-heading">
        <h2 id="facts-heading" class="mb-4 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">
          {t.factsHeading}
        </h2>
        <dl class="m-0 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.referenceLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{piece.reference}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.yearLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{piece.year}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.metalLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{piece.metal[locale]}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.mintLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{piece.mint[locale]}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.gradeLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{piece.grade[locale]}</dd>
          </div>
        </dl>
      </section>

      <div class="grid gap-10 lg:grid-cols-2">
        <figure class="m-0">
          <h2 class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">{t.frontHeading}</h2>
          <NoteImageLightbox
            src={piece.images.front}
            alt={catalogScanAlt(locale, { title: piece.title[locale], pick: piece.reference, side: 'front' })}
            expandLabel={t.expandImage}
            closeLabel={t.closeLightbox}
            locale={locale}
          />
          <figcaption class="mt-3 font-sans text-[14px]/6 text-muted">{piece.frontCaption[locale]}</figcaption>
        </figure>
        <figure class="m-0">
          <h2 class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">{t.backHeading}</h2>
          <NoteImageLightbox
            src={piece.images.back}
            alt={catalogScanAlt(locale, { title: piece.title[locale], pick: piece.reference, side: 'back' })}
            expandLabel={t.expandImage}
            closeLabel={t.closeLightbox}
            locale={locale}
          />
          <figcaption class="mt-3 font-sans text-[14px]/6 text-muted">{piece.backCaption[locale]}</figcaption>
        </figure>
      </div>

      <section class="mt-14" aria-labelledby="about-heading">
        <h2 id="about-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.aboutHeading}
        </h2>
        <p class="m-0 text-[17px]/7 text-cream">{piece.description[locale]}</p>
      </section>

      <section class="mt-12" aria-labelledby="scarcity-heading">
        <h2 id="scarcity-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.scarcityHeading}
        </h2>
        <p class="m-0 text-[17px]/7 text-cream">{piece.scarcity[locale]}</p>
      </section>

      <div class="mt-16">
        <SourceList locale={locale} sources={piece.sources} heading={t.sourcesHeading} />
      </div>

      <p class="mt-12">
        <a
          href={coinagePath(locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          ← {series.kicker}
        </a>
      </p>
    </article>
  </main>
</Layout>
