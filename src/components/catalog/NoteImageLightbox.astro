---
import {
  catalogDownloadFilename,
  catalogDownloadLabel,
  catalogDownloadSrc,
} from '../../lib/catalog-media';
import type { Locale } from '../../lib/site';

interface Props {
  src: string;
  alt: string;
  expandLabel: string;
  closeLabel: string;
  locale: Locale;
  width?: number;
  height?: number;
}

const { src, alt, expandLabel, closeLabel, locale, width = 1800, height = 900 } = Astro.props;
const dialogId = `note-lightbox-${src.replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const downloadHref = catalogDownloadSrc(src);
const downloadName = catalogDownloadFilename(src);
const downloadLabel = catalogDownloadLabel(src, locale);
---

<div class="note-lightbox-root" data-note-lightbox>
  <button
    type="button"
    class="note-lightbox-trigger group relative block w-full cursor-zoom-in border-0 bg-transparent p-0 text-left"
    aria-haspopup="dialog"
    aria-controls={dialogId}
    data-note-lightbox-open
  >
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      class="w-full rounded-[2px] border border-line bg-panel object-contain"
      decoding="async"
    />
    <span
      class="pointer-events-none absolute bottom-3 right-3 rounded-[6px] border border-line-strong bg-panel/92 px-3 py-1.5 font-sans text-[13px] font-semibold tracking-[0.06em] text-gold-light opacity-90 group-hover:text-cream group-hover:opacity-100"
      aria-hidden="true"
    >
      {expandLabel}
    </span>
  </button>

  <p class="mb-0 mt-3">
    <a
      class="inline-flex min-h-11 items-center font-sans text-[14px] font-semibold text-gold-light underline decoration-gold-light/50 hover:text-cream"
      href={downloadHref}
      download={downloadName}
    >
      {downloadLabel}
    </a>
  </p>

  <dialog
    id={dialogId}
    class="note-lightbox m-0 h-full max-h-none w-full max-w-none border-0 bg-transparent p-0 text-cream"
    data-note-lightbox-dialog
    aria-labelledby={`${dialogId}-title`}
  >
    <div class="note-lightbox-backdrop flex min-h-full items-center justify-center p-4 md:p-8" data-note-lightbox-backdrop>
      <div
        class="note-lightbox-chrome flex max-h-[min(94vh,56rem)] w-full max-w-[min(96vw,72rem)] flex-col overflow-hidden rounded-[6px] border border-line-strong bg-panel shadow-[0_16px_32px_rgba(0,0,0,0.45)]"
        role="document"
      >
        <div class="flex items-center justify-between gap-4 border-b border-line px-4 py-3">
          <p id={`${dialogId}-title`} class="m-0 min-w-0 truncate font-sans text-[14px] text-cream-dim">
            {alt}
          </p>
          <div class="flex shrink-0 flex-wrap items-center justify-end gap-2">
            <a
              class="inline-flex min-h-11 items-center rounded-[6px] border border-line-strong bg-transparent px-4 font-sans text-[14px] font-semibold text-cream hover:bg-ink"
              href={downloadHref}
              download={downloadName}
            >
              {downloadLabel}
            </a>
            <button
              type="button"
              class="inline-flex min-h-11 items-center rounded-[6px] border border-line-input bg-cream px-4 font-sans text-[14px] font-semibold text-bg hover:bg-cream-dim"
              data-note-lightbox-close
            >
              {closeLabel}
            </button>
          </div>
        </div>
        <div class="flex min-h-0 flex-1 items-center justify-center overflow-auto bg-bg p-3 md:p-5">
          <img
            src={src}
            alt={alt}
            width={width}
            height={height}
            class="max-h-[min(78vh,48rem)] w-auto max-w-full object-contain"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </dialog>
</div>

<style>
  .note-lightbox[open] {
    display: block;
  }

  .note-lightbox::backdrop {
    background: rgb(10 10 9 / 0.88);
  }

  .note-lightbox-backdrop {
    background: rgb(10 10 9 / 0.88);
  }
</style>

<script>
  const FOCUSABLE =
    'a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])';

  function focusableIn(container: HTMLElement): HTMLElement[] {
    return [...container.querySelectorAll<HTMLElement>(FOCUSABLE)].filter(
      (el) => !el.hasAttribute('disabled') && el.getAttribute('aria-hidden') !== 'true',
    );
  }

  function bindLightbox(root: HTMLElement) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-note-lightbox-dialog]');
    const openButton = root.querySelector<HTMLButtonElement>('[data-note-lightbox-open]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-note-lightbox-close]');
    const backdrop = root.querySelector<HTMLElement>('[data-note-lightbox-backdrop]');

    if (!dialog || !openButton || !closeButton || !backdrop) return;
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    let lastFocus: HTMLElement | null = null;

    const closeLightbox = () => {
      if (dialog.open) {
        dialog.close();
      }
    };

    const restoreFocus = () => {
      const target = lastFocus ?? openButton;
      lastFocus = null;
      target.focus();
    };

    openButton.addEventListener('click', () => {
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : openButton;
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      closeButton.focus();
    });

    closeButton.addEventListener('click', () => {
      closeLightbox();
    });

    backdrop.addEventListener('click', (event) => {
      if (event.target === backdrop) {
        closeLightbox();
      }
    });

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeLightbox();
    });

    dialog.addEventListener('close', () => {
      restoreFocus();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeLightbox();
        return;
      }

      if (event.key !== 'Tab') return;

      const nodes = focusableIn(dialog);
      if (nodes.length === 0) {
        event.preventDefault();
        return;
      }

      const first = nodes[0];
      const last = nodes[nodes.length - 1];
      const active = document.activeElement;

      if (event.shiftKey && (active === first || !dialog.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (active === last || !dialog.contains(active))) {
        event.preventDefault();
        first.focus();
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-note-lightbox]').forEach(bindLightbox);
</script>
