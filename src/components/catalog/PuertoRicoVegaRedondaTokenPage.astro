---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import NoteImageLightbox from './NoteImageLightbox.astro';
import PieceSiblings from './PieceSiblings.astro';
import SourceList from './SourceList.astro';
import {
  vegaRedondaCoinageHref,
  vegaRedondaCopy,
  vegaRedondaNumismaticsHref,
  vegaRedondaPath,
  vegaRedondaTokenChrome,
  vegaRedondaTokenPath,
  vegaRedondaTokens,
  type VegaRedondaToken,
} from '../../data/vega-redonda';
import { linkFirstGlossaryTerms, pieceScanAlt, pieceSiblings } from '../../lib/catalog-media';
import { breadcrumbList, visualArtworkJsonLd } from '../../lib/json-ld';
import { copy, localizePath, type Locale } from '../../lib/site';

interface Props {
  locale: Locale;
  token: VegaRedondaToken;
}

const { locale, token } = Astro.props;
const t = vegaRedondaTokenChrome[locale];
const series = vegaRedondaCopy[locale];
const pathname = vegaRedondaTokenPath(token, locale);
const seriesHref = vegaRedondaPath(locale);
const siblings = pieceSiblings(vegaRedondaTokens, token.path);
const scanAlt = pieceScanAlt({
  sideLabel: t.faceHeading,
  title: token.title[locale],
  catalogNumber: token.altCatalog,
});
const jsonCrumbs = [
  { name: copy[locale].home, path: '/' },
  { name: series.numismatica, path: '/coleccion/numismatica/' },
  { name: series.series, path: '/coleccion/puerto-rico-numismatica/' },
  { name: series.nav, path: '/coleccion/puerto-rico-numismatica/hacienda-vega-redonda/' },
  { name: token.h1[locale], path: token.path },
];
---

<Layout
  title={`${token.metaTitle[locale]} · Notofilia`}
  description={token.metaDescription[locale]}
  locale={locale}
  pathname={pathname}
  ogImage={token.images.front}
  ogImageAlt={scanAlt}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          breadcrumbList(jsonCrumbs, locale),
          visualArtworkJsonLd({
            name: token.h1[locale],
            description: token.metaDescription[locale],
            url: pathname,
            image: token.images.front,
            imageWidth: token.images.width,
            imageHeight: token.images.height,
            locale,
            artform: 'Coin',
            catalogNumber: token.references,
            issuer: 'Hacienda Vega Redonda',
            collectionUrl: seriesHref,
            collectionName: series.nav,
          }),
        ],
      })}
    />
  </Fragment>
  <main id="main-content" tabindex="-1" class="bg-bg outline-none">
    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { href: vegaRedondaNumismaticsHref(locale), label: series.numismatica },
          { href: vegaRedondaCoinageHref(locale), label: series.series },
          { href: seriesHref, label: series.nav },
          { label: token.h1[locale] },
        ]}
      />

      <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
        {token.kicker[locale]}
      </p>
      <h1 class="mb-2 mt-3 font-display text-[clamp(1.85rem,4vw,2.85rem)] font-normal leading-[1.15] text-cream-dim">
        {token.h1[locale]}
      </h1>
      <p class="mb-4 mt-0 font-display text-[1.15rem]/7 text-cream">{token.title[locale]}</p>
      <p class="mb-10 mt-0 max-w-[46rem] text-[17px]/7 text-muted">{token.lead[locale]}</p>

      <section class="mb-14 rounded-[6px] border border-line-strong bg-panel p-6" aria-labelledby="facts-heading">
        <h2 id="facts-heading" class="mb-4 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">
          {t.factsHeading}
        </h2>
        <dl class="m-0 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.referenceLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{token.references}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.yearLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{token.year[locale]}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.valueLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{token.denomination[locale]}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.metalLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{token.composition[locale]}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.weightLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{token.weight[locale]}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.diameterLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{token.diameter[locale]}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.edgeLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{token.edge[locale]}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.placeLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{token.place[locale]}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.alignmentLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{token.alignment[locale]}</dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.gradeLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{token.grade[locale]}</dd>
          </div>
        </dl>
      </section>

      <figure class="m-0">
        <h2 class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">{t.faceLabel}</h2>
        <NoteImageLightbox
          src={token.images.front}
          sideLabel={t.faceHeading}
          title={token.title[locale]}
          catalogNumber={token.altCatalog}
          expandLabel={t.expandImage}
          closeLabel={t.closeLightbox}
          locale={locale}
          width={token.images.width}
          height={token.images.height}
          eager
        />
        <figcaption class="mt-3 font-sans text-[14px]/6 text-muted">{token.caption[locale]}</figcaption>
      </figure>

      <section class="mt-14" aria-labelledby="about-heading">
        <h2 id="about-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.aboutHeading}
        </h2>
        <p class="m-0 text-[17px]/7 text-cream" set:html={linkFirstGlossaryTerms(token.description[locale], locale)} />
      </section>

      <section class="mt-12" aria-labelledby="legend-heading">
        <h2 id="legend-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.legendHeading}
        </h2>
        <p class="m-0 text-[17px]/7 text-cream">{token.legend[locale]}</p>
      </section>

      <section class="mt-12" aria-labelledby="scarcity-heading">
        <h2 id="scarcity-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.scarcityHeading}
        </h2>
        <p class="m-0 text-[17px]/7 text-cream">{token.scarcity[locale]}</p>
      </section>

      <div class="mt-16">
        <SourceList locale={locale} sources={token.sources} heading={t.sourcesHeading} />
      </div>

      <PieceSiblings
        locale={locale}
        prev={siblings.prev ? { href: vegaRedondaTokenPath(siblings.prev, locale), title: siblings.prev.title[locale], image: siblings.prev.images.front } : undefined}
        next={siblings.next ? { href: vegaRedondaTokenPath(siblings.next, locale), title: siblings.next.title[locale], image: siblings.next.images.front } : undefined}
        related={siblings.related.map((item) => ({
          href: vegaRedondaTokenPath(item, locale),
          title: item.title[locale],
          image: item.images.front,
        }))}
        relatedLead={t.relatedLead}
      />

      <p class="mt-12">
        <a href={seriesHref} class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream">
          {t.backToSeries}
        </a>
      </p>
    </article>
  </main>
</Layout>
