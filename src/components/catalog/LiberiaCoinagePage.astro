---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import SeriesHero from './SeriesHero.astro';
import CatalogThumb from './CatalogThumb.astro';
import { collectionPageJsonLd } from '../../lib/json-ld';
import { copy, localizePath, type Locale } from '../../lib/site';
import {
  coinPageCopy,
  coinagePath,
  coinPath,
  NUMISMATICS_PATH,
  seriesCopy,
  seriesSources,
  liberiaCoinageChapters,
  liberiaCoins,
} from '../../data/liberia-coinage';
import SourceList from './SourceList.astro';
import { CATALOG_PIECE_GRID } from '../../lib/catalog-grid';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = seriesCopy[locale];
const pieces = coinPageCopy[locale];
const pathname = coinagePath(locale);
const heroCoin = liberiaCoins[0];
const hero = heroCoin?.images
  ? {
      src: heroCoin.images.composite,
      width: heroCoin.images.width,
      height: heroCoin.images.height,
    }
  : null;

const jsonLd = collectionPageJsonLd({
  locale,
  pathname,
  name: t.title,
  description: t.metaDescription,
  crumbs: [
    { name: copy[locale].home, path: '/' },
    { name: t.parentLink, path: NUMISMATICS_PATH },
    { name: t.kicker, path: pathname },
  ],
});
---

<Layout title={t.metaTitle} description={t.metaDescription} locale={locale} pathname={pathname}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    {
      hero ? (
        <SeriesHero
          src={hero.src}
          alt={t.heroAlt}
          width={hero.width}
          height={hero.height}
          headingId="series-heading"
          eyebrow={copy[locale].virtualCollection}
          title={t.kicker}
          subtitle={t.title}
          size="frame"
        />
      ) : null
    }

    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { href: localizePath(NUMISMATICS_PATH, locale), label: t.parentLink },
          { label: t.kicker },
        ]}
      />

      {
        hero ? null : (
          <header class="mb-8">
            <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
              {copy[locale].virtualCollection}
            </p>
            <h1 id="series-heading" class="mb-2 mt-3 font-display text-[clamp(1.85rem,4vw,2.85rem)] font-normal leading-[1.15] text-cream-dim">
              {t.kicker}
            </h1>
            <p class="m-0 font-display text-[1.35rem]/8 text-cream">{t.title}</p>
          </header>
        )
      }

      <div class="w-full text-[17px]/7 text-cream">
        {t.intro.map((paragraph) => <p class="mb-5 mt-0 last:mb-0">{paragraph}</p>)}
      </div>

      <section class="mt-16" aria-labelledby="pieces-heading">
        <h2 id="pieces-heading" class="mb-3 mt-0 font-display text-[2rem]/10 font-normal text-cream-dim">
          {pieces.holdingsTitle}
        </h2>
        <p class="mb-8 mt-0 w-full text-[17px]/7 text-muted">{pieces.holdingsIntro}</p>

        <ol
          class:list={['m-0', CATALOG_PIECE_GRID]}
          aria-label={copy[locale].coinsInCollection}
        >
          {
            liberiaCoins.map((coin) => (
              <li class="min-w-0">
                <a
                  href={coinPath(coin, locale)}
                  class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
                >
                  {coin.images ? (
                    <CatalogThumb
                      src={coin.images.composite}
                      alt={coin.frontCaption[locale]}
                      width={coin.images.width}
                      height={coin.images.height}
                      class="mb-3 aspect-[3/2] w-full rounded-[2px] bg-bg object-contain sm:mb-4"
                    />
                  ) : (
                    <div class="mb-3 aspect-[3/2] w-full rounded-[2px] bg-bg sm:mb-4" aria-hidden="true" />
                  )}
                  <h3 class="mb-2 mt-0 font-display text-[clamp(0.95rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
                    {coin.title[locale]}
                  </h3>
                  <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
                    {coin.year} · {coin.grade[locale]}
                  </p>
                  <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{pieces.viewCoin} →</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="mt-16 space-y-12">
        {
          liberiaCoinageChapters.map((chapter) => (
            <section id={chapter.id} class="scroll-mt-28" aria-labelledby={`${chapter.id}-heading`}>
              <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
                {chapter.years[locale]}
              </p>
              <h2
                id={`${chapter.id}-heading`}
                class="mb-3 mt-2 font-display text-[1.75rem]/9 font-normal text-cream-dim"
              >
                {chapter.title[locale]}
              </h2>
              <p class="mb-4 mt-0 text-[17px]/7 text-muted">{chapter.lead[locale]}</p>
              <p class="m-0 text-[17px]/7 text-cream">{chapter.body[locale]}</p>
            </section>
          ))
        }
      </div>

      <div class="mt-16">
        <SourceList locale={locale} sources={seriesSources} heading={t.sourcesTitle} />
      </div>

      <p class="mt-12">
        <a
          href={localizePath(NUMISMATICS_PATH, locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          {copy[locale].backNumismaticsShort}
        </a>
      </p>
    </article>
  </main>
</Layout>
