---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import SeriesHero from './SeriesHero.astro';
import CatalogThumb from './CatalogThumb.astro';
import FaqBlock from '../FaqBlock.astro';
import { collectionPageJsonLd } from '../../lib/json-ld';
import { copy, localizePath, type Locale } from '../../lib/site';
import { localizeFaq, seriesFaqs } from '../../data/page-faq';
import {
  colombiaChapters,
  seriesCopy,
  seriesPath,
  seriesSources,
} from '../../data/colombia';
import { COLOMBIA_COINAGE_PATH } from '../../data/colombia-coinage';
import { errorNoteCards, hasErrorNotes } from '../../data/colombia-errors';
import { notePath, notesForChapter, seriesCardHref, seriesCardsForChapter } from '../../data/colombia-notes';
import { catalogAssetSrc } from '../../lib/images';
import SourceList from './SourceList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = seriesCopy[locale];
const pathname = seriesPath(locale);
const errorNotes = errorNoteCards();
const hero = {
  src: '/images/catalog/colombia/hero-colombia.jpg',
  width: 2128,
  height: 912,
};

const faqItems = localizeFaq(seriesFaqs.colombia, locale);
const jsonLd = collectionPageJsonLd({
  locale,
  pathname,
  name: t.title,
  description: t.metaDescription,
  crumbs: [
    { name: copy[locale].home, path: '/' },
    { name: t.title, path: pathname },
  ],
  faq: faqItems,
});

---

<Layout
      title={t.metaTitle}
      description={t.metaDescription}
      locale={locale}
      pathname={pathname}
      ogImage={catalogAssetSrc(hero.src)}
      ogImageAlt={t.heroAlt}
    >
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    <SeriesHero
      src={hero.src}
      alt={t.heroAlt}
      width={hero.width}
      height={hero.height}
      headingId="series-heading"
          eyebrow={copy[locale].virtualCollection}
          title={t.title}
          subtitle={t.eraSubtitle}
      imageClass="object-[50%_28%]"
    />

    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { label: t.kicker },
        ]}
      />

      <div class="w-full text-[17px]/7 text-cream">
        {t.intro.map((paragraph) => <p class="mb-5 mt-0 last:mb-0">{paragraph}</p>)}
      </div>

      <p class="mt-6 mb-0 text-[17px]/7 text-muted">
        {t.coinageLead}
        {' '}
        <a
          class="text-gold-light underline decoration-line-strong hover:text-cream"
          href={localizePath(COLOMBIA_COINAGE_PATH, locale)}
        >
          {t.coinageLink}
        </a>
      </p>

      <div class="mt-16 space-y-12">
        {
          colombiaChapters.map((chapter) => (
            <section id={chapter.id} class="scroll-mt-28" aria-labelledby={`${chapter.id}-heading`}>
              <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
                {chapter.years[locale]}
              </p>
              <h2
                id={`${chapter.id}-heading`}
                class="mb-3 mt-2 font-display text-[1.75rem]/9 font-normal text-cream-dim"
              >
                {chapter.title[locale]}
              </h2>
              <p class="mb-4 mt-0 text-[17px]/7 text-muted">{chapter.lead[locale]}</p>
              <p class="m-0 text-[17px]/7 text-cream">{chapter.body[locale]}</p>
              {
                notesForChapter(chapter.id).length > 0 ? (
                  <ol
                    class="mb-0 mt-8 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3"
                    aria-label={chapter.title[locale]}
                  >
                    {seriesCardsForChapter(chapter.id).map(({ note, piece }) => {
                      return (
                      <li class="min-w-0">
                        <a
                          href={seriesCardHref(note, piece, locale)}
                          class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
                        >
                          <CatalogThumb
                    src={piece.images.front}
                    alt={piece.frontCaption[locale]}
                    width={1440}
                    height={960}
                    class="mb-3 aspect-[3/2] w-full rounded-[2px] bg-bg object-contain sm:mb-4"
                  />
                          <h3 class="mb-2 mt-0 font-display text-[clamp(0.85rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
                            {piece.title[locale]}
                          </h3>
                          <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
                            {t.pickLabel} {piece.pick} · {t.serialLabel} {piece.serial}
                          </p>
                          <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{t.viewNote} →</span>
                        </a>
                      </li>
                      );
                    })}
                  </ol>
                ) : null
              }
            </section>
          ))
        }
      </div>

      <section id="errores" class="mt-16 scroll-mt-28" aria-labelledby="errores-heading">
        <h2
          id="errores-heading"
          class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim"
        >
          {t.errorsTitle}
        </h2>
        <p class="mb-8 mt-0 w-full text-[17px]/7 text-muted">{t.errorsIntro}</p>
        {
          hasErrorNotes() ? (
            <ol
              class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3"
              aria-label={t.errorsTitle}
            >
              {errorNotes.map(({ note, piece }) => {
                const multi = (note.pieces?.length ?? 1) > 1;
                return (
                  <li class="min-w-0">
                    <a
                      href={multi ? `${notePath(note, locale)}#${piece.id}` : notePath(note, locale)}
                      class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
                    >
                      <CatalogThumb
                        src={piece.images.front}
                        alt={piece.frontCaption[locale]}
                        width={1440}
                        height={960}
                        class="mb-3 aspect-[3/2] w-full rounded-[2px] bg-bg object-contain sm:mb-4"
                      />
                      <h3 class="mb-2 mt-0 font-display text-[clamp(0.85rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
                        {piece.title[locale]}
                      </h3>
                      <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
                        {t.pickLabel} {piece.pick} · {t.serialLabel} {piece.serial}
                      </p>
                      <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{t.viewNote} →</span>
                    </a>
                  </li>
                );
              })}
            </ol>
          ) : (
            <p class="m-0 text-[17px]/7 text-muted">{t.errorsEmpty}</p>
          )
        }
        <section
          id="tiquete-de-subsidio"
          class="mt-12 scroll-mt-28"
          aria-labelledby="tiquete-de-subsidio-heading"
        >
          <h3
            id="tiquete-de-subsidio-heading"
            class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim"
          >
            {t.errorsTiqueteHeading}
          </h3>
          <p class="mb-0 mt-0 text-[17px]/7 text-muted">
            {t.errorsTiqueteLead}
            {' '}
            <a
              class="text-gold-light underline decoration-line-strong hover:text-cream"
              href="#tiquetes"
            >
              {t.errorsTiqueteLink}
            </a>
          </p>
        </section>
      </section>

      <section id="catalogacion" class="mt-16 scroll-mt-28" aria-labelledby="catalogacion-heading">
        <h2
          id="catalogacion-heading"
          class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim"
        >
          {t.methodTitle}
        </h2>
        <p class="mb-10 mt-0 text-[17px]/7 text-muted">{t.methodLead}</p>

        <section id="pies-de-imprenta" class="scroll-mt-28" aria-labelledby="pies-de-imprenta-heading">
          <h3
            id="pies-de-imprenta-heading"
            class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim"
          >
            {t.imprintsTitle}
          </h3>
          <p class="mb-4 mt-0 text-[17px]/7 text-cream">{t.imprintsLead}</p>
          <ul class="mb-4 mt-0 list-none space-y-3 p-0">
            {
              t.imprintItems.map((item) => (
                <li class="text-[17px]/7 text-cream">
                  <strong class="font-semibold text-cream-dim">{item.name}.</strong> {item.body}
                </li>
              ))
            }
          </ul>
          <p class="mb-0 mt-0 text-[17px]/7 text-muted">
            {t.imprintsEssayLead}
            {' '}
            <a
              class="text-gold-light underline decoration-line-strong hover:text-cream"
              href={localizePath(t.imprintsEssayHref, locale)}
            >
              {t.imprintsEssayLink}
            </a>
            .
          </p>
        </section>

        <section id="impresores" class="mt-12 scroll-mt-28" aria-labelledby="impresores-heading">
          <h3
            id="impresores-heading"
            class="mb-4 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim"
          >
            {t.printersTitle}
          </h3>
          <div class="overflow-x-auto border border-line-strong">
            <table class="w-full min-w-[36rem] border-collapse font-sans text-[15px] text-cream-dim">
              <caption class="caption-bottom px-3 py-2.5 text-left text-[14px] text-muted">
                {t.printersCaption}
              </caption>
              <thead>
                <tr class="border-b border-line-strong bg-panel text-left">
                  {
                    t.printersHeaders.map((header) => (
                      <th class="px-3 py-2.5 font-semibold text-cream" scope="col">
                        {header}
                      </th>
                    ))
                  }
                </tr>
              </thead>
              <tbody>
                {
                  t.printersRows.map((row) => (
                    <tr class="border-b border-line-strong last:border-b-0">
                      {row.map((cell, index) =>
                        index === 0 ? (
                          <th class="px-3 py-2.5 text-left font-semibold text-cream" scope="row">
                            {cell}
                          </th>
                        ) : (
                          <td class="px-3 py-2.5">{cell}</td>
                        ),
                      )}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section id="reposicion" class="mt-12 scroll-mt-28" aria-labelledby="reposicion-heading">
          <h3
            id="reposicion-heading"
            class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim"
          >
            {t.replacementsTitle}
          </h3>
          {t.replacementsParagraphs.map((paragraph) => (
            <p class="mb-4 mt-0 text-[17px]/7 text-cream last:mb-4">{paragraph}</p>
          ))}
          <p class="mb-0 mt-0 text-[17px]/7 text-muted">
            {t.replacementsGlossaryLead}
            {' '}
            <a
              class="text-gold-light underline decoration-line-strong hover:text-cream"
              href={localizePath(t.replacementsGlossaryHref, locale)}
            >
              {t.replacementsGlossaryLink}
            </a>
            .
          </p>
        </section>

        <section id="certificacion" class="mt-12 scroll-mt-28" aria-labelledby="certificacion-heading">
          <h3
            id="certificacion-heading"
            class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim"
          >
            {t.gradingTitle}
          </h3>
          {t.gradingParagraphs.map((paragraph) => (
            <p class="mb-4 mt-0 text-[17px]/7 text-cream last:mb-4">{paragraph}</p>
          ))}
          <p class="mb-0 mt-0 text-[17px]/7 text-muted">
            {t.gradingEssayLead}
            {' '}
            <a
              class="text-gold-light underline decoration-line-strong hover:text-cream"
              href={localizePath(t.gradingEssayHref, locale)}
            >
              {t.gradingEssayLink}
            </a>
            .
          </p>
        </section>

        <section id="estandares" class="mt-12 scroll-mt-28" aria-labelledby="estandares-heading">
          <h3
            id="estandares-heading"
            class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim"
          >
            {t.standardsTitle}
          </h3>
          <p class="mb-4 mt-0 text-[17px]/7 text-cream">{t.standardsLead}</p>
          <ul class="mb-4 mt-0 list-none space-y-3 p-0">
            {
              t.standardsItems.map((item) => (
                <li class="text-[17px]/7 text-cream">
                  <strong class="font-semibold text-cream-dim">{item.name}.</strong> {item.body}
                </li>
              ))
            }
          </ul>
          <p class="mb-6 mt-0 text-[17px]/7 text-muted">
            {t.standardsCompareLead}
            {' '}
            <a
              class="text-gold-light underline decoration-line-strong hover:text-cream"
              href={localizePath(t.standardsCompareHref, locale)}
            >
              {t.standardsCompareLink}
            </a>
            .
          </p>
          <p class="mb-0 mt-0 text-[17px]/7 text-muted">{t.disclaimer}</p>
        </section>
      </section>

      <FaqBlock heading={copy[locale].faqHeading} items={faqItems} />

      <div class="mt-16">
        <SourceList locale={locale} sources={seriesSources} heading={t.sourcesTitle} />
      </div>

      <p class="mt-12">
        <a
          href={localizePath('/', locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          {copy[locale].backHome}
        </a>
      </p>
    </article>
  </main>
</Layout>
