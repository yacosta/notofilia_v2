---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import SeriesHero from './SeriesHero.astro';
import CatalogThumb from './CatalogThumb.astro';
import { collectionPageJsonLd } from '../../lib/json-ld';
import { copy, localizePath, type Locale } from '../../lib/site';
import {
  colombiaCatalogItems,
  colombiaChapters,
  seriesCopy,
  seriesPath,
  seriesSources,
} from '../../data/colombia';
import { COLOMBIA_COINAGE_PATH } from '../../data/colombia-coinage';
import { notePath, notesForChapter, seriesCardsForChapter } from '../../data/colombia-notes';
import SourceList from './SourceList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = seriesCopy[locale];
const pathname = seriesPath(locale);
const catalogItems = colombiaCatalogItems();
const hero = {
  src: '/images/catalog/colombia/hero-colombia.jpg',
  width: 2128,
  height: 912,
};

const jsonLd = collectionPageJsonLd({
  locale,
  pathname,
  name: t.title,
  description: t.metaDescription,
  crumbs: [
    { name: copy[locale].home, path: '/' },
    { name: t.title, path: pathname },
  ],
});

---

<Layout
      title={t.metaTitle}
      description={t.metaDescription}
      locale={locale}
      pathname={pathname}
      ogImage={hero.src}
      ogImageAlt={t.heroAlt}
    >
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    <SeriesHero
      src={hero.src}
      alt={t.heroAlt}
      width={hero.width}
      height={hero.height}
      headingId="series-heading"
      eyebrow={copy[locale].virtualCollection}
      title={t.kicker}
      subtitle={t.title}
      imageClass="object-[50%_28%]"
    />

    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { label: t.kicker },
        ]}
      />

      <div class="w-full text-[17px]/7 text-cream">
        {t.intro.map((paragraph) => <p class="mb-5 mt-0 last:mb-0">{paragraph}</p>)}
      </div>

      <p class="mt-6 mb-0 text-[17px]/7 text-muted">
        {t.coinageLead}
        {' '}
        <a
          class="text-gold-light underline decoration-line-strong hover:text-cream"
          href={localizePath(COLOMBIA_COINAGE_PATH, locale)}
        >
          {t.coinageLink}
        </a>
      </p>

      <section class="mt-16" aria-labelledby="holdings-heading">
        <h2 id="holdings-heading" class="mb-3 mt-0 font-display text-[2rem]/10 font-normal text-cream-dim">
          {t.holdingsTitle}
        </h2>
        <p class="mb-8 mt-0 w-full text-[17px]/7 text-muted">{t.holdingsIntro}</p>

        <ol
          class="m-0 grid list-none grid-cols-2 gap-2 p-0 sm:grid-cols-4 sm:gap-4"
          aria-label={copy[locale].catalogByPeriod}
        >
          {
            catalogItems.map((item) => (
              <li class="min-w-0">
                <a
                  href={item.href}
                  class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
                >
                  <div class="mb-3 flex aspect-[3/1] w-full items-center justify-center rounded-[2px] bg-bg sm:mb-4">
                    <span class="px-1 text-center font-display text-[clamp(0.7rem,1.6vw,1.15rem)] leading-tight text-gold-light">
                      {item.years[locale]}
                    </span>
                  </div>
                  <h3 class="mb-2 mt-0 font-display text-[clamp(0.85rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
                    {item.title[locale]}
                  </h3>
                  <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
                    {t.eraLabel} · {item.years[locale]}
                  </p>
                  <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">
                    {t.viewChapter} →
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="mt-16 space-y-12">
        {
          colombiaChapters.map((chapter) => (
            <section id={chapter.id} class="scroll-mt-28" aria-labelledby={`${chapter.id}-heading`}>
              <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
                {chapter.years[locale]}
              </p>
              <h2
                id={`${chapter.id}-heading`}
                class="mb-3 mt-2 font-display text-[1.75rem]/9 font-normal text-cream-dim"
              >
                {chapter.title[locale]}
              </h2>
              <p class="mb-4 mt-0 text-[17px]/7 text-muted">{chapter.lead[locale]}</p>
              <p class="m-0 text-[17px]/7 text-cream">{chapter.body[locale]}</p>
              {
                notesForChapter(chapter.id).length > 0 ? (
                  <ol
                    class:list={[
                      'mb-0 mt-8 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2',
                      chapter.id === 'banco-de-la-republica' && 'lg:grid-cols-4',
                    ]}
                    aria-label={chapter.title[locale]}
                  >
                    {seriesCardsForChapter(chapter.id).map(({ note, piece }) => {
                      const multi = (note.pieces?.length ?? 1) > 1;
                      return (
                      <li class="min-w-0">
                        <a
                          href={multi ? `${notePath(note, locale)}#${piece.id}` : notePath(note, locale)}
                          class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
                        >
                          <CatalogThumb
                    src={piece.images.front}
                    alt={piece.frontCaption[locale]}
                    width={1440}
                    height={960}
                    class="mb-3 aspect-[3/2] w-full rounded-[2px] bg-bg object-contain sm:mb-4"
                  />
                          <h3 class="mb-2 mt-0 font-display text-[clamp(0.85rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
                            {piece.title[locale]}
                          </h3>
                          <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
                            {t.pickLabel} {piece.pick} · {t.serialLabel} {piece.serial}
                          </p>
                          <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{t.viewNote} →</span>
                        </a>
                      </li>
                      );
                    })}
                  </ol>
                ) : null
              }
            </section>
          ))
        }
      </div>

      <div class="mt-16">
        <SourceList locale={locale} sources={seriesSources} heading={t.sourcesTitle} />
      </div>

      <p class="mt-12">
        <a
          href={localizePath('/', locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          {copy[locale].backHome}
        </a>
      </p>
    </article>
  </main>
</Layout>
