---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import CatalogThumb from './CatalogThumb.astro';
import SourceList from './SourceList.astro';
import { collectionPageJsonLd } from '../../lib/json-ld';
import { CATALOG_PIECE_GRID } from '../../lib/catalog-grid';
import { copy, localizePath, type Locale } from '../../lib/site';
import {
  vegaRedondaChapters,
  vegaRedondaCoinageHref,
  vegaRedondaCopy,
  vegaRedondaNotesHref,
  vegaRedondaNumismaticsHref,
  vegaRedondaPath,
  vegaRedondaSources,
  vegaRedondaTokenPath,
  vegaRedondaTokens,
} from '../../data/vega-redonda';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = vegaRedondaCopy[locale];
const pathname = vegaRedondaPath(locale);
const jsonLd = collectionPageJsonLd({
  locale,
  pathname,
  name: t.title,
  description: t.metaDescription,
  crumbs: [
    { name: copy[locale].home, path: '/' },
    { name: t.numismatica, path: '/coleccion/numismatica/' },
    { name: t.series, path: '/coleccion/puerto-rico-numismatica/' },
    { name: t.nav, path: '/coleccion/puerto-rico-numismatica/hacienda-vega-redonda/' },
  ],
  items: vegaRedondaTokens.map((token) => ({
    name: token.title[locale],
    url: vegaRedondaTokenPath(token, locale),
  })),
});
---

<Layout title={`${t.metaTitle} · Notofilia`} description={t.metaDescription} locale={locale} pathname={pathname}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main id="main-content" tabindex="-1" class="bg-bg outline-none">
    <article class="mx-auto max-w-content px-[var(--page-gutter)] pb-16 pt-14 md:pb-24 md:pt-16">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { href: vegaRedondaNumismaticsHref(locale), label: t.numismatica },
          { href: vegaRedondaCoinageHref(locale), label: t.series },
          { label: t.nav },
        ]}
      />

      <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">{t.kicker}</p>
      <h1 class="mb-0 mt-3 font-display text-[clamp(1.75rem,4.2vw,2.85rem)] font-normal leading-[1.12] text-cream-dim">
        {t.title}
      </h1>
      <p class="direct-answer mb-10 mt-6 max-w-[46rem] text-[17px]/7 text-muted">{t.lead}</p>

      <section class="mb-14 rounded-[6px] border border-line-strong bg-panel p-6" aria-labelledby="series-facts-heading">
        <h2 id="series-facts-heading" class="mb-4 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">
          {t.factsHeading}
        </h2>
        <dl class="m-0 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.placeLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.place}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.issuerLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.issuer}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.unitLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.unit}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.metalLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.metal}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.dateLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.date}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.heldLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{t.held}</dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="holdings-heading">
        <h2 id="holdings-heading" class="mb-3 mt-0 font-display text-[2rem]/10 font-normal text-cream-dim">
          {t.holdingsTitle}
        </h2>
        <p class="mb-8 mt-0 text-[17px]/7 text-muted">{t.holdingsIntro}</p>
        <ol class:list={['m-0', CATALOG_PIECE_GRID]} aria-label={t.holdingsAria}>
          {
            vegaRedondaTokens.map((token) => (
              <li class="min-w-0">
                <a
                  href={vegaRedondaTokenPath(token, locale)}
                  class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
                >
                  <CatalogThumb
                    src={token.images.front}
                    alt={token.caption[locale]}
                    width={token.images.width}
                    height={token.images.height}
                    class="mb-3 aspect-square w-full rounded-[2px] bg-bg object-contain sm:mb-4"
                  />
                  <h3 class="mb-2 mt-0 font-display text-[clamp(0.95rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
                    {token.title[locale]}
                  </h3>
                  <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">{token.altCatalog}</p>
                  <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{t.viewToken}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="mt-16 space-y-12">
        {
          vegaRedondaChapters.map((chapter) => (
            <section id={chapter.id} class="scroll-mt-28" aria-labelledby={`${chapter.id}-heading`}>
              <h2
                id={`${chapter.id}-heading`}
                class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim"
              >
                {chapter.title[locale]}
              </h2>
              <p class="mb-4 mt-0 text-[17px]/7 text-muted">{chapter.lead[locale]}</p>
              <p class="m-0 text-[17px]/7 text-cream">{chapter.body[locale]}</p>
            </section>
          ))
        }
      </div>

      <section class="mt-16" aria-labelledby="values-heading">
        <h2 id="values-heading" class="mb-4 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.tableHeading}
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[36rem] border-collapse text-left text-[15px]/6 text-cream">
            <caption class="mb-3 text-left font-sans text-[14px]/6 text-muted">{t.tableCaption}</caption>
            <thead>
              <tr class="border-b border-line-strong">
                <th scope="col" class="py-2 pr-4 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.colValue}</th>
                <th scope="col" class="py-2 pr-4 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.colRulau}</th>
                <th scope="col" class="py-2 pr-4 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.colNumista}</th>
                <th scope="col" class="py-2 pr-4 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.colType}</th>
                <th scope="col" class="py-2 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.colCase}</th>
              </tr>
            </thead>
            <tbody>
              {
                t.rows.map((row) => (
                  <tr class="border-b border-line">
                    <th scope="row" class="py-3 pr-4 font-normal text-cream">
                      {'href' in row ? (
                        <a class="text-gold-light underline decoration-line-strong hover:text-cream" href={localizePath(row.href, locale)}>
                          {row.value}
                        </a>
                      ) : (
                        row.value
                      )}
                    </th>
                    <td class="py-3 pr-4">{row.rulau}</td>
                    <td class="py-3 pr-4">{row.numista}</td>
                    <td class="py-3 pr-4">{row.type}</td>
                    <td class="py-3">{row.held ? t.inCase : t.notInCase}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <div class="mt-16">
        <SourceList locale={locale} sources={vegaRedondaSources} heading={t.sourcesTitle} />
      </div>

      <p class="mb-0 mt-10 text-[17px]/7 text-muted">
        {t.coinageLead}{' '}
        <a class="text-gold-light underline decoration-line-strong hover:text-cream" href={vegaRedondaCoinageHref(locale)}>
          {t.coinageLink}
        </a>
      </p>
      <p class="mb-0 mt-4 text-[17px]/7 text-muted">
        {t.notesLead}{' '}
        <a class="text-gold-light underline decoration-line-strong hover:text-cream" href={vegaRedondaNotesHref(locale)}>
          {t.notesLink}
        </a>
      </p>
      <p class="mt-10">
        <a
          href={vegaRedondaNumismaticsHref(locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          {t.backNumismatics}
        </a>
      </p>
    </article>
  </main>
</Layout>
