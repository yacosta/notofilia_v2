---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import SeriesHero from './SeriesHero.astro';
import SourceList from './SourceList.astro';
import { enhanceProseHtml } from '../../data/editorial';
import { COLOMBIA_COINAGE_PATH } from '../../data/colombia-coinage';
import { HACIENDA_TOKENS_HERO, haciendaTokensCopy, haciendaTokensPath } from '../../data/hacienda-tokens';
import {
  manzanoFarmingPath,
  manzanoTokenById,
  manzanoTokenLabels,
  manzanoTokenPath,
} from '../../data/manzano-farming';
import { NUMISMATICA_PATH } from '../../data/numismatica';
import { imageObjectJsonLd } from '../../lib/json-ld';
import { PERSON_ID, SITE_AUTHOR, SITE_NAME, breadcrumbJsonLd } from '../../lib/seo';
import { copy, localizePath, SITE_URL, type Locale } from '../../lib/site';

interface Props {
  locale: Locale;
  id: string;
}

const { locale, id } = Astro.props;
const token = manzanoTokenById(id);
if (!token) throw new Error(`Missing Manzano token ficha: ${id}`);

const t = manzanoTokenLabels[locale];
const pathname = manzanoTokenPath(token, locale);
const pageUrl = new URL(pathname, SITE_URL).href;
const numismaticaHref = localizePath(NUMISMATICA_PATH, locale);
const seriesHref = localizePath(COLOMBIA_COINAGE_PATH, locale);
const fichasHref = haciendaTokensPath(locale);
const firmHref = manzanoFarmingPath(locale);
const about = enhanceProseHtml(token.about[locale], locale);
const hero = HACIENDA_TOKENS_HERO[locale];
const heroAlt = haciendaTokensCopy[locale].heroAlt;
const imageUrl = new URL(hero.src, SITE_URL).href;
const citations = token.sources.map((source) => ({
  '@type': 'CreativeWork',
  name: source[locale],
  url: source.href,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: token.title[locale],
      description: token.metaDescription[locale],
      datePublished: token.published,
      dateModified: token.published,
      inLanguage: locale,
      image: imageObjectJsonLd({ image: imageUrl, locale, caption: heroAlt }),
      url: pageUrl,
      mainEntityOfPage: pageUrl,
      author: { '@type': 'Person', name: SITE_AUTHOR, '@id': PERSON_ID },
      reviewedBy: { '@type': 'Person', name: SITE_AUTHOR, '@id': PERSON_ID },
      publisher: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
      citation: citations,
      about: [
        { '@type': 'Organization', name: 'Manzano Farming Co.' },
        { '@type': 'Thing', name: token.title[locale] },
      ],
    },
    breadcrumbJsonLd([
      { name: t.home, item: localizePath('/', locale) },
      { name: t.numismatica, item: numismaticaHref },
      { name: t.series, item: seriesHref },
      { name: t.fichas, item: fichasHref },
      { name: t.firm, item: firmHref },
      { name: token.nav[locale], item: pathname },
    ]),
  ],
};
---

<Layout
  title={`${token.metaTitle[locale]} · Notofilia`}
  description={token.metaDescription[locale]}
  locale={locale}
  pathname={pathname}
  ogImage={hero.src}
  ogImageAlt={heroAlt}
  ogType="article"
  publishedTime={token.published}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    <SeriesHero
      src={hero.src}
      alt={heroAlt}
      width={hero.width}
      height={hero.height}
      headingId="manzano-token-heading"
      eyebrow={copy[locale].virtualCollection}
      title={token.title[locale]}
      size="frame"
    />

    <article class="mx-auto max-w-content px-[var(--page-gutter)] pb-16 pt-14 md:pb-24 md:pt-16">
      <Breadcrumb
        locale={locale}
        label={t.breadcrumb}
        items={[
          { href: localizePath('/', locale), label: t.home },
          { href: numismaticaHref, label: t.numismatica },
          { href: seriesHref, label: t.series },
          { href: fichasHref, label: t.fichas },
          { href: firmHref, label: t.firm },
          { label: token.nav[locale] },
        ]}
      />

      <p class="mb-5 mt-0 max-w-[46rem] text-[clamp(19px,2.4vw,23px)] italic leading-[1.5] text-cream-dim">{token.lead[locale]}</p>
      <p class="mb-10 mt-0 font-sans text-[14px] text-muted">
        <time datetime={token.published}>{token.dateLabel[locale]}</time>
        <span> · </span>
        <span>{token.authorLabel}</span>
      </p>

      <section class="mb-14 rounded-[6px] border border-line-strong bg-panel p-6" aria-labelledby="facts-heading">
        <h2 id="facts-heading" class="mb-4 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">
          {t.factsHeading}
        </h2>
        <dl class="m-0 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          {
            token.facts.map((fact) => (
              <div class="sm:col-span-2">
                <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{fact.label[locale]}</dt>
                <dd class="m-0 mt-1 text-cream">{fact.value[locale]}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <div class="grid gap-10 lg:grid-cols-2">
        <section aria-labelledby="front-heading">
          <h2 id="front-heading" class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">{t.frontHeading}</h2>
          <p class="m-0 text-[17px]/7 text-cream">{token.front[locale]}</p>
        </section>
        <section aria-labelledby="back-heading">
          <h2 id="back-heading" class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">{t.backHeading}</h2>
          <p class="m-0 text-[17px]/7 text-cream">{token.back[locale]}</p>
        </section>
      </div>

      <section class="mt-14" aria-labelledby="about-heading">
        <h2 id="about-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.aboutHeading}
        </h2>
        <div class="prose-notofilia" lang={locale} set:html={about} />
      </section>

      <SourceList locale={locale} sources={token.sources} heading={t.sourcesTitle} />

      <p class="mt-12 flex flex-col gap-3 font-sans text-[15px]">
        <a href={firmHref} class="inline-flex min-h-11 items-center text-gold-light hover:text-cream">
          {t.firmCta}
        </a>
        <a href={fichasHref} class="inline-flex min-h-11 items-center text-gold-light hover:text-cream">
          {t.fichasCta}
        </a>
      </p>
    </article>
  </main>
</Layout>
