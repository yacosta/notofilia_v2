---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import SeriesHero from './SeriesHero.astro';
import { copy, localizePath, type Locale } from '../../lib/site';
import { visualArtworkJsonLd } from '../../lib/json-ld';
import { catalogScanAlt } from '../../lib/catalog-alt';
import { seriesPath, seriesSources } from '../../data/colombia';
import {
  notePageCopy,
  notePath,
  noteSeriesLabel,
  type ColombiaNote,
} from '../../data/colombia-notes';
import SourceList from './SourceList.astro';
import NoteImageLightbox from './NoteImageLightbox.astro';

interface Props {
  locale: Locale;
  note: ColombiaNote;
}

const { locale, note } = Astro.props;
const t = notePageCopy[locale];
const pathname = notePath(note, locale);
const sources = [...note.sources, ...seriesSources.filter((source) => !note.sources.some((own) => own.href === source.href))];
const hero = note.hero;
const heroAlt = note.heroAlt?.[locale];
if (hero && !heroAlt) {
  throw new Error(`Missing heroAlt for ${note.id} (${locale})`);
}
const seriesLabel = noteSeriesLabel(note, locale);
const jsonLd = visualArtworkJsonLd({
  name: note.title[locale],
  description: note.lead[locale],
  url: pathname,
  image: note.images.front,
  imageBack: note.images.back,
  locale,
  artform: 'Banknote',
});
const frontAlt = catalogScanAlt(locale, { title: note.title[locale], pick: note.pick, side: 'front' });
const backAlt = catalogScanAlt(locale, { title: note.title[locale], pick: note.pick, side: 'back' });
---

<Layout
  title={`${note.title[locale]} | Notofilia`}
  description={note.lead[locale]}
  locale={locale}
  pathname={pathname}
  ogImage={note.images.front}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...jsonLd })} />
  </Fragment>
  <main id="main-content" tabindex="-1" class:list={['bg-bg outline-none', hero && 'relative w-full']}>
    {
      hero ? (
        <SeriesHero
          src={hero.src}
          alt={heroAlt as string}
          width={hero.width}
          height={hero.height}
          headingId="note-heading"
          eyebrow={note.kicker[locale]}
          title={note.title[locale]}
        />
      ) : null
    }

    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { href: seriesPath(locale), label: seriesLabel },
          { label: note.title[locale] },
        ]}
      />

      {
        hero ? null : (
          <>
            <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
              {note.kicker[locale]}
            </p>
            <h1 class="mb-4 mt-3 font-display text-[clamp(1.85rem,4vw,2.85rem)] font-normal leading-[1.15] text-cream-dim">
              {note.title[locale]}
            </h1>
          </>
        )
      }
      <p class="mb-10 mt-0 max-w-[46rem] text-[17px]/7 text-muted">{note.lead[locale]}</p>

      <section class="mb-14 rounded-[6px] border border-line-strong bg-panel p-6" aria-labelledby="facts-heading">
        <h2 id="facts-heading" class="mb-4 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">
          {t.factsHeading}
        </h2>
        <dl class="m-0 grid gap-x-8 gap-y-4 sm:grid-cols-2">
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.pickLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{note.pick}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.serialLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{note.serial}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.signaturesLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{note.signatures[locale]}</dd>
          </div>
          <div>
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.gradeLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{note.grade[locale]}</dd>
          </div>
          <div class="sm:col-span-2">
            <dt class="m-0 font-sans text-[13px] font-semibold uppercase tracking-[0.12em] text-muted">{t.printedLabel}</dt>
            <dd class="m-0 mt-1 text-cream">{note.printed[locale]}</dd>
          </div>
        </dl>
      </section>

      <div class="grid gap-10 lg:grid-cols-2">
        <figure class="m-0">
          <h2 class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">{t.frontHeading}</h2>
          <NoteImageLightbox
            src={note.images.front}
            alt={frontAlt}
            expandLabel={t.expandImage}
            closeLabel={t.closeLightbox}
            locale={locale}
            width={1440}
            height={960}
          />
          <figcaption class="mt-3 font-sans text-[14px]/6 text-muted">{note.frontCaption[locale]}</figcaption>
        </figure>
        <figure class="m-0">
          <h2 class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">{t.backHeading}</h2>
          <NoteImageLightbox
            src={note.images.back}
            alt={backAlt}
            expandLabel={t.expandImage}
            closeLabel={t.closeLightbox}
            locale={locale}
            width={1440}
            height={960}
          />
          <figcaption class="mt-3 font-sans text-[14px]/6 text-muted">{note.backCaption[locale]}</figcaption>
        </figure>
      </div>

      <section class="mt-14" aria-labelledby="about-heading">
        <h2 id="about-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.aboutHeading}
        </h2>
        <p class="m-0 text-[17px]/7 text-cream">{note.description[locale]}</p>
      </section>

      {
        note.history ? (
          <section class="mt-12" aria-labelledby="history-heading">
            <h2 id="history-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
              {t.historyHeading}
            </h2>
            <p class="m-0 text-[17px]/7 text-cream">{note.history[locale]}</p>
          </section>
        ) : null
      }

      <section class="mt-12" aria-labelledby="scarcity-heading">
        <h2 id="scarcity-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.scarcityHeading}
        </h2>
        <p class="m-0 text-[17px]/7 text-cream">{note.scarcity[locale]}</p>
      </section>

      <section class="mt-12" aria-labelledby="population-heading">
        <h2 id="population-heading" class="mb-3 mt-0 font-display text-[1.75rem]/9 font-normal text-cream-dim">
          {t.populationHeading}
        </h2>
        <p class="m-0 text-[17px]/7 text-cream">{note.population[locale]}</p>
      </section>

      <div class="mt-16">
        <SourceList locale={locale} sources={sources} heading={t.sourcesHeading} />
      </div>

      <p class="mt-12">
        <a
          href={`${seriesPath(locale)}#${note.chapterId}`}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          ← {seriesLabel}
        </a>
      </p>
    </article>
  </main>
</Layout>
