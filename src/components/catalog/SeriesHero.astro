---
import { catalogAssetSrc, cfImage, editorialUploadSrcset, heroSrcset } from '../../lib/images';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  headingId: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  imageClass?: string;
  /** `fit` keeps a small illustration at native width instead of stretching it across 86vh. */
  frame?: 'cover' | 'fit';
}

const {
  src,
  alt,
  width,
  height,
  headingId,
  eyebrow,
  title,
  subtitle,
  imageClass = 'object-[50%_8%]',
  frame = 'cover',
} = Astro.props;

const isUpload = src.includes('/uploads/');
const isFit = frame === 'fit';
const heroSrc = isUpload ? src : catalogAssetSrc(src);
const imgSrc = isUpload ? src : cfImage(heroSrc, { width: 1600 });
const imgSrcset = isFit ? `${src} ${width}w` : isUpload ? editorialUploadSrcset(src, width) : heroSrcset(heroSrc);
const imgSizes = isFit ? `${width}px` : '100vw';
---

<section
  class:list={[
    'relative w-full bg-[#0a0a09]',
    isFit ? 'px-[var(--page-gutter)] py-5 md:py-8' : 'min-h-[86vh] md:min-h-[94vh]',
  ]}
  aria-labelledby={headingId}
>
  <div class:list={[isFit ? 'relative mx-auto w-full' : 'contents']} style={isFit ? `max-width: ${width}px` : undefined}>
  <img
    class:list={[
      isFit
        ? 'relative block h-auto w-full'
        : 'absolute inset-0 h-full w-full object-cover [filter:contrast(1.06)_brightness(0.96)_saturate(1.04)]',
      isFit ? undefined : imageClass,
    ]}
    src={imgSrc}
    srcset={imgSrcset}
    sizes={imgSizes}
    alt={alt}
    width={width}
    height={height}
    fetchpriority="high"
    decoding="async"
  />
  {
    isFit ? null : (
      <>
        <div
          class="absolute inset-0"
          style="background:radial-gradient(ellipse 92% 58% at 50% 92%, rgba(10,10,9,0.78) 0%, rgba(10,10,9,0.28) 42%, rgba(10,10,9,0.04) 72%, rgba(10,10,9,0) 100%);"
        />
        <div
          class="absolute inset-0"
          style="background:linear-gradient(180deg, rgba(6,6,5,0) 0%, rgba(6,6,5,0) 36%, rgba(6,6,5,0.16) 58%, rgba(6,6,5,0.68) 80%, rgba(6,6,5,0.92) 100%);"
        />
      </>
    )
  }
  <div
    class:list={[
      'relative z-[1] mx-auto flex flex-col justify-end',
      isFit
        ? 'max-w-none px-0 pb-0 pt-6 md:pt-8'
        : 'min-h-[86vh] max-w-content px-[var(--page-gutter)] pb-12 pt-[min(68vh,38rem)] md:min-h-[94vh] md:pb-16',
    ]}
  >
    <p
      class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light [text-shadow:0_2px_16px_rgba(0,0,0,0.65)]"
    >
      {eyebrow}
    </p>
    <h1
      id={headingId}
      class="mb-0 mt-3 font-display text-[clamp(1.85rem,4vw,2.85rem)] font-normal leading-[1.12] text-cream-dim [text-shadow:0_2px_24px_rgba(0,0,0,0.7)]"
    >
      {title}
    </h1>
    {
      subtitle ? (
        <p class="mb-0 mt-2 font-display text-[clamp(1.2rem,2.8vw,1.65rem)] leading-[1.25] text-cream [text-shadow:0_2px_18px_rgba(0,0,0,0.65)]">
          {subtitle}
        </p>
      ) : null
    }
  </div>
  </div>
</section>
