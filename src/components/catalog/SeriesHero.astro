---
import { catalogAssetSrc, cfImage, editorialUploadSrcset, heroSrcset } from '../../lib/images';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  headingId: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  imageClass?: string;
}

const {
  src,
  alt,
  width,
  height,
  headingId,
  eyebrow,
  title,
  subtitle,
  imageClass = 'object-[50%_8%]',
} = Astro.props;

const isUpload = src.includes('/uploads/');
const heroSrc = isUpload ? src : catalogAssetSrc(src);
const imgSrc = isUpload ? src : cfImage(heroSrc, { width: 1600 });
const imgSrcset = isUpload ? editorialUploadSrcset(src, width) : heroSrcset(heroSrc);
---

<section class="relative min-h-[86vh] w-full bg-[#0a0a09] md:min-h-[94vh]" aria-labelledby={headingId}>
  <img
    class:list={[
      'absolute inset-0 h-full w-full object-cover [filter:contrast(1.06)_brightness(0.96)_saturate(1.04)]',
      imageClass,
    ]}
    src={imgSrc}
    srcset={imgSrcset}
    sizes="100vw"
    alt={alt}
    width={width}
    height={height}
    fetchpriority="high"
    decoding="async"
  />
  <div
    class="absolute inset-0"
    style="background:radial-gradient(ellipse 92% 58% at 50% 92%, rgba(10,10,9,0.78) 0%, rgba(10,10,9,0.28) 42%, rgba(10,10,9,0.04) 72%, rgba(10,10,9,0) 100%);"
  >
  </div>
  <div
    class="absolute inset-0"
    style="background:linear-gradient(180deg, rgba(6,6,5,0) 0%, rgba(6,6,5,0) 36%, rgba(6,6,5,0.16) 58%, rgba(6,6,5,0.68) 80%, rgba(6,6,5,0.92) 100%);"
  >
  </div>
  <div
    class="relative z-[1] mx-auto flex min-h-[86vh] max-w-content flex-col justify-end px-[var(--page-gutter)] pb-12 pt-[min(68vh,38rem)] md:min-h-[94vh] md:pb-16"
  >
    <p
      class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light [text-shadow:0_2px_16px_rgba(0,0,0,0.65)]"
    >
      {eyebrow}
    </p>
    <h1
      id={headingId}
      class="mb-0 mt-3 font-display text-[clamp(1.85rem,4vw,2.85rem)] font-normal leading-[1.12] text-cream-dim [text-shadow:0_2px_24px_rgba(0,0,0,0.7)]"
    >
      {title}
    </h1>
    {
      subtitle ? (
        <p class="mb-0 mt-2 font-display text-[clamp(1.2rem,2.8vw,1.65rem)] leading-[1.25] text-cream [text-shadow:0_2px_18px_rgba(0,0,0,0.65)]">
          {subtitle}
        </p>
      ) : null
    }
  </div>
</section>
