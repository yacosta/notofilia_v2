---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../Breadcrumb.astro';
import SeriesHero from './SeriesHero.astro';
import CatalogThumb from './CatalogThumb.astro';
import CatalogProseParagraph from './CatalogProseParagraph.astro';
import { collectionPageJsonLd } from '../../lib/json-ld';
import { copy, localizePath, type Locale } from '../../lib/site';
import {
  notePath,
  notesForChapter,
  seriesCopy,
  seriesPath,
  seriesSources,
  unitedStatesChapters,
  USA_RENCY_PATH,
} from '../../data/estados-unidos';
import { catalogAssetSrc } from '../../lib/images';
import SourceList from './SourceList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = seriesCopy[locale];
const pathname = seriesPath(locale);
const hero =
  locale === 'en'
    ? {
        src: '/images/catalog/united-states.jpg',
        width: 2128,
        height: 912,
      }
    : {
        src: '/images/catalog/estados-unidos.jpg',
        width: 2128,
        height: 912,
      };

const jsonLd = collectionPageJsonLd({
  locale,
  pathname,
  name: t.title,
  description: t.metaDescription,
  crumbs: [
    { name: copy[locale].home, path: '/' },
    { name: t.title, path: pathname },
  ],
});

---

<Layout
  title={t.metaTitle}
  description={t.metaDescription}
  locale={locale}
  pathname={pathname}
  ogImage={catalogAssetSrc(hero.src)}
  ogImageAlt={t.heroAlt}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    <SeriesHero
      src={hero.src}
      alt={t.heroAlt}
      width={hero.width}
      height={hero.height}
      headingId="series-heading"
      eyebrow={copy[locale].virtualCollection}
      title={t.kicker}
      subtitle={t.title}
  imageClass="object-[50%_28%]"
    />

    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb
        locale={locale}
        items={[
          { href: localizePath('/', locale), label: copy[locale].home },
          { label: t.kicker },
        ]}
      />

      <div class="w-full text-[17px]/7 text-cream">
        {t.intro.map((paragraph) => <p class="mb-5 mt-0 last:mb-0">{paragraph}</p>)}
      </div>

      <div class="mt-16 space-y-12">
        {
          unitedStatesChapters.map((chapter) => (
            <section id={chapter.id} class="scroll-mt-28" aria-labelledby={`${chapter.id}-heading`}>
              <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">
                {chapter.years[locale]}
              </p>
              <h2
                id={`${chapter.id}-heading`}
                class="mb-3 mt-2 font-display text-[1.75rem]/9 font-normal text-cream-dim"
              >
                {chapter.title[locale]}
              </h2>
              <p class="mb-4 mt-0 text-[17px]/7 text-muted">{chapter.lead[locale]}</p>
              {
                chapter.bodyParts ? (
                  <CatalogProseParagraph
                    locale={locale}
                    parts={chapter.bodyParts}
                    class="m-0 text-[17px]/7 text-cream"
                  />
                ) : (
                  <p class="m-0 text-[17px]/7 text-cream">{chapter.body[locale]}</p>
                )
              }
              {
                notesForChapter(chapter.id).length > 0 ? (
                  <ol
                    class="mb-0 mt-8 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2"
                    aria-label={chapter.title[locale]}
                  >
                    {notesForChapter(chapter.id).map((note) => (
                      <li class="min-w-0">
                        <a
                          href={notePath(note, locale)}
                          class="group flex h-full min-h-11 flex-col rounded-[6px] border border-line-strong bg-panel p-2 text-inherit no-underline hover:border-gold-light sm:p-4"
                        >
                          <CatalogThumb
                    src={note.images.front}
                    alt={note.frontCaption[locale]}
                    width={note.images.width ?? 1800}
                    height={note.images.height ?? 600}
                    class="mb-3 aspect-[3/1] w-full rounded-[2px] bg-bg object-contain sm:mb-4"
                  />
                          <h3 class="mb-2 mt-0 font-display text-[clamp(0.85rem,2.2vw,1.35rem)] leading-tight font-normal text-cream-dim group-hover:text-cream">
                            {note.title[locale]}
                          </h3>
                          <p class="mb-3 mt-0 font-sans text-[12px]/5 text-muted sm:text-[14px]">
                            {t.pickLabel} {note.pick} · {t.serialLabel} {note.serial}
                          </p>
                          <span class="font-sans text-[13px] text-gold-light sm:text-[15px]">{t.viewNote} →</span>
                        </a>
                      </li>
                    ))}
                  </ol>
                ) : null
              }
              {
                chapter.id === 'us-pop-art' ? (
                  <p class={notesForChapter(chapter.id).length > 0 ? 'mt-6' : 'mt-8'}>
                    <a
                      href={localizePath(USA_RENCY_PATH, locale)}
                      class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
                    >
                      {t.viewRencyCase} →
                    </a>
                  </p>
                ) : null
              }
            </section>
          ))
        }
      </div>

      <div class="mt-16">
        <SourceList locale={locale} sources={seriesSources} heading={t.sourcesTitle} />
      </div>

      <p class="mt-12">
        <a
          href={localizePath('/', locale)}
          class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
        >
          {copy[locale].backHome}
        </a>
      </p>
    </article>
  </main>
</Layout>
