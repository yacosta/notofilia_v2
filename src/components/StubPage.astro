---
import Layout from '../layouts/Layout.astro';
import { copy, localizePath, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  pathname: string;
  title: string;
}

const { locale, pathname, title } = Astro.props;
const t = copy[locale];
---

<Layout title={`${title} · Notofilia`} description={t.comingSoon} locale={locale} pathname={pathname}>
  <main id="main-content" tabindex="-1" class="mx-auto max-w-[720px] px-[var(--page-gutter)] py-24 outline-none">
    <p class="mb-3 mt-0 font-sans text-[13px] text-ink-600">
      <a href={localizePath('/', locale)} class="text-brand-800 hover:text-brand-600">{locale === 'en' ? 'Home' : 'Inicio'}</a>
      <span aria-hidden="true"> / </span>
      <span>{title}</span>
    </p>
    <h1 class="mt-0 mb-4 font-display text-[32px] leading-10 text-brand-900">{title}</h1>
    <p class="m-0 font-serif text-[17px] leading-7 text-ink-600">{t.comingSoon}</p>
    <p class="mt-8">
      <a
        href={localizePath('/', locale)}
        class="inline-flex min-h-11 items-center font-sans text-[15px] font-semibold text-brand-800 hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
      >
        {t.backHome}
      </a>
    </p>
  </main>
</Layout>
