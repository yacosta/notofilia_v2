---
import Layout from '../layouts/Layout.astro';
import { copy, localizePath, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
  pathname: string;
  title: string;
}

const { locale, pathname, title } = Astro.props;
const t = copy[locale];
---

<Layout title={`${title} · Notofilia`} description={t.comingSoon} locale={locale} pathname={pathname}>
  <main id="main-content" tabindex="-1" class="mx-auto max-w-[720px] px-[var(--page-gutter)] py-24 outline-none">
    <h1 class="mt-0 mb-4 font-display text-[2rem]/10 font-normal text-cream-dim">{title}</h1>
    <p class="m-0 text-[17px]/7 text-muted">{t.comingSoon}</p>
    <p class="mt-8">
      <a
        href={localizePath('/', locale)}
        class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
      >
        {t.backHome}
      </a>
    </p>
  </main>
</Layout>
