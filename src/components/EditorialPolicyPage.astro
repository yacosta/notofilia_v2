---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from './Breadcrumb.astro';
import { copy, localizePath, SITE_URL, type Locale } from '../lib/site';
import { ORG_ID, WEBSITE_ID, breadcrumbJsonLd } from '../lib/seo';
import { editorialPath, editorialPolicyCopy } from '../data/editorial-policy';
import { glossaryTermHref } from '../data/glossary';
import { CONTACT_PATH } from '../data/contact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = editorialPolicyCopy[locale];
const pathname = editorialPath(locale);
const crumbs = [
  { href: localizePath('/', locale), label: t.home },
  { label: t.nav },
];
const pageUrl = new URL(pathname, SITE_URL).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: t.title,
      description: t.metaDescription,
      inLanguage: locale,
      dateModified: '2026-10-01',
      isPartOf: { '@id': WEBSITE_ID },
      about: { '@id': ORG_ID },
    },
    breadcrumbJsonLd([
      { name: t.home, item: localizePath('/', locale) },
      { name: t.nav, item: pathname },
    ]),
  ],
};
---

<Layout title={t.metaTitle} description={t.metaDescription} locale={locale} pathname={pathname}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main id="main-content" tabindex="-1" class="bg-bg outline-none">
    <article class="mx-auto max-w-content px-[var(--page-gutter)] py-16 md:py-24">
      <Breadcrumb locale={locale} items={crumbs} />
      <p class="m-0 font-sans text-[14px] font-semibold uppercase tracking-[0.2em] text-gold-light">{t.kicker}</p>
      <h1 class="mb-4 mt-3 font-display text-[clamp(1.85rem,4vw,2.85rem)] font-normal leading-[1.15] text-cream-dim">
        {t.title}
      </h1>
      <p class="mb-12 mt-0 max-w-[46rem] text-[17px]/7 text-muted">{t.lead}</p>

      {
        t.sections.map((section) => (
          <section class="mb-12 max-w-[46rem]" aria-labelledby={section.id}>
            <h2 id={section.id} class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">
              {section.title}
            </h2>
            {section.body.map((paragraph) => (
              <p class="mb-4 mt-0 text-[17px]/7 text-cream last:mb-0">{paragraph}</p>
            ))}
          </section>
        ))
      }

      <nav class="mt-4 max-w-[46rem]" aria-label={copy[locale].definitions}>
        <ul class="m-0 list-none space-y-3 p-0 font-sans text-[16px]">
          <li>
            <a class="text-gold-light underline decoration-line-strong hover:text-cream" href={localizePath('/blog/mejores-empresas-certificacion-monedas-billetes/', locale)}>
              {t.gradingGuide}
            </a>
          </li>
          <li>
            <a class="text-gold-light underline decoration-line-strong hover:text-cream" href={localizePath('/blog/como-se-valora-un-billete-colombiano/', locale)}>
              {t.valuationGuide}
            </a>
          </li>
          <li>
            <a class="text-gold-light underline decoration-line-strong hover:text-cream" href={glossaryTermHref('pmg-pcgs', locale)}>
              {t.glossaryPmg}
            </a>
          </li>
          <li>
            <a class="text-gold-light underline decoration-line-strong hover:text-cream" href={glossaryTermHref('pick', locale)}>
              {t.glossaryPick}
            </a>
          </li>
          <li>
            <a class="text-gold-light underline decoration-line-strong hover:text-cream" href={localizePath(CONTACT_PATH, locale)}>
              {t.contact}
            </a>
          </li>
        </ul>
      </nav>
    </article>
  </main>
</Layout>
