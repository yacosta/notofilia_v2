---
import { copy, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const deeplink = 'https://www.google.com/preferences/source?q=notofilia.com';
---

<div class="mx-auto mb-1 flex w-[min(100%,17.5rem)] justify-center">
  <div google-add-preferred-source-btn class="w-full" data-theme="dark" data-lang={locale}></div>
  <noscript>
    <a
      href={deeplink}
      class="inline-flex min-h-11 items-center font-sans text-[13px] text-cream underline decoration-gold-light/50 hover:text-gold-light"
    >
      {t.preferredSource}
    </a>
  </noscript>
</div>
