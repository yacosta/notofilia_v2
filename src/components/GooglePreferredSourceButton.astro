---
import NewWindowHint from './NewWindowHint.astro';
import { copy, type Locale } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale];
const deeplink = 'https://www.google.com/preferences/source?q=notofilia.com';
---

{/*
  The official Google button is the control visitors see. publisher.js still
  loads from this footer (not the document head). The text link stays hidden
  unless that script fails, and is the no-JS path via noscript.
*/}
<div class="google-preferred-source" data-swg-root data-locale={locale}>
  <div google-add-preferred-source-btn data-theme="dark" data-lang={locale} data-swg-host></div>
  <a
    href={deeplink}
    target="_blank"
    rel="noopener noreferrer"
    class="google-preferred-source-link inline-flex min-h-11 items-center justify-center font-sans text-[13px] text-cream underline decoration-gold-light/50 hover:text-gold-light"
    data-swg-fallback
    hidden
  >
    {t.preferredSource}
    <NewWindowHint locale={locale} />
  </a>
</div>
<noscript>
  <a
    href={deeplink}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex min-h-11 items-center justify-center font-sans text-[13px] text-cream underline decoration-gold-light/50"
  >
    {t.preferredSource}
    <NewWindowHint locale={locale} />
  </a>
</noscript>

<style>
  .google-preferred-source {
    display: flex;
    width: 100%;
    margin-bottom: 0.25rem;
    flex-direction: column;
    align-items: center;
  }

  .google-preferred-source :global([google-add-preferred-source-btn]:not([hidden])) {
    display: flex !important;
    width: max-content !important;
    max-width: 100% !important;
    min-height: 60px !important;
    justify-content: center !important;
    align-items: center !important;
    margin-inline: auto !important;
  }

  .google-preferred-source :global(iframe) {
    position: relative !important;
    inset: auto !important;
    top: auto !important;
    right: auto !important;
    bottom: auto !important;
    left: auto !important;
    display: block !important;
    max-width: 100% !important;
    height: 60px !important;
    margin-inline: auto !important;
    border: 0 !important;
  }

  .google-preferred-source :global([data-lang='es'] iframe) {
    width: min(100%, 246px) !important;
  }

  .google-preferred-source :global([data-lang='en'] iframe) {
    width: min(100%, 234px) !important;
  }
</style>

<script>
  const iframeWidthByLang: Record<string, string> = {
    es: '246px',
    en: '234px',
  };

  function loadSwgPublisher(): Promise<void> {
    const existing = document.querySelector('script[data-swg-publisher]');
    if (existing) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://news.google.com/swg/js/v1/publisher.js';
      script.async = true;
      script.dataset.swgPublisher = '';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('Failed to load Subscribe with Google'));
      document.head.appendChild(script);
    });
  }

  function lockPreferredSourceFrame(host: HTMLElement) {
    const apply = () => {
      host.style.setProperty('width', 'max-content', 'important');
      host.style.setProperty('max-width', '100%', 'important');
      host.style.setProperty('margin-inline', 'auto', 'important');

      const iframe = host.querySelector('iframe');
      if (!(iframe instanceof HTMLIFrameElement)) return;
      const lang = host.getAttribute('data-lang') || 'es';
      const width = iframeWidthByLang[lang] ?? iframeWidthByLang.es;
      iframe.style.setProperty('position', 'relative', 'important');
      iframe.style.setProperty('inset', 'auto', 'important');
      iframe.style.setProperty('top', 'auto', 'important');
      iframe.style.setProperty('right', 'auto', 'important');
      iframe.style.setProperty('bottom', 'auto', 'important');
      iframe.style.setProperty('left', 'auto', 'important');
      iframe.style.setProperty('display', 'block', 'important');
      iframe.style.setProperty('width', `min(100%, ${width})`, 'important');
      iframe.style.setProperty('height', '60px', 'important');
      iframe.style.setProperty('margin-inline', 'auto', 'important');
    };

    apply();
    new MutationObserver(apply).observe(host, { childList: true, subtree: true, attributes: true });
  }

  async function upgradePreferredSource(root: HTMLElement) {
    const fallback = root.querySelector('[data-swg-fallback]');
    const host = root.querySelector('[data-swg-host]');
    if (!(fallback instanceof HTMLElement) || !(host instanceof HTMLElement)) return;
    if (root.dataset.swgLoading === '1' || root.dataset.swgReady === '1') return;

    root.dataset.swgLoading = '1';
    fallback.hidden = true;
    host.hidden = false;
    try {
      await loadSwgPublisher();
      lockPreferredSourceFrame(host);
      root.dataset.swgReady = '1';
    } catch {
      host.hidden = true;
      fallback.hidden = false;
    } finally {
      delete root.dataset.swgLoading;
    }
  }

  document.querySelectorAll<HTMLElement>('[data-swg-root]').forEach((root) => {
    void upgradePreferredSource(root);
  });
</script>
