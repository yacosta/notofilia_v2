---
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, type Locale } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  pathname?: string;
}

const {
  title,
  description = 'Notofilia',
  locale = 'es',
  pathname = locale === 'en' ? '/en/' : '/',
} = Astro.props;

const canonical = new URL(pathname, SITE_URL).href;
const esUrl = new URL(pathname.replace(/^\/en(?=\/|$)/, '') || '/', SITE_URL).href;
const enUrl = pathname.startsWith('/en')
  ? canonical
  : new URL(pathname === '/' ? '/en/' : `/en${pathname}`, SITE_URL).href;
---

<!doctype html>
<html lang={locale} class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3-Variable-Latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/MontenegrinGothicOne-Regular.woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="m-0 min-h-full bg-bg font-serif text-cream">
    <SkipLink locale={locale} />
    <Header locale={locale} pathname={pathname} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
