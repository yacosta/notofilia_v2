---
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import SiteNotice from '../components/SiteNotice.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_OG_IMAGE, SITE_AUTHOR, otherLocalePath, type Locale } from '../lib/site';
import { SITE_URL } from '../lib/site-url';
import { absoluteUrl, SITE_NAME, websiteJsonLd } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  pathname?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  publishedTime?: string | null;
}

const {
  title,
  description = 'Notofilia',
  locale = 'es',
  pathname = locale === 'en' ? '/en/' : '/',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const canonical = new URL(pathname, SITE_URL).href;
const esPath = locale === 'es' ? pathname : otherLocalePath(pathname, locale);
const enPath = locale === 'en' ? pathname : otherLocalePath(pathname, locale);
const esUrl = new URL(esPath, SITE_URL).href;
const enUrl = new URL(enPath, SITE_URL).href;
const ogImageAbs = absoluteUrl(ogImage);
const siteJsonLd = websiteJsonLd(locale);
---

<!doctype html>
<html lang={locale} data-page-locale={locale} class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/MontenegrinGothicOne-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3-Variable-Latin.woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'es' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    {ogImageAlt ? <meta property="og:image:alt" content={ogImageAlt} /> : null}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    {publishedTime ? <meta property="article:published_time" content={publishedTime} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    {ogImageAlt ? <meta name="twitter:image:alt" content={ogImageAlt} /> : null}
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
    <script async is:inline src="https://news.google.com/swg/js/v1/publisher.js"></script>
    <slot name="head" />
  </head>
  <body class="m-0 min-h-full bg-bg font-serif text-[17px]/7 text-cream">
    <SkipLink locale={locale} />
    <div class="sticky top-0 z-[60]">
      <SiteNotice locale={locale} />
      <Header locale={locale} pathname={pathname} />
    </div>
    <slot />
    <Footer locale={locale} />
  </body>
</html>
