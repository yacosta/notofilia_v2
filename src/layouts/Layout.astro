---
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, otherLocalePath, type Locale } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  pathname?: string;
}

const {
  title,
  description = 'Notofilia',
  locale = 'es',
  pathname = locale === 'en' ? '/en/' : '/',
} = Astro.props;

const canonical = new URL(pathname, SITE_URL).href;
const esPath = locale === 'es' ? pathname : otherLocalePath(pathname, locale);
const enPath = locale === 'en' ? pathname : otherLocalePath(pathname, locale);
const esUrl = new URL(esPath, SITE_URL).href;
const enUrl = new URL(enPath, SITE_URL).href;
---

<!doctype html>
<html lang={locale} class="h-full antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="max-image-preview:large" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/MontenegrinGothicOne-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/SourceSans3-Variable-Latin.woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'es'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'es' : 'en_US'} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="m-0 min-h-full bg-bg font-serif text-[17px]/7 text-cream">
    <SkipLink locale={locale} />
    <Header locale={locale} pathname={pathname} />
    <slot />
    <Footer locale={locale} />
  </body>
</html>
