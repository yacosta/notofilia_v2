---
import GlossaryTermPage from '../../../components/glossary/GlossaryTermPage.astro';
import { standaloneGlossaryTerms } from '../../../data/glossary';

export function getStaticPaths() {
  return standaloneGlossaryTerms().map((term) => ({
    params: { term: term.slugEn },
    props: { term },
  }));
}

const { term } = Astro.props;
---

<GlossaryTermPage locale="en" term={term} />
