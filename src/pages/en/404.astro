---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Page not found · Notofilia" description="That address is not in the catalog." locale="en" pathname="/en/404">
  <main id="main-content" tabindex="-1" class="mx-auto flex min-h-[60vh] max-w-[720px] flex-col justify-center px-[var(--page-gutter)] py-24 outline-none">
    <h1 class="mt-0 mb-4 font-display text-[2rem]/10 font-normal text-cream-dim">Page not found</h1>
    <p class="m-0 text-[17px]/7 text-muted">That address is not in the catalog.</p>
    <p class="mt-8">
      <a
        href="/en/"
        class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
      >
        Back to the homepage
      </a>
    </p>
  </main>
</Layout>
