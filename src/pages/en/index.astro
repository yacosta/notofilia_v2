---
import Layout from '../../layouts/Layout.astro';
import HomePage from '../../components/HomePage.astro';
import { heroSizes, heroSrc, heroSrcset } from '../../lib/hero';
import { copy } from '../../lib/site';

const t = copy.en;
---

<Layout title={t.metaTitle} description={t.metaDescription} locale="en" pathname="/en/" ogImage="/images/hero-slide.jpg">
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroSrc}
    imagesrcset={heroSrcset}
    imagesizes={heroSizes}
    fetchpriority="high"
  />
  <HomePage locale="en" />
</Layout>
