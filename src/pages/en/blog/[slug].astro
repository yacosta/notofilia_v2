---
import EditorialArticlePage from '../../../components/editorial/EditorialArticlePage.astro';
import { articleSlugParam, blogArticles } from '../../../data/editorial';

export function getStaticPaths() {
  return blogArticles.map((article) => ({
    params: { slug: articleSlugParam('blog', article.slug, 'en') },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<EditorialArticlePage locale="en" kind="blog" article={article} />
