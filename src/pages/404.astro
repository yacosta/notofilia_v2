---
import Layout from '../layouts/Layout.astro';
import { copy } from '../lib/site';

const t = copy.es;
---

<Layout title={`${t.notFoundTitle} · Notofilia`} description={t.notFoundBody} locale="es" pathname="/404">
  <main id="main-content" tabindex="-1" class="mx-auto flex min-h-[60vh] max-w-[720px] flex-col justify-center px-[var(--page-gutter)] py-24 outline-none">
    <h1 class="mt-0 mb-4 font-display text-[32px] leading-10 text-brand-900">{t.notFoundTitle}</h1>
    <p class="m-0 font-serif text-[17px] leading-7 text-ink-600">{t.notFoundBody}</p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-flex min-h-11 items-center font-sans text-[15px] font-semibold text-brand-800 hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[3px] focus-visible:outline-brand-600"
      >
        {t.backHome}
      </a>
    </p>
  </main>
</Layout>
