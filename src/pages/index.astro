---
import Layout from '../layouts/Layout.astro';
import NewWindowHint from '../components/NewWindowHint.astro';
import { articles, collections, copy, localizePath, milestones, news, statsLine } from '../lib/site';

const t = copy.es;
const stats = statsLine('es');
const heroAlt =
  'Primer plano de un billete de 5 quetzales de Guatemala, con el ave quetzal, estilo numismática y notafilia';
---

<Layout title={t.metaTitle} description={t.metaDescription} locale="es" pathname="/">
  <main id="main-content" tabindex="-1" class="relative w-full bg-bg outline-none">
    <section class="relative min-h-[72vh] w-full bg-[#0a0a09]" aria-labelledby="hero-heading">
      <img
        class="absolute inset-0 h-full w-full object-cover object-[50%_40%] [filter:contrast(1.2)_brightness(0.85)_saturate(1.1)]"
        src="/images/hero-slide.jpg"
        alt={heroAlt}
        width="768"
        height="284"
        fetchpriority="high"
        decoding="async"
      />
      <div
        class="absolute inset-0"
        style="background:radial-gradient(ellipse 90% 75% at 50% 42%, rgba(10,10,9,0.35) 0%, rgba(10,10,9,0.72) 60%, rgba(6,6,5,0.94) 100%);"
      >
      </div>
      <div
        class="absolute inset-0"
        style="background:linear-gradient(180deg, rgba(6,6,5,0.55) 0%, rgba(6,6,5,0.15) 22%, rgba(6,6,5,0.15) 78%, rgba(6,6,5,0.6) 100%);"
      >
      </div>

      <div class="relative z-[1] mx-auto flex min-h-[72vh] max-w-content flex-col items-center justify-center px-[var(--page-gutter)] py-16 text-center">
        <div class="mb-7 flex items-center gap-4">
          <span class="h-px w-14 bg-[#e7dec98c]"></span>
          <span class="font-sans text-[17px] font-medium italic uppercase tracking-[0.28em] text-[#d8d2cd]">Notofilia.com</span>
          <span class="h-px w-14 bg-[#e7dec98c]"></span>
        </div>
        <p class="m-0 font-display text-[clamp(48px,9vw,120px)] font-normal leading-[0.95] tracking-[0.04em] text-[#d8d2cd] [text-shadow:0_2px_24px_rgba(0,0,0,0.55)]">
          NOTOFILIA
        </p>
        <div class="my-6 flex items-center gap-[14px]">
          <span class="h-px w-[34px] bg-[#e7dec9cc]"></span>
          <span class="h-[7px] w-[7px] rotate-45 bg-[#d8d2cd]"></span>
          <span class="h-px w-[34px] bg-[#e7dec9cc]"></span>
        </div>
        <h1 id="hero-heading" class="m-0 max-w-[40rem] font-display text-[clamp(1.5rem,2.6vw,2.75rem)] font-normal leading-[1.3] text-[#e7ddc4]">
          Una colección privada de billetes y monedas históricas
        </h1>
        <p class="mb-0 mt-4 max-w-[42rem] font-sans text-[17px]/7 text-[#d8d2cd]">
          Imágenes detalladas, referencias de catálogo e historias monetarias de Colombia, Estados Unidos, Puerto Rico y el mundo.
        </p>
        <p class="mb-0 mt-4 font-sans text-[14px]/5 tracking-[0.06em] text-[#cbbf9d]">
          {stats}
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/coleccion/colombia/"
            class="inline-flex min-h-12 items-center justify-center rounded-[2px] bg-[#e7ddc4] px-7 py-3 font-sans text-[15px] font-semibold uppercase tracking-[0.1em] text-[#0a0a09] no-underline hover:bg-[#d8d2cd]"
          >
            Ver la colección de Colombia
          </a>
          <a
            href="/coleccion/colombia/"
            class="inline-flex min-h-12 items-center justify-center rounded-[2px] border border-[#e7ddc4] px-7 py-3 font-sans text-[15px] font-semibold uppercase tracking-[0.1em] text-[#e7ddc4] no-underline hover:bg-[#e7ddc41a]"
          >
            Explorar la colección
          </a>
        </div>
      </div>
    </section>

    <section class="border-b border-line bg-panel" aria-label="Estadísticas de la colección">
      <div class="mx-auto max-w-content px-[var(--page-gutter)] py-8 text-center">
        <p class="m-0 font-sans text-[14px]/5 text-gold-light">{stats}</p>
      </div>
    </section>

    <section class="px-[var(--page-gutter)] py-[72px]" aria-labelledby="browse-heading">
      <div class="mx-auto max-w-content">
        <h2 id="browse-heading" class="mb-3 mt-0 text-center font-display text-[2rem]/10 font-normal text-cream-dim">
          Explorar Colección Virtual
        </h2>
        <p class="mx-auto mb-8 mt-0 max-w-[40rem] text-center text-[17px]/7 text-muted">Entre por un país, un material o un tema especializado.</p>
        <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
          {
            collections.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group block h-full min-h-11 rounded-[6px] border border-line-strong bg-panel p-5 text-inherit no-underline hover:border-gold-light"
                >
                  <span class="mb-2 block font-display text-[1.5rem]/8 text-cream-dim group-hover:text-cream">
                    {item.es.title}
                  </span>
                  <span class="block font-sans text-[15px]/6 text-muted">{item.es.description}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bg-panel px-[var(--page-gutter)] py-[72px]" aria-labelledby="milestones-heading">
      <div class="mx-auto max-w-content">
        <h2 id="milestones-heading" class="mb-3 mt-0 text-center font-display text-[2rem]/10 font-normal text-cream-dim">
          Logros del Mes — Colección Virtual
        </h2>
        <p class="mx-auto mb-8 mt-0 max-w-[40rem] text-center text-[17px]/7 text-muted">Piezas y catálogos recientes incorporados a la Colección Virtual.</p>
        <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {
            milestones.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="group block h-full min-h-11 rounded-[6px] border border-line-strong bg-bg p-5 text-inherit no-underline hover:border-gold-light"
                >
                  <h3 class="mb-2 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim group-hover:text-cream">
                    {item.es.title}
                  </h3>
                  <p class="mb-3 mt-0 font-sans text-[15px]/6 text-muted">{item.es.description}</p>
                  <span class="font-sans text-[15px] text-gold-light">Ver en el catálogo →</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="mt-10 text-center">
          <a
            href="/coleccion/colombia/"
            class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
          >
            Explorar la colección
          </a>
        </p>
      </div>
    </section>

    <section class="px-[var(--page-gutter)] py-[72px]" aria-labelledby="articles-heading">
      <div class="mx-auto max-w-content">
        <h2 id="articles-heading" class="mb-8 mt-0 text-center font-display text-[2rem]/10 font-normal text-cream-dim">
          Artículos originales
        </h2>
        <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2">
          {
            articles.map((item) => (
              <li>
                <article class="h-full rounded-[6px] border border-line-strong bg-panel p-5">
                  <p class="m-0 font-sans text-[14px]/5 tracking-[0.08em] text-muted">
                    {item.dateEs} · Notofilia
                  </p>
                  <h3 class="mb-3 mt-2 font-display text-[1.5rem]/8 font-normal text-cream-dim">
                    {item.es}
                  </h3>
                  <a
                    href={item.href}
                    class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
                  >
                    Leer más →
                  </a>
                </article>
              </li>
            ))
          }
        </ul>
        <p class="mt-10 text-center">
          <a
            href="/blog/"
            class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
          >
            Ver todo el blog
          </a>
        </p>
      </div>
    </section>

    <section class="bg-panel px-[var(--page-gutter)] py-[72px]" aria-labelledby="news-heading">
      <div class="mx-auto max-w-content">
        <h2 id="news-heading" class="mb-8 mt-0 text-center font-display text-[2rem]/10 font-normal text-cream-dim">
          Noticias seleccionadas
        </h2>
        <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2">
          {
            news.map((item) => (
              <li>
                <article class="h-full rounded-[6px] border border-line-strong bg-bg p-5">
                  <p class="m-0 font-sans text-[14px]/5 tracking-[0.08em] text-muted">
                    {item.dateEs}
                  </p>
                  <p class="mb-0 mt-2 font-sans text-[14px]/5 text-muted">
                    Fuente:{' '}
                    <a
                      href={item.sourceUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-gold-light underline decoration-line-strong hover:text-cream"
                    >
                      {item.source}
                      <NewWindowHint locale="es" />
                    </a>
                  </p>
                  <h3 class="mb-3 mt-2 font-display text-[1.5rem]/8 font-normal text-cream-dim">
                    {item.es}
                  </h3>
                  <a
                    href={item.href}
                    class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
                  >
                    Leer más →
                  </a>
                </article>
              </li>
            ))
          }
        </ul>
        <p class="mt-10 text-center">
          <a
            href="/noticias/"
            class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
          >
            Ver todas las noticias
          </a>
        </p>
      </div>
    </section>

    <section class="px-[var(--page-gutter)] py-[72px]" aria-labelledby="definitions-heading">
      <div class="mx-auto grid max-w-content gap-10 lg:grid-cols-2">
        <h2 id="definitions-heading" class="sr-only">Definiciones</h2>
        <div>
          <h3 class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">Numismática</h3>
          <p class="m-0 text-[17px]/7 text-cream">Disciplina dedicada al estudio y la colección de monedas, medallas y, en su sentido más amplio, de todo objeto utilizado como medio de pago a lo largo de la historia. Abarca el análisis histórico, artístico y técnico de las piezas acuñadas.</p>
        </div>
        <div>
          <h3 class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">Notafilia</h3>
          <p class="m-0 text-[17px]/7 text-cream">Rama especializada de la numismática centrada específicamente en el estudio y la colección de billetes y papel moneda, incluyendo su historia, diseño, grabado y las emisiones de entidades tanto públicas como privadas.</p>
        </div>
        <div class="rounded-[6px] border border-line-strong bg-panel p-8 lg:col-span-2">
          <h3 class="mb-3 mt-0 font-display text-[1.5rem]/8 font-normal text-cream-dim">Boletín</h3>
          <p class="mb-6 mt-0 text-[17px]/7 text-muted">Suscríbase para recibir noticias de numismática y notafilia.</p>
          <form class="flex flex-col gap-3 sm:flex-row sm:items-end" action="/contacto/" method="get">
            <div class="min-w-0 flex-1">
              <label class="mb-2 block font-sans text-[13px] font-medium tracking-[0.08em] text-muted" for="newsletter-email">
                Correo electrónico
              </label>
              <input
                id="newsletter-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                placeholder="su@correo.com"
                class="box-border w-full min-h-12 rounded-[6px] border border-line-input bg-bg px-4 font-sans text-[16px] text-cream placeholder:text-muted"
              />
            </div>
            <button
              type="submit"
              class="min-h-12 cursor-pointer rounded-[2px] border-0 bg-cream px-7 font-sans text-[15px] font-semibold uppercase tracking-[0.1em] text-bg hover:bg-cream-dim"
            >
              Suscríbase
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>
</Layout>
