---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Notofilia">
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center gap-6 px-6 text-center">
    <h1 class="text-5xl font-bold tracking-tight">Notofilia</h1>
    <p class="text-lg text-slate-600 dark:text-slate-400">
      Astro + Tailwind CSS v4, deployed on Cloudflare Workers.
    </p>
    <a
      href="https://docs.astro.build"
      class="rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
    >
      Read the Astro docs
    </a>
  </main>
</Layout>
