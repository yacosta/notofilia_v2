---
import Layout from '../layouts/Layout.astro';
import {
  articles,
  collections,
  milestones,
  news,
  stubPages,
} from '../lib/site';

export function getStaticPaths() {
  const titles = new Map<string, { es: string; en: string }>();

  for (const page of stubPages) {
    titles.set(page.path, { es: page.es, en: page.en });
  }
  for (const item of collections) {
    titles.set(item.href.replace(/^\/|\/$/g, ''), { es: item.es.title, en: item.en.title });
  }
  for (const item of milestones) {
    titles.set(item.href.replace(/^\/|\/$/g, ''), { es: item.es.title, en: item.en.title });
  }
  for (const item of articles) {
    titles.set(item.href.replace(/^\/|\/$/g, ''), { es: item.es, en: item.en });
  }
  for (const item of news) {
    titles.set(item.href.replace(/^\/|\/$/g, ''), { es: item.es, en: item.en });
  }

  return [...titles.entries()].map(([slug, title]) => ({
    params: { slug },
    props: { title },
  }));
}

const { slug } = Astro.params;
const { title } = Astro.props as { title: { es: string; en: string } };
const pathname = `/${slug}/`;
---

<Layout title={`${title.es} · Notofilia`} description="Esta sección se está migrando a Notofilia v2." locale="es" pathname={pathname}>
  <main id="main-content" tabindex="-1" class="mx-auto max-w-[720px] px-[var(--page-gutter)] py-24 outline-none">
    <h1 class="mt-0 mb-4 font-display text-[2rem]/10 font-normal text-cream-dim">{title.es}</h1>
    <p class="m-0 text-[17px]/7 text-muted">Esta sección se está migrando a Notofilia v2.</p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-flex min-h-11 items-center font-sans text-[15px] text-gold-light hover:text-cream"
      >
        Volver al inicio
      </a>
    </p>
  </main>
</Layout>
